  function $(id) { return document.getElementById(id); }
  function emptyAnalysis() {
    return {
      allTime: { attempted: 0, correct: 0, wrong: 0, accuracy: 0 },
      today: { date: "", attempted: 0, correct: 0, wrong: 0, accuracy: 0 },
      subjects: {}, topics: {}, exams: {}, pyqYears: {}
    };
  }
  function todayStr() {
    var d = new Date();
    return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
  }
  function calcAcc(c, a) { return a ? Math.round((c / a) * 1000) / 10 : 0; }
  function safeKey(v) { return String(v || "").replace(/[.#$\[\]\/]/g, "_"); }
  function domId(v) {
    return String(v || "").replace(/[^a-zA-Z0-9_-]/g, "_");
  }
  function escapeHTML(s) {
    return String(s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }
  function shuffle(arr) {
    var a = arr.slice();
    for (var i = a.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = a[i]; a[i] = a[j]; a[j] = t;
    }
    return a;
  }

  function sendWebViewString(v) {
    try { if (window.AppInventor && window.AppInventor.setWebViewString) window.AppInventor.setWebViewString(v); } catch (e) {}
    try { if (window.Kodular && window.Kodular.setWebViewString) window.Kodular.setWebViewString(v); } catch (e) {}
  }
  function getWebViewString() {
    try {
      if (window.AppInventor && window.AppInventor.getWebViewString)
        return String(window.AppInventor.getWebViewString() || "").trim();
    } catch (e) {}
    try {
      if (window.Kodular && window.Kodular.getWebViewString)
        return String(window.Kodular.getWebViewString() || "").trim();
    } catch (e) {}
    return "";
  }

  async function firebaseGet(path) {
    var r = await fetch(FIREBASE_DB + "/" + path + ".json?t=" + Date.now());
    if (!r.ok) throw new Error("Firebase GET " + r.status);
    return await r.json();
  }
  async function firebasePatch(values) {
    var r = await fetch(FIREBASE_DB + "/.json", {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(values)
    });
    if (!r.ok) throw new Error("Firebase PATCH " + r.status);
  }

  function getQid(item) {
    return String((item && (item.qid || item.questionId || item.QUESTION_ID || item.uid || item.id)) || "").trim();
  }
  function getChannelId(item) {
    return String((item && (item.channelId || item.CHANNEL_ID || item.ownerId || item.userId)) || "").trim();
  }
  function getSubject(item) {
    return String((item && (item.subject || item.SUBJECT || "General")) || "General").trim() || "General";
  }
  function getTopic(item) {
    return String((item && (item.topic || item.topics || item.TOPICS || item.chapter || "")) || "").trim();
  }
  function getExam(item) {
    return String((item && (item.exam || item.examName || item.EXAM_NAME || "")) || "").trim();
  }
  function getYear(item) {
    return String((item && (item.year || item.pyqYear || item.PREVIOUS_YEAR_QUESTION_YEAR || "")) || "").trim();
  }
  function normalizeMcq(raw) {
    if (!raw || typeof raw !== "object") return null;
    var opts = raw.options;
    if (!opts || !opts.length) {
      opts = [
        raw.optionA || raw.OPTIONA || raw.OptionA || "",
        raw.optionB || raw.OPTIONB || raw.OptionB || "",
        raw.optionC || raw.OPTIONC || raw.OptionC || "",
        raw.optionD || raw.OPTIOND || raw.OptionD || ""
      ];
    }
    var correct = raw.correct != null ? raw.correct : (raw.CORRECTANSWER || raw.correctAnswer || raw.answer);
    var map = { A: 0, B: 1, C: 2, D: 3, a: 0, b: 1, c: 2, d: 3 };
    if (typeof correct === "string" && map[correct.trim()] !== undefined) correct = map[correct.trim()];
    else if (typeof correct === "string" && /^\d+$/.test(correct)) correct = parseInt(correct, 10);
    if (typeof correct === "number" && correct >= 1 && correct <= 4 && !raw.options) {
      /* sometimes 1-4 instead of 0-3 */
      if (correct >= 1 && correct <= 4 && (!opts[correct] || correct > 3)) {
        /* keep as 0-based if already 0-3 */
      }
    }
    return {
      q: raw.q || raw.question || raw.Question || raw.QUESTION || "",
      options: opts,
      correct: correct,
      username: raw.username || raw.channelName || raw.CHANNEL_NAME || "Educator",
      subject: raw.subject || raw.SUBJECT || "General",
      topic: raw.topic || raw.topics || raw.TOPICS || raw.chapter || "",
      difficulty: raw.difficulty || raw.level || raw.LEVEL || "Medium",
      exam: raw.exam || raw.examName || raw.EXAM_NAME || "",
      year: raw.year || raw.pyqYear || raw.PREVIOUS_YEAR_QUESTION_YEAR || "",
      shift: raw.shift || raw.SHIFT || "",
      section: raw.section || raw.SECTION || "",
      source: raw.source || raw.SOURCE || "",
      language: raw.language || raw.LANGUAGE || "",
      qid: getQid(raw),
      channelId: getChannelId(raw)
    };
  }

  /* ===== Ads random each load ===== */
  function renderAds() {
    var track = $("addsTrack");
    if (!track) return;
    track.innerHTML = "";
