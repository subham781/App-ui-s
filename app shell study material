<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#4f46e5">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>Study Hub</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{
  font-family:Inter,system-ui,-apple-system,sans-serif;
  background:#eef2ff;
  color:#0f172a;
  overscroll-behavior:none;
}
.wrap{max-width:720px;margin:0 auto;padding:0 14px 100px;min-height:100%}

/* Hero */
.hero{
  background:linear-gradient(145deg,#4f46e5 0%,#2563eb 50%,#0ea5e9 100%);
  color:#fff;
  border-radius:0 0 32px 32px;
  padding:28px 20px 32px;
  margin:0 -14px 18px;
  box-shadow:0 16px 48px rgba(37,99,235,.28);
  position:relative;
  overflow:hidden;
}
.hero::after{
  content:"";position:absolute;right:-40px;top:-40px;
  width:160px;height:160px;border-radius:50%;
  background:rgba(255,255,255,.08);
}
.hero-badge{
  display:inline-flex;align-items:center;gap:6px;
  background:rgba(255,255,255,.2);
  border:1px solid rgba(255,255,255,.28);
  border-radius:999px;padding:6px 12px;
  font-size:.72rem;font-weight:700;margin-bottom:12px;
  letter-spacing:.02em;
}
.hero h1{font-size:1.55rem;font-weight:800;letter-spacing:-.03em;line-height:1.2}
.hero p{font-size:.84rem;opacity:.92;margin-top:8px;line-height:1.5;max-width:90%}

/* Search */
.search-wrap{position:relative;margin:-22px 0 16px;z-index:2}
.search{
  width:100%;border:0;border-radius:18px;
  padding:15px 16px 15px 48px;
  font-size:.92rem;font-family:inherit;font-weight:500;
  background:#fff;
  box-shadow:0 10px 36px rgba(15,23,42,.1);
  outline:none;
}
.search:focus{box-shadow:0 10px 36px rgba(79,70,229,.2);border:1px solid #c7d2fe}
.search-icon{
  position:absolute;left:18px;top:50%;transform:translateY(-50%);
  color:#94a3b8;font-size:1.05rem;pointer-events:none;
}

/* Stats bar */
.stats{
  display:flex;gap:10px;margin-bottom:16px;overflow:auto;
  padding-bottom:2px;
}
.stat{
  flex:1;min-width:90px;
  background:#fff;border-radius:14px;padding:12px 10px;
  text-align:center;
  box-shadow:0 2px 12px rgba(15,23,42,.05);
  border:1px solid #e2e8f0;
}
.stat b{display:block;font-size:1.15rem;font-weight:800;color:#4f46e5}
.stat span{font-size:.68rem;color:#64748b;font-weight:600;text-transform:uppercase;letter-spacing:.04em}

/* List */
.section-label{
  font-size:.7rem;font-weight:700;color:#64748b;
  text-transform:uppercase;letter-spacing:.07em;
  margin:14px 6px 8px;
}
.grid{display:flex;flex-direction:column;gap:10px}
.card{
  background:#fff;border-radius:18px;padding:14px;
  display:flex;gap:13px;align-items:center;
  box-shadow:0 3px 16px rgba(15,23,42,.05);
  border:1px solid #e8eef8;
  transition:transform .12s, box-shadow .12s;
  cursor:pointer;
  -webkit-user-select:none;user-select:none;
}
.card:active{transform:scale(.98)}
.icon{
  width:50px;height:50px;border-radius:15px;
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;font-size:.7rem;font-weight:800;
  background:linear-gradient(145deg,#d1fae5,#6ee7b7);
  color:#047857;
  letter-spacing:-.02em;
}
.meta{flex:1;min-width:0}
.meta b{
  display:block;font-size:.93rem;font-weight:700;
  line-height:1.3;margin-bottom:3px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.meta span{font-size:.72rem;color:#64748b;font-weight:500}
.arrow{
  width:32px;height:32px;border-radius:10px;
  background:#f1f5f9;color:#64748b;
  display:flex;align-items:center;justify-content:center;
  font-size:1rem;flex-shrink:0;
}

/* States */
.loading,.empty{
  text-align:center;padding:56px 16px;color:#64748b;font-size:.9rem;
}
.spin{
  width:36px;height:36px;margin:0 auto 14px;
  border:3px solid #e0e7ff;border-top-color:#4f46e5;
  border-radius:50%;animation:spin .65s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg)}}
.err{
  background:#fef2f2;color:#b91c1c;border-radius:14px;
  padding:12px 14px;font-size:.84rem;margin-bottom:12px;
  display:none;border:1px solid #fecaca;line-height:1.45;
}
.err.show{display:block}

/* Viewer - full screen app feel */
.viewer{
  display:none;position:fixed;inset:0;
  background:#0f172a;z-index:100;flex-direction:column;
}
.viewer.show{display:flex}
.v-bar{
  display:flex;align-items:center;gap:10px;
  padding:10px 12px;
  padding-top:max(10px, env(safe-area-inset-top));
  background:#0f172a;
  border-bottom:1px solid rgba(255,255,255,.08);
  color:#fff;flex-shrink:0;
}
.v-bar button{
  border:0;background:rgba(255,255,255,.12);
  color:#fff;border-radius:11px;padding:9px 14px;
  font-weight:600;font-size:.85rem;cursor:pointer;
  font-family:inherit;
}
.v-bar button:active{background:rgba(255,255,255,.2)}
.v-title{
  flex:1;font-size:.86rem;font-weight:600;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  opacity:.95;
}
.v-frame-wrap{flex:1;position:relative;background:#fff}
.v-frame{position:absolute;inset:0;width:100%;height:100%;border:0;background:#fff}
.v-loading{
  position:absolute;inset:0;
  display:none;align-items:center;justify-content:center;
  flex-direction:column;gap:12px;
  background:#fff;color:#64748b;font-size:.9rem;z-index:3;
}
.v-loading.show{display:flex}
.v-error{
  position:absolute;inset:0;
  display:none;align-items:center;justify-content:center;
  flex-direction:column;gap:12px;padding:24px;
  background:#fff;color:#0f172a;text-align:center;z-index:4;
}
.v-error.show{display:flex}
.v-error h3{font-size:1.05rem;margin-bottom:4px}
.v-error p{font-size:.85rem;color:#64748b;line-height:1.5;max-width:300px}
.v-error a{
  display:inline-block;margin-top:8px;
  background:#4f46e5;color:#fff;text-decoration:none;
  padding:10px 18px;border-radius:12px;font-weight:700;font-size:.85rem;
}

/* Tip */
.tip{
  background:#fffbeb;border:1px solid #fde68a;border-radius:14px;
  padding:12px 14px;font-size:.8rem;color:#92400e;margin-bottom:14px;line-height:1.45;
}
</style>
</head>
<body>
<div class="wrap">
  <div class="hero">
    <div class="hero-badge">📚 PrepExam Notes</div>
    <h1>Study Materials</h1>
    <p>All lessons in one place. Search &amp; open instantly — works offline after first load.</p>
  </div>

  <div class="search-wrap">
    <span class="search-icon">⌕</span>
    <input class="search" id="search" type="search" placeholder="Search any topic..." autocomplete="off">
  </div>

  <div class="stats" id="stats" style="display:none">
    <div class="stat"><b id="statCount">0</b><span>Topics</span></div>
    <div class="stat"><b id="statReady">✓</b><span>Ready</span></div>
  </div>

  <div class="err" id="err"></div>
  <div class="tip" id="tip" style="display:none">
    <strong>Tip:</strong> Agar HTML open nahi ho raha to Drive me file pe right-click → Share → “Anyone with the link” (Viewer) kar do.
  </div>

  <div class="section-label" id="sectionLabel">All lessons</div>
  <div class="grid" id="list"></div>
  <div class="loading" id="loading">
    <div class="spin"></div>
    Loading your notes...
  </div>
</div>

<div class="viewer" id="viewer">
  <div class="v-bar">
    <button type="button" id="btnClose">← Back</button>
    <span class="v-title" id="vTitle">Lesson</span>
  </div>
  <div class="v-frame-wrap">
    <div class="v-loading" id="vLoading">
      <div class="spin"></div>
      Opening lesson...
    </div>
    <div class="v-error" id="vError">
      <h3>Couldn’t open</h3>
      <p id="vErrorMsg">File share setting check karo.</p>
      <a id="vOpenDrive" href="#" target="_blank" rel="noopener">Open in Drive</a>
    </div>
    <iframe class="v-frame" id="frame" sandbox="allow-scripts allow-same-origin allow-forms allow-modals allow-popups"></iframe>
  </div>
</div>

<script>
(function () {
  var FOLDER_ID = "1xgsVBJ0FbLOcrH9NEyHxPKaU13NJHXbk";
  var API_KEY = "AIzaSyDtdFn-GBAZE6iKoFGvAe86nFSKJ7NJA_c";

  var allFiles = [];
  var filtered = [];

  function $(id) { return document.getElementById(id); }

  function showErr(msg) {
    var e = $("err");
    e.textContent = msg;
    e.classList.add("show");
    $("tip").style.display = "block";
  }

  function escapeHtml(s) {
    return String(s || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function formatSize(n) {
    n = Number(n) || 0;
    if (n < 1024) return n + " B";
    if (n < 1024 * 1024) return (n / 1024).toFixed(0) + " KB";
    return (n / (1024 * 1024)).toFixed(1) + " MB";
  }

  function prettyName(name) {
    return String(name || "")
      .replace(/\.html?$/i, "")
      .replace(/[-_]+/g, " ")
      .replace(/\b\w/g, function (c) { return c.toUpperCase(); });
  }

  function isHtmlFile(f) {
    var mime = String(f.mimeType || "").toLowerCase();
    var name = String(f.name || "").toLowerCase();
    if (mime.indexOf("html") !== -1) return true;
    if (/\.html?$/.test(name) || /\.htm$/.test(name)) return true;
    return false;
  }

  async function driveList(parentId) {
    var out = [], token = "";
    do {
      var q = "'" + parentId + "' in parents and trashed=false";
      var url = "https://www.googleapis.com/drive/v3/files?"
        + "q=" + encodeURIComponent(q)
        + "&fields=nextPageToken,files(id,name,mimeType,size,modifiedTime,webViewLink)"
        + "&orderBy=name_natural"
        + "&pageSize=1000"
        + "&key=" + encodeURIComponent(API_KEY);
      if (token) url += "&pageToken=" + encodeURIComponent(token);
      var res = await fetch(url);
      var data = await res.json();
      if (data.error) throw new Error(data.error.message || "Drive API error");
      out = out.concat(data.files || []);
      token = data.nextPageToken || "";
    } while (token);
    return out;
  }

  async function fetchHtml(fileId) {
    // Method 1: Drive API alt=media
    var url = "https://www.googleapis.com/drive/v3/files/" + encodeURIComponent(fileId)
      + "?alt=media&key=" + encodeURIComponent(API_KEY);
    var res = await fetch(url);
    var text = await res.text();
    if (res.ok && text.length > 50 && text.toLowerCase().indexOf("<!doctype") !== -1) {
      return text;
    }
    if (res.ok && text.length > 200 && text.indexOf("<html") !== -1) return text;

    // Method 2: uc export
    var url2 = "https://drive.google.com/uc?export=download&id=" + encodeURIComponent(fileId);
    var res2 = await fetch(url2);
    var text2 = await res2.text();
    if (res2.ok && text2.length > 100 && (text2.indexOf("<html") !== -1 || text2.indexOf("<!DOCTYPE") !== -1)) {
      return text2;
    }

    if (text.toLowerCase().indexOf("access") !== -1 || text2.toLowerCase().indexOf("access") !== -1) {
      throw new Error("File private hai. Share → Anyone with the link (Viewer) karo.");
    }
    throw new Error("HTML load nahi hua. Share setting check karo.");
  }

  function render(list) {
    var box = $("list");
    box.innerHTML = "";
    if (!list.length) {
      box.innerHTML = '<div class="empty">Koi lesson nahi mila.</div>';
      return;
    }
    list.forEach(function (f) {
      var card = document.createElement("div");
      card.className = "card";
      var date = f.modifiedTime ? new Date(f.modifiedTime).toLocaleDateString("en-IN", { day: "numeric", month: "short" }) : "";
      card.innerHTML =
        '<div class="icon">HTML</div>' +
        '<div class="meta"><b>' + escapeHtml(prettyName(f.name)) + '</b>' +
        '<span>' + formatSize(f.size) + (date ? " · " + date : "") + '</span></div>' +
        '<div class="arrow">›</div>';
      card.onclick = function () { openHtml(f); };
      box.appendChild(card);
    });
  }

  async function openHtml(f) {
    $("vTitle").textContent = prettyName(f.name);
    $("viewer").classList.add("show");
    $("vLoading").classList.add("show");
    $("vError").classList.remove("show");
    $("frame").src = "about:blank";
    $("vOpenDrive").href = f.webViewLink || ("https://drive.google.com/file/d/" + f.id + "/view");

    try {
      var html = await fetchHtml(f.id);
      // Inject base so relative assets work better
      if (html.indexOf("<base ") === -1) {
        html = html.replace(/<head([^>]*)>/i, '<head$1><base target="_blank">');
      }
      var blob = new Blob([html], { type: "text/html;charset=utf-8" });
      var url = URL.createObjectURL(blob);
      var frame = $("frame");
      frame.onload = function () {
        $("vLoading").classList.remove("show");
        try { URL.revokeObjectURL(url); } catch (e) {}
      };
      frame.src = url;
      // fallback if onload delayed
      setTimeout(function () { $("vLoading").classList.remove("show"); }, 2500);
    } catch (e) {
      $("vLoading").classList.remove("show");
      $("vErrorMsg").textContent = String(e.message || e);
      $("vError").classList.add("show");
    }
  }

  function doSearch() {
    var q = ($("search").value || "").trim().toLowerCase();
    if (!q) {
      filtered = allFiles.slice();
      $("sectionLabel").textContent = "All lessons · " + filtered.length;
    } else {
      filtered = allFiles.filter(function (f) {
        return prettyName(f.name).toLowerCase().indexOf(q) !== -1 ||
          String(f.name).toLowerCase().indexOf(q) !== -1;
      });
      $("sectionLabel").textContent = "Results · " + filtered.length;
    }
    render(filtered);
  }

  $("btnClose").onclick = function () {
    $("viewer").classList.remove("show");
    $("vLoading").classList.remove("show");
    $("vError").classList.remove("show");
    $("frame").src = "about:blank";
  };

  $("search").oninput = doSearch;

  // Init
  (async function () {
    try {
      var files = await driveList(FOLDER_ID);
      allFiles = files.filter(isHtmlFile).sort(function (a, b) {
        return prettyName(a.name).localeCompare(prettyName(b.name), undefined, { numeric: true, sensitivity: "base" });
      });
      filtered = allFiles.slice();
      $("loading").style.display = "none";
      $("stats").style.display = "flex";
      $("statCount").textContent = allFiles.length;
      $("sectionLabel").textContent = "All lessons · " + allFiles.length;
      render(filtered);
      if (!allFiles.length) {
        showErr("Is folder me koi HTML nahi mili. Files upload karo ya share setting check karo.");
      }
    } catch (e) {
      $("loading").style.display = "none";
      showErr(String(e.message || e));
    }
  })();
})();
</script>
</body>
</html>
