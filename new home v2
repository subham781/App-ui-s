  /* ===== Feed ===== */
  async function loadMeta() {
    try {
      var url = (META_API || MCQ_API) + (MCQ_API.indexOf("?") >= 0 ? "&" : "?") + "action=meta&t=" + Date.now();
      var res = await fetch(url, { cache: "no-store", redirect: "follow" });
      if (!res.ok) return;
      var data = await res.json();
      filterMeta = {
        exams: data.exams || data.examNames || [],
        subjects: data.subjects || [],
        topics: data.topics || data.topicList || [],
        years: data.years || [],
        shifts: data.shifts || [],
        sections: data.sections || []
      };
      applyMetaToFilters();
    } catch (e) { console.warn("meta fail", e); }
  }

  async function loadMixedFeed() {
    var box = $("mixedFeed");
    if (!box) { console.error("mixedFeed missing"); return; }
    box.innerHTML = '<div class="loading">Loading practice…</div>';
    renderAds();
    var filters = currentFilters();

    try {
      var tasks = [];
      if (filters.type !== "Post") {
        tasks.push(
          fetch(buildMcqUrl(filters), { cache: "no-store", redirect: "follow" })
            .then(function (r) {
              if (!r.ok) throw new Error("MCQ HTTP " + r.status);
              return r.json();
            })
        );
      } else tasks.push(Promise.resolve([]));

      if (filters.type !== "MCQ") {
        tasks.push(
          fetch(POSTS_API + (POSTS_API.indexOf("?") >= 0 ? "&" : "?") + "t=" + Date.now(), {
            cache: "no-store", redirect: "follow"
          }).then(function (r) {
            if (!r.ok) throw new Error("Posts HTTP " + r.status);
            return r.json();
          })
        );
      } else tasks.push(Promise.resolve([]));

      var results = await Promise.allSettled(tasks);
      allMcqs = [];
      allPosts = [];

      if (results[0].status === "fulfilled") {
        var d = results[0].value;
        if (d && Array.isArray(d.questions)) d = d.questions;
        else if (d && Array.isArray(d.data)) d = d.data;
        if (Array.isArray(d)) {
          allMcqs = d.map(normalizeMcq).filter(Boolean);
        }
      } else console.warn(results[0].reason);

      if (results[1].status === "fulfilled") {
        var p = results[1].value;
        if (p && p.success && Array.isArray(p.posts)) allPosts = p.posts;
        else if (Array.isArray(p)) allPosts = p;
        else if (p && Array.isArray(p.data)) allPosts = p.data;
      }

      /* enrich filter options from loaded data if meta empty */
      allMcqs.forEach(function (q) {
        if (q.exam && filterMeta.exams.indexOf(q.exam) < 0) filterMeta.exams.push(q.exam);
        if (q.subject && filterMeta.subjects.indexOf(q.subject) < 0) filterMeta.subjects.push(q.subject);
        if (q.topic && filterMeta.topics.indexOf(q.topic) < 0) filterMeta.topics.push(q.topic);
        if (q.year && filterMeta.years.indexOf(String(q.year)) < 0) filterMeta.years.push(String(q.year));
        if (q.shift && filterMeta.shifts.indexOf(q.shift) < 0) filterMeta.shifts.push(q.shift);
        if (q.section && filterMeta.sections.indexOf(q.section) < 0) filterMeta.sections.push(q.section);
      });
      applyMetaToFilters();

      if (!allMcqs.length && !allPosts.length) {
        box.innerHTML = '<div class="error">No questions for this filter<br><button class="retry" type="button" id="retryFeed">Reset</button></div>';
        $("retryFeed").onclick = function () { $("btnReset").click(); };
        return;
      }
      renderFeed(filters.type);
    } catch (e) {
      box.innerHTML = '<div class="error">Failed: ' + escapeHTML(e.message || e) +
        '<br><button class="retry" type="button" id="retryFeed">Retry</button></div>';
      $("retryFeed").onclick = loadMixedFeed;
    }
  }

  function matchFilter(item, filters) {
    function has(field, val) {
      if (!val) return true;
      return String(field || "").toLowerCase() === String(val).toLowerCase();
    }
    if (!has(item.exam, filters.exam)) return false;
    if (!has(item.subject, filters.subject)) return false;
    if (filters.topic && String(item.topic || "").toLowerCase().indexOf(String(filters.topic).toLowerCase()) < 0) return false;
    if (filters.level && String(item.difficulty || "").toLowerCase() !== String(filters.level).toLowerCase()) return false;
    if (filters.year && String(item.year || "") !== String(filters.year)) return false;
    if (filters.shift && String(item.shift || "").toLowerCase() !== String(filters.shift).toLowerCase()) return false;
    if (filters.section && String(item.section || "").toLowerCase() !== String(filters.section).toLowerCase()) return false;
    if (filters.source && String(item.source || "").toLowerCase().indexOf(String(filters.source).toLowerCase()) < 0) return false;
    if (filters.language) {
      var lang = String(item.language || "").toLowerCase();
      if (filters.language === "en" && lang && lang.indexOf("en") < 0 && lang.indexOf("hindi") >= 0) return false;
      if (filters.language === "hi" && lang && lang.indexOf("hi") < 0 && lang.indexOf("en") >= 0 && lang.indexOf("hindi") < 0) return false;
    }
    return true;
  }

  function updateFilterHint() {
    var f = currentFilters();
    var n = 0;
    Object.keys(f).forEach(function (k) {
      if (k === "type" || k === "limit") return;
      if (f[k]) n++;
    });
    if (f.type && f.type !== "All") n++;
    var h = $("filterHint");
    if (h) h.textContent = n ? (n + " active · tap") : "tap to open";
  }

  function showCorrectBurst(el) {
    try {
      var r = el.getBoundingClientRect();
      var b = document.createElement("div");
      b.className = "burst";
      b.textContent = "✨";
      b.style.left = (r.left + r.width / 2) + "px";
      b.style.top = (r.top + 4) + "px";
      document.body.appendChild(b);
      setTimeout(function () { b.remove(); }, 800);
    } catch (e) {}
  }

  function renderFeed(type) {
    var box = $("mixedFeed");
    if (!box) return;
    var filters = currentFilters();
    type = type || filters.type || "All";
    updateFilterHint();

    var mcqs = allMcqs.filter(function (q) { return matchFilter(q, filters); });
    var posts = allPosts.slice();
    mcqs = shuffle(mcqs);
    posts = shuffle(posts);

    if (type === "MCQ") posts = [];
    if (type === "Post") mcqs = [];

    if (type === "All" && mcqs.length && posts.length) {
      var eq = Math.min(mcqs.length, posts.length, 20);
      /* keep topic groups; limit overall later */
    } else if (type === "MCQ") {
      mcqs = mcqs.slice(0, 40);
    } else if (type === "Post") {
      posts = posts.slice(0, 20);
    }

    if (!mcqs.length && !posts.length) {
      box.innerHTML = '<div class="error">No questions for this filter<br><button class="retry" type="button" id="retryFeed">Reset</button></div>';
      var rb = $("retryFeed");
      if (rb) rb.onclick = function () { $("btnReset").click(); };
      return;
    }

    box.innerHTML = "";

    /* Group MCQs by topic — same topic => horizontal strip */
    var byTopic = {};
    var noTopic = [];
    mcqs.forEach(function (q) {
      var t = (q.topic || "").trim();
      if (!t) { noTopic.push(q); return; }
      if (!byTopic[t]) byTopic[t] = [];
      byTopic[t].push(q);
    });

    var topicKeys = Object.keys(byTopic);
    /* topics with 2+ go horizontal; singles merge with noTopic for mixed feed */
    var singles = [];
    topicKeys.forEach(function (t) {
      if (byTopic[t].length >= 2) {
        var block = document.createElement("div");
        block.className = "topic-block";
        var head = document.createElement("div");
        head.className = "topic-head";
        head.innerHTML = "<b>" + escapeHTML(t) + "</b><span>" + byTopic[t].length + " questions · swipe</span>";
        var sc = document.createElement("div");
        sc.className = "topic-scroll";
        byTopic[t].slice(0, 12).forEach(function (q, i) {
          sc.appendChild(renderMcq(q, "t_" + domId(t) + "_" + i));
        });
        block.appendChild(head);
        block.appendChild(sc);
        box.appendChild(block);
      } else {
        singles = singles.concat(byTopic[t]);
      }
    });

    var restMcq = shuffle(singles.concat(noTopic)).slice(0, 24);
    var restPosts = posts.slice(0, type === "All" ? Math.min(restMcq.length || 10, 12) : 20);
    var items = [];
    restMcq.forEach(function (q, i) { items.push({ type: "mcq", data: q, index: "m_" + i }); });
    restPosts.forEach(function (p) { items.push({ type: "post", data: p }); });
    items = shuffle(items);
    items.forEach(function (it) {
      if (it.type === "mcq") box.appendChild(renderMcq(it.data, it.index));
      else box.appendChild(renderPost(it.data));
    });
    refreshActionStates();
  }

