<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>PrepExam</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden;font-family:Inter,system-ui,-apple-system,sans-serif;background:#f8fafc;color:#0f172a}
:root{
  --nav-h:58px;
  --title-h:52px;
  --safe-b:env(safe-area-inset-bottom,0px);
  --primary:#2563eb;
  --border:#e5e7eb;
  --muted:#64748b;
}
.app{display:flex;flex-direction:column;height:100%;height:100dvh}
.titlebar{
  height:var(--title-h);background:#fff;border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:8px;padding:0 12px;z-index:40;flex-shrink:0;
}
.titlebar.home-mode .back-btn{display:none}
.titlebar.sub-mode .brand-home{display:none}
.titlebar.sub-mode .back-btn{display:flex}
.back-btn{
  display:none;width:40px;height:40px;border:0;border-radius:12px;background:#f1f5f9;
  align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;color:#0f172a
}
.back-btn:active{background:#e2e8f0}
.back-btn svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.brand-home{display:flex;align-items:center;gap:10px;min-width:0;flex:1}
.brand-home img.app-icon{
  width:34px;height:34px;border-radius:10px;object-fit:cover;flex-shrink:0;
  box-shadow:0 2px 8px rgba(37,99,235,.2)
}
.brand-home .app-name{font-size:.98rem;font-weight:800;letter-spacing:-.02em;line-height:1.1}
.brand-home .page-sub{font-size:.66rem;font-weight:600;color:var(--muted);margin-top:2px}
.sub-title{
  flex:1;min-width:0;font-size:1rem;font-weight:800;letter-spacing:-.02em;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis
}
.title-right{display:flex;align-items:center;gap:6px;margin-left:auto}
.icon-btn{
  width:38px;height:38px;border:0;border-radius:12px;background:transparent;
  display:flex;align-items:center;justify-content:center;cursor:pointer;color:#0f172a
}
.icon-btn:active{background:#f1f5f9}
.icon-btn svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
.user-chip{
  font-size:.66rem;font-weight:700;color:var(--muted);background:#f1f5f9;
  padding:5px 9px;border-radius:999px;max-width:88px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap
}
.content{flex:1;min-height:0;position:relative;background:#f8fafc}
.page-slot{position:absolute;inset:0;width:100%;height:100%;border:0;background:#fff;display:none}
.page-slot.active{display:block}
.frame-loading{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  background:#fff;z-index:8;flex-direction:column;gap:12px;color:var(--muted);font-size:.88rem;font-weight:600
}
.frame-loading.hide{display:none}
.spinner{width:28px;height:28px;border:3px solid #e5e7eb;border-top-color:var(--primary);border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.frame-error{
  position:absolute;inset:0;display:none;align-items:center;justify-content:center;
  background:#fff;z-index:9;flex-direction:column;gap:10px;padding:24px;text-align:center
}
.frame-error.show{display:flex}
.frame-error p{font-size:.9rem;color:var(--muted);line-height:1.45}
.frame-error button{margin-top:6px;border:0;background:var(--primary);color:#fff;font-weight:700;font-size:.82rem;padding:10px 18px;border-radius:12px;cursor:pointer}
.bottomnav{
  height:calc(var(--nav-h) + var(--safe-b));padding-bottom:var(--safe-b);
  background:#fff;border-top:1px solid var(--border);
  display:flex;align-items:stretch;justify-content:space-around;flex-shrink:0;z-index:40;
  transition:transform .22s ease,opacity .18s ease
}
.bottomnav.hidden{transform:translateY(110%);opacity:0;pointer-events:none;position:absolute;left:0;right:0;bottom:0}
.nav-item{
  flex:1;border:0;background:transparent;cursor:pointer;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:3px;padding:6px 2px 4px;color:#262626;position:relative
}
.nav-item svg{width:24px;height:24px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.nav-item .label{font-size:.6rem;font-weight:600;color:#8e8e8e;line-height:1;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.nav-item.active{color:#0f172a}
.nav-item.active .label{color:#0f172a;font-weight:700}
.nav-item.active svg{stroke-width:2.15}
.nav-item .ico-outline{display:block}
.nav-item .ico-fill{display:none}
.nav-item.active .ico-outline{display:none}
.nav-item.active .ico-fill{display:block;fill:currentColor;stroke:none}
.nav-notif-dot{position:absolute;top:6px;right:calc(50% - 14px);width:7px;height:7px;border-radius:50%;background:#ef4444;display:none}
.nav-notif-dot.on{display:block}
</style>
</head>
<body>
<div class="app" id="app">
  <header class="titlebar home-mode" id="titlebar">
    <button type="button" class="back-btn" id="btnBack" aria-label="Back">
      <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <div class="brand-home">
      <img class="app-icon" src="https://iili.io/neLvXZ7.jpg" alt="PrepExam" width="34" height="34">
      <div>
        <div class="app-name">PrepExam</div>
        <div class="page-sub">Practice smarter</div>
      </div>
    </div>
    <div class="sub-title" id="subTitle" style="display:none">Page</div>
    <div class="title-right">
      <span class="user-chip" id="userChip">…</span>
      <button type="button" class="icon-btn" id="btnRefresh" title="Refresh" aria-label="Refresh">
        <svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-2.6-6.2"/><polyline points="21 3 21 9 15 9"/></svg>
      </button>
    </div>
  </header>

  <main class="content" id="content">
    <div class="frame-loading" id="frameLoading"><div class="spinner"></div><span>Loading…</span></div>
    <div class="frame-error" id="frameError">
      <p id="frameErrorMsg">Page load nahi hua.</p>
      <button type="button" id="btnRetry">Retry</button>
    </div>
  </main>

  <nav class="bottomnav" id="bottomnav" role="tablist" aria-label="Main">
    <button type="button" class="nav-item active" data-page="home" role="tab" aria-selected="true">
      <svg class="ico-outline" viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9"/></svg>
      <svg class="ico-fill" viewBox="0 0 24 24"><path d="M12 3 3 10.5V20a1 1 0 0 0 1 1h6v-7h4v7h6a1 1 0 0 0 1-1v-9.5L12 3z"/></svg>
      <span class="label">Home</span>
    </button>
    <button type="button" class="nav-item" data-page="study" role="tab" aria-selected="false">
      <svg class="ico-outline" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      <svg class="ico-fill" viewBox="0 0 24 24"><path d="M6.5 2A2.5 2.5 0 0 0 4 4.5v15A2.5 2.5 0 0 0 6.5 22H20V2H6.5z"/></svg>
      <span class="label">Study</span>
    </button>
    <button type="button" class="nav-item" data-page="mock" role="tab" aria-selected="false">
      <svg class="ico-outline" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9h4M7 13h10M7 17h7"/></svg>
      <svg class="ico-fill" viewBox="0 0 24 24"><path d="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm2 6h4v1.5H7V9zm0 4h10v1.5H7V13zm0 4h7v1.5H7V17z"/></svg>
      <span class="label">Mocks</span>
    </button>
    <button type="button" class="nav-item" data-page="notification" role="tab" aria-selected="false">
      <span class="nav-notif-dot" id="navNotifDot"></span>
      <svg class="ico-outline" viewBox="0 0 24 24"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
      <svg class="ico-fill" viewBox="0 0 24 24"><path d="M12 2a6 6 0 0 0-6 6c0 7-3 9-3 9h18s-3-2-3-9a6 6 0 0 0-6-6zm-1.7 19a1.94 1.94 0 0 0 3.4 0h-3.4z"/></svg>
      <span class="label">Alerts</span>
    </button>
    <button type="button" class="nav-item" data-page="profile" role="tab" aria-selected="false">
      <svg class="ico-outline" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg>
      <svg class="ico-fill" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6H4z"/></svg>
      <span class="label">Profile</span>
    </button>
  </nav>
</div>

<script>
(function () {
  var GITHUB_BASE = "https://raw.githubusercontent.com/subham781/App-ui-s/main/";
  var FIREBASE_DB = "https://prepexam-f98bf-default-rtdb.firebaseio.com";

  var PAGES = {
    home:         { title: "Home",          file: "app shell home" },
    study:        { title: "Study material", file: "Study material" },
    mock:         { title: "Mock tests",    file: "PrepExam_Mock_Tests_Modern_Firebase.html" },
    notification: { title: "Notifications", file: "notification" },
    profile:      { title: "Profile",       file: "Profile" }
  };

  var userId = "", userName = "", currentPage = "home";
  var cache = {};
  var content = document.getElementById("content");
  var loading = document.getElementById("frameLoading");
  var errBox = document.getElementById("frameError");
  var errMsg = document.getElementById("frameErrorMsg");
  var titlebar = document.getElementById("titlebar");
  var subTitle = document.getElementById("subTitle");
  var bottomnav = document.getElementById("bottomnav");
  var userChip = document.getElementById("userChip");
  var historyStack = [];

  function getWebViewString() {
    try { if (window.AppInventor && window.AppInventor.getWebViewString) return String(window.AppInventor.getWebViewString() || "").trim(); } catch (e) {}
    try { if (window.Kodular && window.Kodular.getWebViewString) return String(window.Kodular.getWebViewString() || "").trim(); } catch (e) {}
    return "";
  }
  function normalizeUserId(raw) {
    var id = String(raw || "").trim();
    if (id.indexOf("|") > 0) id = id.split("|").pop();
    if (id.indexOf("@") > 0) id = id.split("@")[0];
    return id.replace(/[.#$\[\]\/]/g, "_").trim();
  }
  function pageUrl(key) {
    var p = PAGES[key]; if (!p) return "";
    return GITHUB_BASE + String(p.file).split("/").map(encodeURIComponent).join("/");
  }
  function ensureSlot(key) {
    var id = "slot_" + key;
    var el = document.getElementById(id);
    if (el) return el;
    el = document.createElement("iframe");
    el.className = "page-slot"; el.id = id; el.title = (PAGES[key] && PAGES[key].title) || key;
    el.setAttribute("allow", "fullscreen");
    content.appendChild(el);
    return el;
  }
  function setChrome(key) {
    var isHome = key === "home";
    titlebar.classList.toggle("home-mode", isHome);
    titlebar.classList.toggle("sub-mode", !isHome);
    subTitle.style.display = isHome ? "none" : "block";
    subTitle.textContent = (PAGES[key] && PAGES[key].title) || key;
    bottomnav.classList.toggle("hidden", !isHome);
    document.querySelectorAll(".nav-item").forEach(function (btn) {
      var on = btn.getAttribute("data-page") === key;
      btn.classList.toggle("active", on);
      btn.setAttribute("aria-selected", on ? "true" : "false");
    });
  }
  function showLoading(on) { loading.classList.toggle("hide", !on); }
  function showError(msg) { errMsg.textContent = msg || "Page load nahi hua."; errBox.classList.add("show"); showLoading(false); }
  function hideError() { errBox.classList.remove("show"); }

  function injectBridge(html) {
    var bridge = "\n<script>(function(){try{" +
      "window.__PREPEXAM_USER_ID__=" + JSON.stringify(userId) + ";" +
      "window.__PREPEXAM_USER_NAME__=" + JSON.stringify(userName) + ";" +
      "if(!window.AppInventor)window.AppInventor={};" +
      "if(!window.AppInventor.getWebViewString)window.AppInventor.getWebViewString=function(){return window.__PREPEXAM_USER_ID__||'';};" +
      "if(!window.Kodular)window.Kodular={};" +
      "if(!window.Kodular.getWebViewString)window.Kodular.getWebViewString=function(){return window.__PREPEXAM_USER_ID__||'';};" +
      "document.addEventListener('focusin',function(e){try{if(e.target&&(e.target.matches('input[type=search],input.search,.search,#globalSearch')))parent.postMessage({type:'prepexam-search',open:true},'*');}catch(x){}});" +
      "document.addEventListener('focusout',function(e){try{if(e.target&&(e.target.matches('input[type=search],input.search,.search,#globalSearch')))setTimeout(function(){parent.postMessage({type:'prepexam-search',open:false},'*');},180);}catch(x){}});" +
      "}catch(e){}})();<\/script>\n";
    if (/<\/head>/i.test(html)) return html.replace(/<\/head>/i, bridge + "</head>");
    if (/<body[^>]*>/i.test(html)) return html.replace(/<body([^>]*)>/i, "<body$1>" + bridge);
    return bridge + html;
  }

  async function fetchPageHtml(key) {
    var url = pageUrl(key);
    var res = await fetch(url + (url.indexOf("?") >= 0 ? "&" : "?") + "t=" + Date.now(), { cache: "no-store", redirect: "follow" });
    if (!res.ok) throw new Error("HTTP " + res.status);
    var html = await res.text();
    if (!html || html.length < 40) throw new Error("Empty page");
    return injectBridge(html);
  }
  function writeSlot(key, html) {
    var slot = ensureSlot(key);
    var doc = slot.contentDocument || slot.contentWindow.document;
    doc.open(); doc.write(html); doc.close();
    cache[key] = { loaded: true };
  }
  function showSlot(key) {
    document.querySelectorAll(".page-slot").forEach(function (s) {
      s.classList.toggle("active", s.id === "slot_" + key);
    });
  }

  async function openPage(key, opts) {
    opts = opts || {};
    if (!PAGES[key]) return;
    var force = !!opts.force;
    var fromBack = !!opts.fromBack;
    if (!fromBack && currentPage && currentPage !== key) historyStack.push(currentPage);
    currentPage = key;
    setChrome(key);
    hideError();
    if (cache[key] && cache[key].loaded && !force) {
      showSlot(key); showLoading(false); return;
    }
    showLoading(true);
    try {
      var html = await fetchPageHtml(key);
      writeSlot(key, html);
      showSlot(key);
      showLoading(false);
    } catch (e) {
      console.warn(e);
      showError((e && e.message) || "Network error");
    }
  }
  function goBack() {
    if (historyStack.length) { openPage(historyStack.pop(), { fromBack: true }); return; }
    openPage("home", { fromBack: true });
  }

  document.querySelectorAll(".nav-item").forEach(function (btn) {
    btn.addEventListener("click", function () { openPage(btn.getAttribute("data-page"), {}); });
  });
  document.getElementById("btnBack").onclick = goBack;
  document.getElementById("btnRefresh").onclick = function () { openPage(currentPage, { force: true, fromBack: true }); };
  document.getElementById("btnRetry").onclick = function () { openPage(currentPage, { force: true, fromBack: true }); };

  window.addEventListener("message", function (e) {
    var d = e.data || {};
    if (d.type === "prepexam-search") {
      if (d.open) bottomnav.classList.add("hidden");
      else if (currentPage === "home") bottomnav.classList.remove("hidden");
    }
  });

  async function resolveUser() {
    userId = normalizeUserId(getWebViewString());
    if (!userId) { await new Promise(function (r) { setTimeout(r, 400); }); userId = normalizeUserId(getWebViewString()); }
    if (!userId) { userChip.textContent = "Guest"; return; }
    userChip.textContent = userId.length > 12 ? userId.slice(0, 10) + "…" : userId;
    try {
      var r = await fetch(FIREBASE_DB + "/Users/" + encodeURIComponent(userId) + ".json?t=" + Date.now());
      if (!r.ok) return;
      var data = await r.json();
      if (data && data.profile) {
        userName = data.profile.name || data.profile.channelName || userId;
        userChip.textContent = userName.length > 14 ? userName.slice(0, 12) + "…" : userName;
      }
    } catch (e) {}
  }

  (async function init() {
    await resolveUser();
    await openPage("home", { fromBack: true });
  })();
})();
</script>
</body>
</html>
