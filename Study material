<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Study Materials</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial,sans-serif;
    background:#f5f7fb;
    color:#172033;
}

.header{
    background:linear-gradient(135deg,#2563eb,#4f46e5);
    color:white;
    padding:28px 18px 45px;
    border-radius:0 0 28px 28px;
}

.header-inner{
    max-width:1000px;
    margin:auto;
}

.header h1{
    font-size:28px;
    margin-bottom:7px;
}

.container{
    max-width:1000px;
    margin:-22px auto 40px;
    padding:0 15px;
}

.card{
    background:white;
    border-radius:18px;
    padding:22px;
    margin-bottom:18px;
    box-shadow:0 8px 25px rgba(20,30,60,.08);
}

.title{
    font-size:19px;
    font-weight:700;
    margin-bottom:17px;
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(180px,1fr));
    gap:14px;
}

.select-card{
    border:1px solid #e4e8f0;
    background:white;
    padding:18px 14px;
    border-radius:14px;
    cursor:pointer;
    text-align:left;
    font-size:15px;
    font-weight:600;
    transition:.2s;
}

.select-card:hover{
    border-color:#4f46e5;
    transform:translateY(-2px);
}

.icon{
    width:43px;
    height:43px;
    border-radius:12px;
    background:#eef2ff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:21px;
    margin-bottom:10px;
}

.breadcrumb{
    display:flex;
    flex-wrap:wrap;
    gap:7px;
    color:#667085;
    font-size:14px;
    margin-bottom:15px;
}

.breadcrumb span{
    color:#4338ca;
    font-weight:600;
}

.back-btn{
    border:0;
    background:#f1f5f9;
    color:#334155;
    padding:10px 15px;
    border-radius:10px;
    cursor:pointer;
    font-weight:600;
    margin-bottom:17px;
}

.search{
    width:100%;
    padding:13px 15px;
    border:1px solid #dfe3eb;
    border-radius:12px;
    outline:none;
    font-size:15px;
    margin-bottom:15px;
}

.chapter-list{
    display:flex;
    flex-direction:column;
    gap:10px;
}

.chapter{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
    padding:15px;
    border:1px solid #e8ebf1;
    border-radius:13px;
}

.chapter-info{
    display:flex;
    align-items:center;
    gap:12px;
}

.chapter-number{
    min-width:38px;
    height:38px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#f1f5f9;
    border-radius:10px;
    font-weight:700;
}

.open-btn{
    border:0;
    background:#4f46e5;
    color:white;
    padding:10px 16px;
    border-radius:9px;
    cursor:pointer;
    font-weight:600;
}

#viewer{
    display:none;
}

.viewer-top{
    display:flex;
    align-items:center;
    gap:12px;
    margin-bottom:18px;
}

.viewer-title{
    font-size:20px;
    font-weight:700;
}

.close-btn{
    border:0;
    background:#fee2e2;
    color:#dc2626;
    padding:9px 13px;
    border-radius:9px;
    cursor:pointer;
    font-weight:600;
}

#renderArea{
    width:100%;
    overflow:auto;
}

.loading{
    text-align:center;
    padding:35px;
    color:#667085;
}

.spinner{
    width:35px;
    height:35px;
    border:4px solid #e5e7eb;
    border-top-color:#4f46e5;
    border-radius:50%;
    animation:spin .8s linear infinite;
    margin:0 auto 12px;
}

@keyframes spin{
    to{transform:rotate(360deg);}
}

.error{
    text-align:center;
    padding:30px;
    color:#dc2626;
}

.empty{
    text-align:center;
    padding:30px;
    color:#667085;
}

.hidden{
    display:none!important;
}

@media(max-width:600px){

    .header h1{
        font-size:23px;
    }

    .card{
        padding:17px;
    }

    .grid{
        grid-template-columns:1fr 1fr;
    }

    .chapter{
        align-items:flex-start;
    }
}

@media(max-width:380px){

    .grid{
        grid-template-columns:1fr;
    }

    .chapter{
        flex-direction:column;
    }

    .open-btn{
        width:100%;
    }
}
</style>
</head>

<body>

<header class="header">
    <div class="header-inner">
        <h1>📚 Study Materials</h1>
        <p>Select your exam, subject and chapter</p>
    </div>
</header>

<main class="container">

<!-- LOADING -->

<div id="loading" class="card loading">
    <div class="spinner"></div>
    <p>Loading exams...</p>
</div>


<!-- ERROR -->

<div id="error" class="card error hidden">
    <h3>Firebase Error</h3>
    <p id="errorText"></p>
</div>


<!-- EXAMS -->

<section id="examSection" class="card hidden">

    <div class="title">
        🎯 Select Exam
    </div>

    <div id="examGrid" class="grid"></div>

</section>


<!-- SUBJECTS -->

<section id="subjectSection" class="card hidden">

    <div class="breadcrumb">
        Exam:
        <span id="selectedExam"></span>
    </div>

    <button class="back-btn" onclick="backToExams()">
        ← Change Exam
    </button>

    <div class="title">
        📖 Select Subject
    </div>

    <div id="subjectGrid" class="grid"></div>

</section>


<!-- CHAPTERS -->

<section id="chapterSection" class="card hidden">

    <div class="breadcrumb">
        <span id="breadcrumbExam"></span>
        →
        <span id="breadcrumbSubject"></span>
    </div>

    <button class="back-btn" onclick="backToSubjects()">
        ← Change Subject
    </button>

    <div class="title">
        📑 Select Chapter
    </div>

    <input
        id="search"
        class="search"
        type="text"
        placeholder="Search chapter..."
        oninput="searchChapters()"
    >

    <div id="chapterList"></div>

</section>


<!-- HTML VIEWER -->

<section id="viewer" class="card">

    <div class="viewer-top">

        <button class="close-btn" onclick="closeViewer()">
            ← Back
        </button>

        <div id="viewerTitle" class="viewer-title">
            Study Material
        </div>

    </div>

    <div id="renderArea"></div>

</section>

</main>


<script>

/* =========================================
   FIREBASE
========================================= */

const DATABASE_URL =
"https://prepexam-f98bf-default-rtdb.firebaseio.com";

const DATABASE_PATH =
"/Exams.json";


/* =========================================
   VARIABLES
========================================= */

let examsData = {};
let selectedExam = "";
let selectedSubject = "";
let chapters = [];


/* =========================================
   ELEMENTS
========================================= */

const loading =
document.getElementById("loading");

const errorBox =
document.getElementById("error");

const errorText =
document.getElementById("errorText");

const examSection =
document.getElementById("examSection");

const subjectSection =
document.getElementById("subjectSection");

const chapterSection =
document.getElementById("chapterSection");

const viewer =
document.getElementById("viewer");

const examGrid =
document.getElementById("examGrid");

const subjectGrid =
document.getElementById("subjectGrid");

const chapterList =
document.getElementById("chapterList");

const renderArea =
document.getElementById("renderArea");


/* =========================================
   LOAD FIREBASE
========================================= */

async function loadFirebase(){

    console.log(
        "Fetching:",
        DATABASE_URL + DATABASE_PATH
    );

    try{

        const response =
        await fetch(
            DATABASE_URL + DATABASE_PATH,
            {
                method:"GET",
                cache:"no-cache"
            }
        );


        console.log(
            "Firebase HTTP status:",
            response.status
        );


        if(!response.ok){

            throw new Error(
                "Firebase returned HTTP " +
                response.status
            );

        }


        const data =
        await response.json();


        console.log(
            "Firebase data:",
            data
        );


        if(data === null){

            throw new Error(
                "Firebase returned null. " +
                "Check that your database has an 'Exams' node " +
                "and that your Firebase rules allow read access."
            );

        }


        if(typeof data !== "object"){

            throw new Error(
                "Exams data is not an object."
            );

        }


        examsData = data;


        loading.classList.add(
            "hidden"
        );


        renderExams();


    }catch(err){

        console.error(
            "Firebase loading error:",
            err
        );


        loading.classList.add(
            "hidden"
        );


        errorBox.classList.remove(
            "hidden"
        );


        errorText.innerHTML =
        escapeHTML(err.message);

    }

}


/* =========================================
   RENDER EXAMS
========================================= */

function renderExams(){

    examGrid.innerHTML = "";


    /*
       IMPORTANT:

       We are reading:

       Exams
       ├── Nda
       ├── ...
       */

    const exams =
    Object.keys(examsData);


    console.log(
        "Exams found:",
        exams
    );


    if(exams.length === 0){

        examGrid.innerHTML = `
            <div class="empty">
                No exams found inside Firebase.
            </div>
        `;

        examSection.classList.remove(
            "hidden"
        );

        return;
    }


    exams.forEach(
        (exam) => {

            const button =
            document.createElement("button");


            button.className =
            "select-card";


            button.innerHTML = `
                <div class="icon">
                    🎓
                </div>

                ${escapeHTML(exam)}
            `;


            button.onclick =
            function(){

                selectExam(exam);

            };


            examGrid.appendChild(
                button
            );

        }
    );


    examSection.classList.remove(
        "hidden"
    );

}


/* =========================================
   SELECT EXAM
========================================= */

function selectExam(exam){

    selectedExam = exam;


    document.getElementById(
        "selectedExam"
    ).textContent = exam;


    examSection.classList.add(
        "hidden"
    );


    renderSubjects();


    subjectSection.classList.remove(
        "hidden"
    );


    goTop();

}


/* =========================================
   SUBJECTS
========================================= */

function renderSubjects(){

    subjectGrid.innerHTML = "";


    const examData =
    examsData[selectedExam];


    console.log(
        "Selected exam data:",
        examData
    );


    if(
        !examData ||
        typeof examData !== "object"
    ){

        subjectGrid.innerHTML = `
            <div class="empty">
                No subjects found.
            </div>
        `;

        return;
    }


    Object.keys(examData)
    .forEach(
        subject => {

            const button =
            document.createElement("button");


            button.className =
            "select-card";


            button.innerHTML = `
                <div class="icon">
                    📘
                </div>

                ${escapeHTML(subject)}
            `;


            button.onclick =
            () => selectSubject(subject);


            subjectGrid.appendChild(
                button
            );

        }
    );

}


/* =========================================
   SELECT SUBJECT
========================================= */

function selectSubject(subject){

    selectedSubject = subject;


    document.getElementById(
        "breadcrumbExam"
    ).textContent =
        selectedExam;


    document.getElementById(
        "breadcrumbSubject"
    ).textContent =
        selectedSubject;


    subjectSection.classList.add(
        "hidden"
    );


    document.getElementById(
        "search"
    ).value = "";


    renderChapters();


    chapterSection.classList.remove(
        "hidden"
    );


    goTop();

}


/* =========================================
   CHAPTERS
========================================= */

function renderChapters(){

    const subjectData =
    examsData[selectedExam]
    [selectedSubject];


    console.log(
        "Subject data:",
        subjectData
    );


    if(
        !subjectData ||
        typeof subjectData !== "object"
    ){

        chapters = [];

        displayChapters([]);

        return;

    }


    chapters =
    Object.entries(subjectData);


    displayChapters(
        chapters
    );

}


/* =========================================
   DISPLAY CHAPTERS
========================================= */

function displayChapters(list){

    chapterList.innerHTML = "";


    if(list.length === 0){

        chapterList.innerHTML = `
            <div class="empty">
                No chapters found.
            </div>
        `;

        return;
    }


    list.forEach(
        ([chapterName, link], index) => {

            const row =
            document.createElement("div");


            row.className =
            "chapter";


            row.innerHTML = `

                <div class="chapter-info">

                    <div class="chapter-number">
                        ${index + 1}
                    </div>

                    <div class="chapter-name">
                        ${escapeHTML(chapterName)}
                    </div>

                </div>

                <button class="open-btn">
                    Open →
                </button>

            `;


            const button =
            row.querySelector(
                ".open-btn"
            );


            button.onclick =
            () => openChapter(
                chapterName,
                link
            );


            chapterList.appendChild(
                row
            );

        }
    );

}


/* =========================================
   OPEN CHAPTER
========================================= */

async function openChapter(
    chapterName,
    link
){

    console.log(
        "Opening chapter:",
        chapterName
    );

    console.log(
        "Chapter URL:",
        link
    );


    if(
        typeof link !== "string" ||
        !link.trim()
    ){

        alert(
            "This chapter has no valid link."
        );

        return;
    }


    examSection.classList.add(
        "hidden"
    );

    subjectSection.classList.add(
        "hidden"
    );

    chapterSection.classList.add(
        "hidden"
    );


    viewer.style.display =
        "block";


    document.getElementById(
        "viewerTitle"
    ).textContent =
        chapterName;


    renderArea.innerHTML = `
        <div class="loading">
            <div class="spinner"></div>
            <p>
                Loading ${escapeHTML(chapterName)}...
            </p>
        </div>
    `;


    goTop();


    try{

        /*
          Fetch HTML TEXT
        */

        const response =
        await fetch(
            link,
            {
                method:"GET",
                cache:"no-cache"
            }
        );


        if(!response.ok){

            throw new Error(
                "Chapter server returned HTTP " +
                response.status
            );

        }


        /*
          Get HTML as text
        */

        const html =
        await response.text();


        console.log(
            "HTML received:",
            html.substring(0,500)
        );


        if(!html.trim()){

            throw new Error(
                "The HTML page is empty."
            );

        }


        /*
          Render HTML
        */

        renderHTML(
            html
        );

    }
    catch(err){

        console.error(
            "Chapter error:",
            err
        );


        renderArea.innerHTML = `

            <div class="error">

                <h3>
                    HTML load nahi ho saka
                </h3>

                <p style="margin-top:10px;">
                    ${escapeHTML(err.message)}
                </p>

                <p style="
                    margin-top:15px;
                    color:#555;
                ">
                    Agar yahan CORS error aa raha hai,
                    to jis server par chapter HTML hai
                    us server ko cross-origin requests
                    allow karni hongi.
                </p>

            </div>
        `;

    }

}


/* =========================================
   RENDER HTML
========================================= */

function renderHTML(html){

    /*
       HTML ko iframe ke andar
       render karenge.

       Isse chapter ka CSS/JS
       main app ke CSS/JS se
       conflict nahi karega.
    */

    const iframe =
    document.createElement(
        "iframe"
    );


    iframe.style.width =
        "100%";


    iframe.style.minHeight =
        "750px";


    iframe.style.border =
        "0";


    iframe.style.display =
        "block";


    iframe.style.borderRadius =
        "12px";


    /*
       Fetched HTML directly
       iframe mein jayega.
    */

    iframe.srcdoc =
        html;


    /*
       HTML ke JavaScript ko
       run karne ki permission.

       Forms/popups bhi allow.
    */

    iframe.setAttribute(
        "sandbox",
        "allow-scripts allow-forms allow-modals allow-popups allow-same-origin"
    );


    renderArea.innerHTML = "";


    renderArea.appendChild(
        iframe
    );

}


/* =========================================
   SEARCH
========================================= */

function searchChapters(){

    const text =
    document.getElementById(
        "search"
    ).value
    .toLowerCase()
    .trim();


    const filtered =
    chapters.filter(
        ([name]) =>
            name.toLowerCase()
            .includes(text)
    );


    displayChapters(
        filtered
    );

}


/* =========================================
   BACK
========================================= */

function backToExams(){

    subjectSection.classList.add(
        "hidden"
    );

    chapterSection.classList.add(
        "hidden"
    );

    viewer.style.display =
        "none";


    examSection.classList.remove(
        "hidden"
    );


    goTop();

}


function backToSubjects(){

    chapterSection.classList.add(
        "hidden"
    );

    viewer.style.display =
        "none";


    subjectSection.classList.remove(
        "hidden"
    );


    goTop();

}


/* =========================================
   CLOSE VIEWER
========================================= */

function closeViewer(){

    renderArea.innerHTML = "";

    viewer.style.display =
        "none";

    chapterSection.classList.remove(
        "hidden"
    );

    goTop();

}


/* =========================================
   SECURITY
========================================= */

function escapeHTML(value){

    return String(value)
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


/* =========================================
   TOP
========================================= */

function goTop(){

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });

}


/* =========================================
   START
========================================= */

loadFirebase();

</script>

</body>
</html>


