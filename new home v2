    var imgWrap = card.querySelector(".post-img-wrap");
    if (imgWrap && imgUrl) {
      imgWrap.onclick = function () { openImageLightbox(imgUrl); };
    }
    return card;
  }

  /* wiki insight */
  async function showTopicInsight(qIndex, item) {
    var box = $("insight-" + domId(qIndex));
    if (!box || box.dataset.loaded === "1") return;
    box.classList.add("show");
    box.innerHTML = '<div style="font-size:.8rem;color:#64748b">Loading notes…</div>';
    try {
      var q = (item.topic || item.subject || item.q || "general knowledge").toString();
      var searchUrl = "https://en.wikipedia.org/w/api.php?action=query&list=search&srsearch=" +
        encodeURIComponent(q) + "&srlimit=3&format=json&origin=*";
      var searchData = await (await fetch(searchUrl)).json();
      var results = (searchData.query && searchData.query.search) || [];
      if (!results.length) {
        box.innerHTML = '<div class="insight-title">📚 Topic</div><div style="font-size:.8rem;color:#64748b">No notes</div>';
        return;
      }
      var cards = [];
      for (var i = 0; i < Math.min(3, results.length); i++) {
        var t = results[i].title;
        try {
          var sum = await (await fetch("https://en.wikipedia.org/api/rest_v1/page/summary/" + encodeURIComponent(t))).json();
          if (sum && sum.type !== "disambiguation") {
            cards.push({ t: sum.title || t, d: sum.extract || "", pageUrl: "https://en.wikipedia.org/wiki/" + encodeURIComponent((sum.title || t).replace(/ /g, "_")) });
          }
        } catch (e) {}
      }
      var html = '<div class="insight-title">📚 Quick notes</div><div class="insight-scroll">';
      cards.forEach(function (c) {
        html += '<div class="insight-card"><h4>' + escapeHTML(c.t) + "</h4><p>" + escapeHTML(c.d) + "</p></div>";
      });
      html += "</div>";
      box.innerHTML = html;
      box.dataset.loaded = "1";
      box.querySelectorAll(".insight-card").forEach(function (el, idx) {
        el.onclick = function () { openSheet(cards[idx].t, cards[idx].pageUrl); };
      });
    } catch (e) {
      box.innerHTML = '<div class="insight-title">📚 Topic</div><div style="font-size:.8rem;color:#64748b">Unavailable</div>';
    }
  }

  function openSheet(title, url) {
    $("sheetTitle").textContent = title;
    $("sheetOverlay").classList.add("show");
    var frame = $("sheetFrame");
    var loading = $("sheetLoading");
    loading.style.display = "block";
    frame.style.display = "none";
    frame.onload = function () { loading.style.display = "none"; frame.style.display = "block"; };
    frame.src = url;
  }
  $("btnSheetClose").onclick = function () {
    $("sheetOverlay").classList.remove("show");
    $("sheetFrame").src = "about:blank";
  };
  $("sheetOverlay").onclick = function (e) {
    if (e.target.id === "sheetOverlay") $("btnSheetClose").click();
  };

  $("btnApply").onclick = function () { updateFilterHint(); loadMixedFeed(); };
  $("btnReset").onclick = function () {
    ["fExam", "fSubject", "fTopic", "fLevel", "fYear", "fShift", "fSection", "fSource", "fLang"].forEach(function (id) {
      $(id).value = "";
    });
    $("fType").value = "All";
    loadMixedFeed();
  };
  $("btnRefresh").onclick = loadMixedFeed;

  window.addEventListener("scroll", function () {
    $("scrollHint").classList.toggle("hide", window.scrollY > 80);
  }, { passive: true });

  renderFeatures();
  renderAds();
  loadMeta().then(loadMixedFeed).then(function () {
    return Promise.all([loadCurrentUser(), loadLeaderboard()]);
  });
})();
</script>
</body>
</html>
