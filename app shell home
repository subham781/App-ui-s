  function renderMcq(item,index){
    var card=document.createElement("div"); card.className="card";
    var uname=item.username||"Educator", qid=getQid(item);
    if(qid) card.setAttribute("data-qid",qid);
    card.innerHTML=
      '<div class="tag tag-mcq">MCQ'+(item.source?" · "+escapeHTML(item.source):"")+"</div>"+
      '<div class="post-header"><div class="avatar">'+escapeHTML(String(uname).charAt(0).toUpperCase())+'</div>'+
      '<div style="flex:1"><div class="uname">'+escapeHTML(uname)+'</div><div class="exam-row">'+examTagsHtml(item)+'</div>'+
      '<div class="meta">'+escapeHTML(item.subject||"")+(item.topic?" · "+escapeHTML(item.topic):"")+" · "+escapeHTML(item.difficulty||"Medium")+"</div></div></div>"+
      '<div class="q">'+escapeHTML(item.q||"")+"</div>"+
      '<div class="options" id="options-'+domId(index)+'"></div>'+
      '<div class="footer-line" id="answered-'+domId(index)+'">Tap an option</div>'+
      '<div class="q-actions">'+
        '<button class="q-action" type="button" data-qact="like">♡ Like</button>'+
        '<button class="q-action" type="button" data-qact="save">Save</button>'+
        '<button class="q-action revision" type="button" data-qact="revision">+ Revision</button></div>';
    var optBox=card.querySelector(".options");
    (item.options||[]).forEach(function(opt,i){
      var d=document.createElement("div"); d.className="option"; d.textContent=opt||"—";
      d.onclick=function(){ selectOption(index,i,item); }; optBox.appendChild(d);
    });
    card.querySelector('[data-qact="like"]').onclick=function(){
      var next=!likedQuestions[qid]; setUserFlag("likedQuestions",qid,next).then(function(ok){
        if(!ok) return; if(next) likedQuestions[qid]=true; else delete likedQuestions[qid];
        this.classList.toggle("active",next); this.textContent=next?"♥ Liked":"♡ Like";
      }.bind(this));
    };
    card.querySelector('[data-qact="save"]').onclick=function(){
      var next=!savedQuestions[qid]; setUserFlag("savedQuestions",qid,next).then(function(ok){
        if(!ok) return; if(next) savedQuestions[qid]=true; else delete savedQuestions[qid];
        this.classList.toggle("active",next); this.textContent=next?"✓ Saved":"Save";
      }.bind(this));
    };
    card.querySelector('[data-qact="revision"]').onclick=function(){
      var next=!revisionQuestions[qid]; setUserFlag("revisionQuestions",qid,next).then(function(ok){
        if(!ok) return; if(next) revisionQuestions[qid]=true; else delete revisionQuestions[qid];
        this.classList.toggle("active",next); this.textContent=next?"✓ In Revision":"+ Revision";
      }.bind(this));
    };
    /* Auto chapter notes under this MCQ (Drive study-material HTML) */
    var notesSlot = document.createElement("div");
    notesSlot.className = "notes-slot";
    notesSlot.innerHTML = '<div class="notes-loading">Loading notes…</div>';
    card.appendChild(notesSlot);
    renderChapterNotesForItem(item).then(function (html) {
      notesSlot.innerHTML = html || "";
      var btn = notesSlot.querySelector(".chapter-notes-cta");
      if (btn) {
        btn.onclick = function () {
          var id = btn.getAttribute("data-notes-id");
          var file = null;
          if (_notesIndex) {
            Object.keys(_notesIndex).forEach(function (k) {
              if (_notesIndex[k].id === id) file = _notesIndex[k];
            });
          }
          if (file) openChapterNotes(file);
        };
      }
    }).catch(function () { notesSlot.innerHTML = ""; });
    return card;
  }

  function resolveCorrectIndex(item,n){
    var c=item.correct;
    if(typeof c==="string"){ var map={A:0,B:1,C:2,D:3,a:0,b:1,c:2,d:3}; if(map[c.trim()]!==undefined) c=map[c.trim()]; else c=parseInt(c,10); }
    if(typeof c==="number"&&c>=1&&c<=n&&c>n-1) c=c-1;
    return c;
  }
  function hasValidCorrect(item,n){
    var c=item&&item.correct; if(c===null||c===undefined||c==="") return false;
    if(typeof c==="number") return (c>=0&&c<n)||(c>=1&&c<=n);
    if(typeof c==="string"){ var map={A:1,B:1,C:1,D:1,a:1,b:1,c:1,d:1}; return !!map[c.trim()]||/^\d+$/.test(c.trim()); }
    return false;
  }
  function selectOption(qIndex,selected,item){
    var sid=domId(qIndex);
    var options=document.querySelectorAll("#options-"+sid+" .option");
    var n=options.length, ans=$("answered-"+sid);
    if(!hasValidCorrect(item,n)){
      options.forEach(function(opt,i){ opt.classList.add("disabled"); if(i===selected) opt.classList.add("correct"); });
      if(ans) ans.textContent="Community poll mode";
      return;
    }
    var correct=resolveCorrectIndex(item,n);
    var isCorrect=selected===correct;
    options.forEach(function(opt,i){
      opt.classList.add("disabled");
      if(i===correct) opt.classList.add("correct");
      if(i===selected&&!isCorrect) opt.classList.add("wrong");
    });
    if(ans) ans.textContent=isCorrect?"Correct ✓":"Wrong ✗ · added to revision";
    recordAnswer(item,isCorrect);
  }

  function renderOneLiner(item,index){
    var card=document.createElement("div"); card.className="card";
    var id=item.id||("ol_"+index);
    var qText=userPreferredLang==="hi"&&item.question_hi?item.question_hi:item.question;
    var aText=userPreferredLang==="hi"&&item.answer_hi?item.answer_hi:item.answer;
    card.innerHTML='<div class="tag tag-oneliner">One-liner</div><div class="q">'+escapeHTML(qText)+"</div>"+
      '<input class="ol-input" id="ol-inp-'+domId(id)+'" type="text" placeholder="Type answer…">'+
      '<div class="ol-actions"><button type="button" class="ol-btn primary" data-act="check">Check</button>'+
      '<button type="button" class="ol-btn" data-act="show">Show</button></div>'+
      '<div class="ol-ans" id="ol-res-'+domId(id)+'"></div>';
    function match(u,c){ u=normKey(u).replace(/^(the|a|an)\s+/,""); c=normKey(c).replace(/^(the|a|an)\s+/,""); if(!u||!c) return false; if(u===c) return true; return c.length<=28&&(c.indexOf(u)>=0||u.indexOf(c)>=0); }
    card.querySelector('[data-act="check"]').onclick=function(){
      var val=($("ol-inp-"+domId(id)).value||"").trim();
      var box=$("ol-res-"+domId(id));
      var ok=match(val,aText)||match(val,item.answer);
      box.className="ol-ans show "+(ok?"ok":"bad");
      box.innerHTML=ok?("✓ "+escapeHTML(aText)):"✗ Try again";
    };
    card.querySelector('[data-act="show"]').onclick=function(){
      var box=$("ol-res-"+domId(id)); box.className="ol-ans show"; box.innerHTML="<b>Answer:</b> "+escapeHTML(aText);
    };
    return card;
  }

  function renderPost(post){
