<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>MCQ Practice</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      background: #f0f2f5;
      color: #050505;
      height: 100vh;
      overflow: hidden;
    }
    .page { display: none; height: 100vh; flex-direction: column; }
    .page.active { display: flex; }

    #feedPage { background: #f0f2f5; }
    .feed {
      flex: 1;
      overflow-y: auto;
      padding: 12px 12px 80px;
      -webkit-overflow-scrolling: touch;
    }
    .post-card {
      background: white;
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 12px;
      box-shadow: 0 1px 2px rgba(0,0,0,0.08);
    }
    .post-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }
    .avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #e4e6eb;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      color: #65676b;
      font-size: 0.9rem;
    }
    .channel-info h3 { font-size: 0.95rem; font-weight: 600; }
    .channel-info p { font-size: 0.78rem; color: #65676b; }
    .question-text {
      font-size: 1.05rem;
      line-height: 1.45;
      margin-bottom: 14px;
      font-weight: 500;
    }
    .options { display: flex; flex-direction: column; gap: 8px; }
    .option {
      border: 1.5px solid #ccd0d5;
      border-radius: 8px;
      padding: 12px 14px;
      font-size: 0.95rem;
      cursor: pointer;
      background: white;
      word-break: break-word;
    }
    .option:active { background: #f0f2f5; }
    .option.correct {
      background: #e7f6ec;
      border-color: #31a24c;
      color: #31a24c;
      font-weight: 600;
    }
    .option.wrong {
      background: #fde8e8;
      border-color: #e41e3f;
      color: #e41e3f;
    }
    .option.disabled { pointer-events: none; }
    .post-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px solid #e4e6eb;
    }
    .answered { font-size: 0.82rem; color: #65676b; }
    .actions { display: flex; gap: 18px; }
    .action-btn {
      background: none;
      border: none;
      font-size: 1.25rem;
      cursor: pointer;
      color: #65676b;
    }
    .action-btn.liked { color: #e41e3f; }
    .action-btn.saved { color: #1877f2; }

    .page-header {
      background: white;
      padding: 16px;
      font-size: 1.15rem;
      font-weight: 700;
      border-bottom: 1px solid #e4e6eb;
      position: sticky;
      top: 0;
      z-index: 10;
    }
    #savedPage, #analysisPage {
      background: #f0f2f5;
      overflow-y: auto;
      padding-bottom: 80px;
    }
    .saved-item {
      background: white;
      margin: 10px 12px;
      padding: 14px;
      border-radius: 10px;
    }
    .saved-q { font-size: 0.95rem; font-weight: 500; margin-bottom: 6px; }
    .saved-meta { font-size: 0.78rem; color: #65676b; }
    .stats-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      padding: 14px;
    }
    .stat-card {
      background: white;
      border-radius: 12px;
      padding: 16px;
      text-align: center;
    }
    .stat-value {
      font-size: 1.5rem;
      font-weight: 700;
      color: #1877f2;
    }
    .stat-label {
      font-size: 0.78rem;
      color: #65676b;
      margin-top: 2px;
    }
    .section {
      background: white;
      margin: 10px 12px;
      padding: 16px;
      border-radius: 12px;
    }
    .section-title {
      font-size: 0.95rem;
      font-weight: 600;
      margin-bottom: 12px;
    }
    .subject-row { margin-bottom: 10px; }
    .subject-name {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      margin-bottom: 4px;
    }
    .bar-bg {
      height: 8px;
      background: #e4e6eb;
      border-radius: 10px;
      overflow: hidden;
    }
    .bar-fill {
      height: 100%;
      background: #1877f2;
      border-radius: 10px;
    }
    .empty {
      text-align: center;
      padding: 50px 20px;
      color: #65676b;
    }
    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 60px;
      background: white;
      display: flex;
      border-top: 1px solid #e4e6eb;
      z-index: 100;
    }
    .nav-item {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-size: 0.7rem;
      color: #65676b;
      gap: 2px;
      cursor: pointer;
    }
    .nav-item.active { color: #1877f2; font-weight: 600; }
    .nav-item span { font-size: 1.25rem; }
    .loading {
      text-align: center;
      padding: 40px;
      color: #65676b;
    }
  </style>
</head>
<body>

  <!-- FEED -->
  <div id="feedPage" class="page active">
    <div class="feed" id="feed">
      <div class="loading">Loading questions...</div>
    </div>
  </div>

  <!-- SAVED -->
  <div id="savedPage" class="page">
    <div class="page-header">Saved Questions</div>
    <div id="savedList"></div>
  </div>

  <!-- ANALYSIS -->
  <div id="analysisPage" class="page">
    <div class="page-header">Your Analysis</div>
    
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-value" id="totalAttempted">0</div>
        <div class="stat-label">Attempted</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="successRate">0%</div>
        <div class="stat-label">Success Rate</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="streak">0</div>
        <div class="stat-label">Day Streak</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="savedCount">0</div>
        <div class="stat-label">Saved</div>
      </div>
    </div>

    <div class="section">
      <div class="section-title">Subject Interest</div>
      <div id="subjectInterest"></div>
    </div>

    <div class="section">
      <div class="section-title">Strongest Subject</div>
      <div id="strongestSubject" style="font-size:1.1rem; font-weight:600; color:#31a24c;">—</div>
    </div>
  </div>

  <!-- Bottom Navigation -->
  <div class="bottom-nav">
    <div class="nav-item active" id="nav-feed" onclick="showPage('feed')">
      <span>🏠</span>
      Practice
    </div>
    <div class="nav-item" id="nav-saved" onclick="showPage('saved')">
      <span>🔖</span>
      Saved
    </div>
    <div class="nav-item" id="nav-analysis" onclick="showPage('analysis')">
      <span>📊</span>
      Analysis
    </div>
  </div>

  <script>
    const API_URL = "https://script.google.com/macros/s/AKfycbyICNHxGGgvd7TBcgSxjQm3obJqDOGtHHiwiwUoXnxiNurmqmWDfwOXo5x9rfQqnXs/exec";
    let allQuestions = [];

    // ========== LOCAL STORAGE HELPERS ==========
    function getData(key) {
      try {
        return JSON.parse(localStorage.getItem(key) || "[]");
      } catch (e) {
        return [];
      }
    }

    function setData(key, data) {
      localStorage.setItem(key, JSON.stringify(data));
    }

    function getStats() {
      try {
        return JSON.parse(localStorage.getItem("mcq_stats") || '{"attempted":0,"correct":0,"streak":0,"lastDate":"","subjects":{}}');
      } catch (e) {
        return {attempted:0, correct:0, streak:0, lastDate:"", subjects:{}};
      }
    }

    function saveStats(stats) {
      localStorage.setItem("mcq_stats", JSON.stringify(stats));
    }

    // ========== LOAD QUESTIONS ==========
    async function loadQuestions() {
      const feed = document.getElementById("feed");
      feed.innerHTML = `<div class="loading">Loading questions...</div>`;

      try {
        const res = await fetch(API_URL);
        const data = await res.json();

        if (!Array.isArray(data) || data.length === 0) {
          throw new Error("No questions received");
        }

        allQuestions = data;
        renderFeed();
      } catch (err) {
        console.error(err);
        feed.innerHTML = `<div class="loading">Failed to load questions.<br><small>${err.message}</small></div>`;
      }
    }

    // ========== RENDER FEED ==========
    function renderFeed() {
      const feed = document.getElementById("feed");
      feed.innerHTML = "";

      if (!allQuestions.length) {
        feed.innerHTML = `<div class="loading">No questions found</div>`;
        return;
      }

      allQuestions.forEach((item, index) => {
        const card = document.createElement("div");
        card.className = "post-card";

        // Header
        const header = document.createElement("div");
        header.className = "post-header";
        header.innerHTML = `
          <div class="avatar">${(item.username || "E").charAt(0)}</div>
          <div class="channel-info">
            <h3>${item.username || "Educator"}</h3>
            <p>${item.subject || "General"} • ${item.difficulty || "Medium"}</p>
          </div>
        `;
        card.appendChild(header);

        // Question
        const qDiv = document.createElement("div");
        qDiv.className = "question-text";
        qDiv.textContent = item.q || "";
        card.appendChild(qDiv);

        // Options
        const optionsDiv = document.createElement("div");
        optionsDiv.className = "options";
        optionsDiv.id = "options-" + index;

        (item.options || []).forEach((opt, i) => {
          const optDiv = document.createElement("div");
          optDiv.className = "option";
          optDiv.textContent = opt || "—";
          optDiv.onclick = () => selectOption(index, i);
          optionsDiv.appendChild(optDiv);
        });
        card.appendChild(optionsDiv);

        // Footer
        const footer = document.createElement("div");
        footer.className = "post-footer";

        const answered = document.createElement("div");
        answered.className = "answered";
        answered.textContent = "Tap option to answer";
        footer.appendChild(answered);

        const actions = document.createElement("div");
        actions.className = "actions";

        const likeBtn = document.createElement("button");
        likeBtn.className = "action-btn";
        likeBtn.textContent = "👍";
        likeBtn.onclick = () => toggleLike(item.uid, likeBtn);
        actions.appendChild(likeBtn);

        const saveBtn = document.createElement("button");
        saveBtn.className = "action-btn";
        saveBtn.textContent = "🔖";
        saveBtn.onclick = () => toggleSave(index, saveBtn);
        actions.appendChild(saveBtn);

        footer.appendChild(actions);
        card.appendChild(footer);

        feed.appendChild(card);
      });
    }

    // ========== SELECT OPTION ==========
    function selectOption(qIndex, selected) {
      const item = allQuestions[qIndex];
      const options = document.querySelectorAll("#options-" + qIndex + " .option");

      options.forEach((opt, i) => {
        opt.classList.add("disabled");
        if (i === item.correct) opt.classList.add("correct");
        if (i === selected && selected !== item.correct) opt.classList.add("wrong");
      });

      // Save to local analysis
      const stats = getStats();
      stats.attempted = (stats.attempted || 0) + 1;
      if (selected === item.correct) {
        stats.correct = (stats.correct || 0) + 1;
      }

      const subject = item.subject || "General";
      if (!stats.subjects) stats.subjects = {};
      if (!stats.subjects[subject]) {
        stats.subjects[subject] = { attempted: 0, correct: 0 };
      }
      stats.subjects[subject].attempted++;
      if (selected === item.correct) {
        stats.subjects[subject].correct++;
      }

      // Streak
      const today = new Date().toDateString();
      if (stats.lastDate !== today) {
        const yesterday = new Date();
        yesterday.setDate(yesterday.getDate() - 1);
        if (stats.lastDate === yesterday.toDateString()) {
          stats.streak = (stats.streak || 0) + 1;
        } else {
          stats.streak = 1;
        }
        stats.lastDate = today;
      }

      saveStats(stats);
    }

    // ========== LIKE ==========
    function toggleLike(uid, btn) {
      let likes = getData("mcq_likes");
      if (likes.includes(uid)) {
        likes = likes.filter(id => id !== uid);
        btn.classList.remove("liked");
      } else {
        likes.push(uid);
        btn.classList.add("liked");
      }
      setData("mcq_likes", likes);
    }

    // ========== SAVE ==========
    function toggleSave(qIndex, btn) {
      let saved = getData("mcq_saved");
      const item = allQuestions[qIndex];

      const exists = saved.find(s => s.uid === item.uid);
      if (exists) {
        saved = saved.filter(s => s.uid !== item.uid);
        btn.classList.remove("saved");
      } else {
        saved.push({
          q: item.q,
          subject: item.subject,
          difficulty: item.difficulty,
          uid: item.uid,
          username: item.username
        });
        btn.classList.add("saved");
      }
      setData("mcq_saved", saved);
    }

    // ========== PAGE SWITCH ==========
    function showPage(page) {
      // Hide all pages
      document.getElementById("feedPage").classList.remove("active");
      document.getElementById("savedPage").classList.remove("active");
      document.getElementById("analysisPage").classList.remove("active");

      // Remove active from nav
      document.getElementById("nav-feed").classList.remove("active");
      document.getElementById("nav-saved").classList.remove("active");
      document.getElementById("nav-analysis").classList.remove("active");

      if (page === "feed") {
        document.getElementById("feedPage").classList.add("active");
        document.getElementById("nav-feed").classList.add("active");
      } 
      else if (page === "saved") {
        document.getElementById("savedPage").classList.add("active");
        document.getElementById("nav-saved").classList.add("active");
        renderSaved();
      } 
      else if (page === "analysis") {
        document.getElementById("analysisPage").classList.add("active");
        document.getElementById("nav-analysis").classList.add("active");
        renderAnalysis();
      }
    }

    // ========== RENDER SAVED ==========
    function renderSaved() {
      const list = document.getElementById("savedList");
      const saved = getData("mcq_saved");

      if (!saved || saved.length === 0) {
        list.innerHTML = `<div class="empty">No saved questions yet<br><small>Bookmark questions from Practice tab</small></div>`;
        return;
      }

      list.innerHTML = "";
      saved.forEach(item => {
        const div = document.createElement("div");
        div.className = "saved-item";
        div.innerHTML = `
          <div class="saved-q">${item.q || ""}</div>
          <div class="saved-meta">${item.subject || ""} • ${item.difficulty || ""}</div>
        `;
        list.appendChild(div);
      });
    }

    // ========== RENDER ANALYSIS ==========
    function renderAnalysis() {
      const stats = getStats();
      const saved = getData("mcq_saved");

      document.getElementById("totalAttempted").textContent = stats.attempted || 0;
      
      const rate = stats.attempted ? Math.round((stats.correct / stats.attempted) * 100) : 0;
      document.getElementById("successRate").textContent = rate + "%";
      
      document.getElementById("streak").textContent = stats.streak || 0;
      document.getElementById("savedCount").textContent = saved.length || 0;

      // Subject Interest
      const container = document.getElementById("subjectInterest");
      const subjects = stats.subjects || {};
      const entries = Object.entries(subjects);

      if (entries.length === 0) {
        container.innerHTML = `<div style="color:#65676b; font-size:0.9rem;">Attempt some questions to see interest analysis</div>`;
        document.getElementById("strongestSubject").textContent = "—";
        return;
      }

      // Sort by most attempted
      entries.sort((a, b) => b[1].attempted - a[1].attempted);
      const max = entries[0][1].attempted;

      container.innerHTML = "";
      entries.forEach(([name, data]) => {
        const percent = Math.round((data.attempted / max) * 100);
        const accuracy = data.attempted ? Math.round((data.correct / data.attempted) * 100) : 0;

        const row = document.createElement("div");
        row.className = "subject-row";
        row.innerHTML = `
          <div class="subject-name">
            <span>${name}</span>
            <span>${accuracy}% accuracy</span>
          </div>
          <div class="bar-bg">
            <div class="bar-fill" style="width:${percent}%"></div>
          </div>
        `;
        container.appendChild(row);
      });

      // Strongest subject
      let strongest = "—";
      let bestAcc = -1;
      entries.forEach(([name, data]) => {
        if (data.attempted >= 2) {
          const acc = data.correct / data.attempted;
          if (acc > bestAcc) {
            bestAcc = acc;
            strongest = name;
          }
        }
      });
      document.getElementById("strongestSubject").textContent = strongest;
    }

    // Start
    loadQuestions();
  </script>
</body>
</html>
