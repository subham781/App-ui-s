<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>PrepExam</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden}
body{
  font-family:Inter,system-ui,sans-serif;
  background:#f4f6fb;color:#0f172a;
  display:flex;flex-direction:column;height:100%;user-select:none;
}
.top{padding:18px 18px 8px;text-align:center}
.logo{display:inline-flex;align-items:center;gap:8px;font-weight:800;font-size:1.05rem;color:#1e3a8a}
.logo i{
  width:28px;height:28px;border-radius:8px;
  background:linear-gradient(135deg,#3b82f6,#6366f1);
  color:#fff;font-style:normal;font-size:.75rem;font-weight:800;
  display:flex;align-items:center;justify-content:center;
}
.sub{margin-top:6px;font-size:.8rem;color:#64748b;font-weight:500}
.scroll{flex:1;overflow-y:auto;padding:8px 14px 110px;-webkit-overflow-scrolling:touch}
.card{
  background:#fff;border:1px solid #e8ecf4;border-radius:16px;
  padding:14px;margin-bottom:12px;box-shadow:0 4px 14px rgba(15,23,42,.04);
}
.q-meta{font-size:.72rem;font-weight:600;color:#6366f1;margin-bottom:8px;text-transform:uppercase;letter-spacing:.3px}
.q-text{font-size:.95rem;font-weight:600;line-height:1.45;margin-bottom:12px}
.opt{
  border:1.5px solid #e2e8f0;border-radius:10px;padding:10px 12px;
  font-size:.88rem;margin-bottom:8px;background:#fafbfc;cursor:pointer;
}
.opt:last-child{margin-bottom:0}
.opt.correct{border-color:#22c55e;background:#f0fdf4;color:#15803d;font-weight:600}
.opt.wrong{border-color:#f87171;background:#fef2f2;color:#b91c1c}
.opt.disabled{pointer-events:none}
.foot{margin-top:10px;font-size:.75rem;color:#64748b;min-height:18px}
.loading,.error{text-align:center;padding:40px 16px;color:#64748b;font-size:.9rem}
.error{color:#b91c1c}
.retry{margin-top:12px;border:0;background:#2563eb;color:#fff;padding:10px 16px;border-radius:10px;font-weight:700}
.bottom{
  position:fixed;left:0;right:0;bottom:0;padding:12px 16px 22px;
  background:linear-gradient(180deg,transparent,#f4f6fb 28%);z-index:10;
}
.btn{
  width:100%;border:0;border-radius:14px;padding:15px;font-size:.95rem;font-weight:700;
  color:#fff;background:linear-gradient(135deg,#2563eb,#4f46e5);
  box-shadow:0 10px 24px rgba(37,99,235,.28);
}
.hint{text-align:center;margin-top:10px;font-size:.72rem;color:#94a3b8;font-weight:500}
body.leaving{opacity:0;transition:opacity .35s}
</style>
</head>
<body>

<div class="top">
  <div class="logo"><i>PE</i> PrepExam</div>
  <div class="sub">2 live GK questions · then full app</div>
</div>

<div class="scroll" id="feed">
  <div class="loading">Loading questions...</div>
</div>

<div class="bottom">
  <button class="btn" type="button" id="goBtn">Explore more questions & features →</button>
  <div class="hint">or swipe right to continue</div>
</div>

<script>
(function () {
  var OPEN_STRING = "OPEN_HOME";

  // Open Trivia DB — free public API (no key)
  // Categories mix: 9=GK, 22=Geography, 23=History, 17=Science (exam-like)
  var API =
    "https://opentdb.com/api.php?amount=2&type=multiple&difficulty=medium";

  function decodeHTML(str) {
    var t = document.createElement("textarea");
    t.innerHTML = str;
    return t.value;
  }

  function shuffle(arr) {
    var a = arr.slice();
    for (var i = a.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
    }
    return a;
  }

  function escapeHTML(v) {
    return String(v || "")
      .replace(/&/g, "&amp;").replace(/</g, "&lt;")
      .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }

  function loadQuestions() {
    var feed = document.getElementById("feed");
    feed.innerHTML = '<div class="loading">Loading questions...</div>';

    // prefer exam-relevant categories randomly
    var cats = [9, 22, 23, 17]; // GK, Geo, History, Science
    var cat = cats[Math.floor(Math.random() * cats.length)];
    var url = API + "&category=" + cat + "&t=" + Date.now();

    fetch(url)
      .then(function (r) {
        if (!r.ok) throw new Error("HTTP " + r.status);
        return r.json();
      })
      .then(function (data) {
        if (!data || data.response_code !== 0 || !data.results || !data.results.length) {
          throw new Error("No questions from API");
        }
        render(data.results);
      })
      .catch(function (e) {
        feed.innerHTML =
          '<div class="error">Could not load questions<br><small>' +
          escapeHTML(e.message) +
          '</small><br><button class="retry" type="button" id="retryBtn">Retry</button></div>';
        var b = document.getElementById("retryBtn");
        if (b) b.onclick = loadQuestions;
      });
  }

  function render(list) {
    var feed = document.getElementById("feed");
    feed.innerHTML = "";

    list.slice(0, 2).forEach(function (item, qIndex) {
      var question = decodeHTML(item.question);
      var correct = decodeHTML(item.correct_answer);
      var options = shuffle(
        [correct].concat(item.incorrect_answers.map(decodeHTML))
      );
      var correctIndex = options.indexOf(correct);
      var cat = decodeHTML(item.category || "General Knowledge");

      var card = document.createElement("div");
      card.className = "card";
      card.id = "c" + qIndex;

      var html =
        '<div class="q-meta">Sample · ' + escapeHTML(cat) + '</div>' +
        '<div class="q-text">' + escapeHTML(question) + '</div>';

      options.forEach(function (opt, i) {
        html +=
          '<div class="opt" data-q="' + qIndex + '" data-i="' + i + '" data-correct="' + correctIndex + '">' +
          escapeHTML(opt) +
          "</div>";
      });

      html += '<div class="foot" id="f' + qIndex + '">Tap an option</div>';
      card.innerHTML = html;
      feed.appendChild(card);
    });

    document.querySelectorAll(".opt").forEach(function (el) {
      el.onclick = function () {
        var q = +el.getAttribute("data-q");
        var i = +el.getAttribute("data-i");
        var correctIndex = +el.getAttribute("data-correct");
        var card = document.getElementById("c" + q);
        var opts = card.querySelectorAll(".opt");

        opts.forEach(function (o) {
          o.classList.add("disabled");
          var oi = +o.getAttribute("data-i");
          if (oi === correctIndex) o.classList.add("correct");
          if (oi === i && i !== correctIndex) o.classList.add("wrong");
        });

        document.getElementById("f" + q).textContent =
          i === correctIndex
            ? "Correct ✓"
            : "Wrong ✗ · more practice inside the app";
      };
    });
  }

  function openApp() {
    try {
      if (window.AppInventor && window.AppInventor.getWebViewString !== undefined) {
        window.AppInventor.setWebViewString(OPEN_STRING);
      }
    } catch (e) {}
    document.body.classList.add("leaving");
  }

  document.getElementById("goBtn").onclick = openApp;

  var startX = 0, tracking = false;
  document.body.addEventListener("touchstart", function (e) {
    tracking = true;
    startX = e.touches[0].clientX;
  }, { passive: true });
  document.body.addEventListener("touchmove", function (e) {
    if (!tracking) return;
    if (e.touches[0].clientX - startX > 80) {
      tracking = false;
      openApp();
    }
  }, { passive: true });
  document.body.addEventListener("touchend", function () { tracking = false; });

  loadQuestions();
})();
</script>
</body>
</html>
