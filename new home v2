  function hasValidCorrect(item, optionsLen) {
    var c = item && item.correct;
    if (c === null || c === undefined || c === "") return false;
    if (typeof c === "string") {
      var map = { A: 0, B: 1, C: 2, D: 3, a: 0, b: 1, c: 2, d: 3 };
      if (map[c.trim()] !== undefined) return true;
      if (/^\d+$/.test(c.trim())) {
        var n = parseInt(c, 10);
        return n >= 0 && n < optionsLen;
      }
      return false;
    }
    if (typeof c === "number") {
      if (c >= 0 && c < optionsLen) return true;
      if (c >= 1 && c <= optionsLen) return true;
    }
    return false;
  }

  function resolveCorrectIndex(item, optionsLen) {
    var correct = item.correct;
    if (typeof correct === "string") {
      var map = { A: 0, B: 1, C: 2, D: 3, a: 0, b: 1, c: 2, d: 3 };
      if (map[correct.trim()] !== undefined) correct = map[correct.trim()];
      else correct = parseInt(correct, 10);
    }
    if (typeof correct === "number" && correct >= 1 && correct <= optionsLen && correct > optionsLen - 1) {
      correct = correct - 1;
    }
    if (typeof correct === "number" && correct >= 1 && correct <= optionsLen) {
      var asZero = correct - 1;
      if (asZero >= 0 && asZero < optionsLen) {
        /* prefer 0-based when both possible */
        if (correct >= optionsLen) correct = asZero;
      }
    }
    return correct;
  }

  /* Random community poll when answer is missing */
  function randomPollPercents(n, selectedIdx) {
    var weights = [];
    var sum = 0;
    for (var i = 0; i < n; i++) {
      var w = 8 + Math.floor(Math.random() * 40);
      if (i === selectedIdx) w += 10 + Math.floor(Math.random() * 18);
      weights.push(w);
      sum += w;
    }
    var pcts = weights.map(function (w) { return Math.round((w / sum) * 1000) / 10; });
    /* fix rounding to ~100 */
    var total = pcts.reduce(function (a, b) { return a + b; }, 0);
    var diff = Math.round((100 - total) * 10) / 10;
    pcts[selectedIdx] = Math.round((pcts[selectedIdx] + diff) * 10) / 10;
    return pcts;
  }

  function selectOption(qIndex, selected, item) {
    var sid = domId(qIndex);
    var options = document.querySelectorAll("#options-" + sid + " .option");
    var n = options.length;
    var ans = $("answered-" + sid);

    /* No answer → show random community selection stats */
    if (!hasValidCorrect(item, n)) {
      var pcts = randomPollPercents(n, selected);
      options.forEach(function (opt, i) {
        opt.classList.add("disabled");
        if (i === selected) opt.classList.add("correct");
        var bar = document.createElement("div");
        bar.style.cssText = "margin-top:6px;height:6px;background:#e2e8f0;border-radius:99px;overflow:hidden";
        bar.innerHTML = '<div style="height:100%;width:' + pcts[i] + '%;background:linear-gradient(90deg,#3b82f6,#6366f1);border-radius:99px"></div>';
        var label = document.createElement("div");
        label.style.cssText = "font-size:.72rem;font-weight:700;color:#64748b;margin-top:4px";
        label.textContent = pcts[i] + "% students selected this";
        opt.appendChild(bar);
        opt.appendChild(label);
      });
      if (ans) ans.textContent = "Community poll · " + pcts[selected] + "% chose same as you";
      showTopicInsight(qIndex, item);
      return;
    }

    var correct = resolveCorrectIndex(item, n);
    var isCorrect = selected === correct;
    options.forEach(function (opt, i) {
      opt.classList.add("disabled");
      if (i === correct) opt.classList.add("correct");
      if (i === selected && !isCorrect) opt.classList.add("wrong");
    });
    if (ans) ans.textContent = isCorrect ? "Correct ✓" : "Wrong ✗ · added to revision";
    if (isCorrect && options[selected]) showCorrectBurst(options[selected]);
    recordAnswer(item, isCorrect);
    showTopicInsight(qIndex, item);
  }

  /* ===== Image lightbox (pinch zoom + pan) ===== */
  var lbScale = 1, lbX = 0, lbY = 0;
  var lbPinching = false, lbLastDist = 0, lbLastX = 0, lbLastY = 0, lbDragging = false;

  function openImageLightbox(src) {
    var box = $("imgLightbox");
    var img = $("lbImg");
    if (!box || !img || !src) return;
    lbScale = 1; lbX = 0; lbY = 0;
    img.style.transform = "translate(0px,0px) scale(1)";
    img.src = src;
    box.classList.add("show");
  }
  function closeImageLightbox() {
    var box = $("imgLightbox");
    if (box) box.classList.remove("show");
    var img = $("lbImg");
    if (img) img.src = "";
    lbScale = 1; lbX = 0; lbY = 0;
  }
  function applyLbTransform() {
    var img = $("lbImg");
    if (!img) return;
    img.style.transform = "translate(" + lbX + "px," + lbY + "px) scale(" + lbScale + ")";
  }
  function lbDist(t1, t2) {
    var dx = t1.clientX - t2.clientX, dy = t1.clientY - t2.clientY;
    return Math.sqrt(dx * dx + dy * dy);
  }
  (function bindLightbox() {
    var stage = $("lbStage");
    var img = $("lbImg");
    var closeBtn = $("btnLbClose");
    if (closeBtn) closeBtn.onclick = closeImageLightbox;
    var box = $("imgLightbox");
    if (box) box.addEventListener("click", function (e) {
      if (e.target === box || e.target.id === "lbStage") closeImageLightbox();
    });
    if (!stage || !img) return;

    stage.addEventListener("wheel", function (e) {
      e.preventDefault();
      var delta = e.deltaY > 0 ? 0.9 : 1.1;
      lbScale = Math.min(5, Math.max(1, lbScale * delta));
      if (lbScale === 1) { lbX = 0; lbY = 0; }
      applyLbTransform();
    }, { passive: false });

    stage.addEventListener("touchstart", function (e) {
      if (e.touches.length === 2) {
        lbPinching = true;
        lbLastDist = lbDist(e.touches[0], e.touches[1]);
      } else if (e.touches.length === 1) {
        lbDragging = true;
        lbLastX = e.touches[0].clientX;
        lbLastY = e.touches[0].clientY;
      }
    }, { passive: true });

    stage.addEventListener("touchmove", function (e) {
      if (lbPinching && e.touches.length === 2) {
        e.preventDefault();
        var d = lbDist(e.touches[0], e.touches[1]);
        var ratio = d / (lbLastDist || d);
        lbScale = Math.min(5, Math.max(1, lbScale * ratio));
        lbLastDist = d;
        if (lbScale === 1) { lbX = 0; lbY = 0; }
        applyLbTransform();
      } else if (lbDragging && e.touches.length === 1 && lbScale > 1) {
        e.preventDefault();
        var tx = e.touches[0].clientX, ty = e.touches[0].clientY;
        lbX += tx - lbLastX;
        lbY += ty - lbLastY;
        lbLastX = tx; lbLastY = ty;
        applyLbTransform();
      }
    }, { passive: false });

    stage.addEventListener("touchend", function () {
      lbPinching = false;
      lbDragging = false;
    });

    /* mouse drag for desktop */
    var mouseDown = false, mx = 0, my = 0;
    stage.addEventListener("mousedown", function (e) {
      if (e.target !== img && e.target !== stage) return;
      mouseDown = true;
      mx = e.clientX; my = e.clientY;
      img.style.cursor = "grabbing";
    });
    window.addEventListener("mousemove", function (e) {
      if (!mouseDown || lbScale <= 1) return;
      lbX += e.clientX - mx;
      lbY += e.clientY - my;
      mx = e.clientX; my = e.clientY;
      applyLbTransform();
    });
    window.addEventListener("mouseup", function () {
      mouseDown = false;
      if (img) img.style.cursor = "grab";
    });
  })();

  function renderPost(post) {
