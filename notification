<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Notifications</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
body{
  background:#eef2f7;
  color:#0f172a;
  font-family:Inter,system-ui,sans-serif;
  min-height:100vh;
}
.app{max-width:640px;margin:0 auto;padding:16px 14px 40px}

.header{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:16px;gap:12px
}
.header h1{font-size:1.25rem;font-weight:800;letter-spacing:-.3px}
.header p{font-size:.78rem;color:#64748b;margin-top:2px}
.refresh{
  width:42px;height:42px;border:0;border-radius:14px;
  background:#fff;color:#334155;font-size:18px;
  border:1px solid #e2e8f0;
  box-shadow:0 2px 10px rgba(15,23,42,.05)
}
.refresh:active{transform:scale(.94)}

.notification{
  background:#fff;
  border:1px solid #e8ecf4;
  border-radius:18px;
  padding:16px;
  margin-bottom:12px;
  cursor:pointer;
  box-shadow:0 4px 16px rgba(15,23,42,.04);
  transition:transform .15s,box-shadow .15s
}
.notification:active{transform:scale(.985);background:#f8fafc}
.notification.expired{opacity:.72}

.top-meta{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px}
.category{
  display:inline-flex;align-items:center;gap:6px;
  font-size:.68rem;font-weight:700;letter-spacing:.3px;text-transform:uppercase;
  color:#1d4ed8;background:#eff6ff;padding:5px 10px;border-radius:999px;
  border:1px solid #dbeafe
}
.badge-live{
  font-size:.65rem;font-weight:700;color:#047857;background:#ecfdf5;
  border:1px solid #a7f3d0;padding:4px 8px;border-radius:999px
}
.badge-expired{
  font-size:.65rem;font-weight:700;color:#b91c1c;background:#fef2f2;
  border:1px solid #fecaca;padding:4px 8px;border-radius:999px
}

.title{font-size:.98rem;font-weight:700;color:#0f172a;line-height:1.4}
.subtitle{margin-top:7px;font-size:.82rem;line-height:1.55;color:#64748b}

.date{
  margin-top:14px;padding-top:12px;border-top:1px solid #f1f5f9;
  display:flex;justify-content:space-between;align-items:center;
  font-size:.72rem;color:#94a3b8;font-weight:500
}
.time{color:#2563eb;font-weight:700}

.loading,.empty{text-align:center;padding:56px 20px;color:#64748b;font-size:.9rem}
.spinner{
  width:30px;height:30px;margin:0 auto 14px;
  border:3px solid #e2e8f0;border-top-color:#2563eb;border-radius:50%;
  animation:spin .75s linear infinite
}
@keyframes spin{to{transform:rotate(360deg)}}
.empty-ico{
  width:56px;height:56px;margin:0 auto 12px;border-radius:18px;
  background:linear-gradient(135deg,#dbeafe,#e0e7ff);
  display:flex;align-items:center;justify-content:center;font-size:22px
}
.error{
  background:#fef2f2;border:1px solid #fecaca;border-radius:16px;
  padding:14px;color:#991b1b;font-size:.82rem;line-height:1.5
}

.toast{
  position:fixed;bottom:28px;left:50%;
  transform:translate(-50%,16px);
  background:#0f172a;color:#fff;padding:12px 16px;border-radius:14px;
  font-size:.8rem;font-weight:600;opacity:0;pointer-events:none;
  transition:.25s;z-index:100;box-shadow:0 10px 30px rgba(15,23,42,.25);
  max-width:90%
}
.toast.show{opacity:1;transform:translate(-50%,0)}
</style>
</head>
<body>
<div class="app">


  <div id="notificationList">
    <div class="loading">
      <div class="spinner"></div>
      Loading notifications...
    </div>
  </div>
</div>

<div id="toast" class="toast">Notification selected</div>

<script>
const CSV_URL = "https://raw.githubusercontent.com/subham781/Formulas1/refs/heads/main/sdf";

document.addEventListener("DOMContentLoaded", loadNotifications);

async function loadNotifications(){
  const container = document.getElementById("notificationList");
  container.innerHTML = '<div class="loading"><div class="spinner"></div>Loading notifications...</div>';

  try{
    const response = await fetch(CSV_URL + (CSV_URL.indexOf("?") >= 0 ? "&" : "?") + "t=" + Date.now());
    if(!response.ok) throw new Error("HTTP Error: " + response.status);

    const csv = await response.text();
    if(!csv.trim()) throw new Error("CSV file is empty.");

    const rows = parseCSV(csv);
    if(rows.length < 2){
      showEmpty();
      return;
    }

    const headers = rows[0].map(function(h){ return String(h || "").trim().toLowerCase(); });

    var categoryIndex = findHeader(headers, ["category"]);
    var titleIndex = findHeader(headers, ["title"]);
    var subtitleIndex = findHeader(headers, ["subtitle", "description", "message"]);
    var dateIndex = findHeader(headers, ["offer end date", "end date", "date", "expiry"]);

    if(titleIndex === -1){
      throw new Error("CSV me Title column nahi mila.");
    }

    const notifications = [];

    for(var i = 1; i < rows.length; i++){
      var row = rows[i];
      if(!row || !row.length) continue;

      var category = categoryIndex >= 0 ? clean(row[categoryIndex]) : "";
      var title = clean(row[titleIndex]);
      var subtitle = subtitleIndex >= 0 ? clean(row[subtitleIndex]) : "";
      var endDate = dateIndex >= 0 ? clean(row[dateIndex]) : "";

      if(!title && !subtitle && !category) continue;

      var expired = false;
      if(endDate){
        var expiry = parseDate(endDate);
        if(expiry && expiry.getTime() <= Date.now()){
          expired = true;
        }
      }

      notifications.push({
        category: category || "Update",
        title: title,
        subtitle: subtitle,
        endDate: endDate,
        expired: expired
      });
    }

    notifications.sort(function(a, b){
      if(a.expired !== b.expired) return a.expired ? 1 : -1;
      var da = parseDate(a.endDate);
      var db = parseDate(b.endDate);
      if(da && db) return db.getTime() - da.getTime();
      return 0;
    });

    displayNotifications(notifications);
  }catch(error){
    console.error(error);
    container.innerHTML =
      '<div class="error"><b>Unable to load notifications.</b><br><br>' +
      escapeHTML(error.message) +
      '</div>';
  }
}

function findHeader(headers, names){
  for(var i = 0; i < names.length; i++){
    var idx = headers.indexOf(names[i]);
    if(idx !== -1) return idx;
  }
  return -1;
}

function clean(v){
  return String(v == null ? "" : v).trim();
}

function displayNotifications(notifications){
  const container = document.getElementById("notificationList");
  if(!notifications.length){
    showEmpty();
    return;
  }

  container.innerHTML = "";

  notifications.forEach(function(item){
    const card = document.createElement("div");
    card.className = "notification" + (item.expired ? " expired" : "");
    card.onclick = function(){ notificationClicked(item); };

    var status = item.expired
      ? '<span class="badge-expired">Expired</span>'
      : (item.endDate ? '<span class="badge-live">Active</span>' : "");

    var dateHTML = "";
    if(item.endDate){
      dateHTML =
        '<div class="date"><span>Offer ends</span><span class="time">' +
        escapeHTML(formatDate(item.endDate)) +
        '</span></div>';
    }

    card.innerHTML =
      '<div class="top-meta">' +
        '<div class="category">' + escapeHTML(item.category) + '</div>' +
        status +
      '</div>' +
      '<div class="title">' + escapeHTML(item.title) + '</div>' +
      (item.subtitle ? '<div class="subtitle">' + escapeHTML(item.subtitle) + '</div>' : '') +
      dateHTML;

    container.appendChild(card);
  });
}

function notificationClicked(item){
  var value = "NOTIFICATION|" + item.title + "|" + item.subtitle + "|" + item.category;
  sendToKodular(value);
  showToast(item.title || "Notification");
}

function sendToKodular(value){
  try{
    if(window.Kodular && typeof window.Kodular.setWebViewString === "function"){
      window.Kodular.setWebViewString(value);
    }
    if(window.AppInventor && typeof window.AppInventor.setWebViewString === "function"){
      window.AppInventor.setWebViewString(value);
    }
  }catch(e){}
}

function showEmpty(){
  document.getElementById("notificationList").innerHTML =
    '<div class="empty">' +
      '<div class="empty-ico">🔔</div>' +
      '<div style="font-weight:700;color:#334155;margin-bottom:4px">No notifications</div>' +
      '<div style="font-size:.8rem">New updates will appear here</div>' +
    '</div>';
}

function parseCSV(csv){
  const rows = [];
  let row = [];
  let field = "";
  let insideQuotes = false;

  for(let i = 0; i < csv.length; i++){
    const char = csv[i];
    const next = csv[i + 1];

    if(char === '"'){
      if(insideQuotes && next === '"'){
        field += '"';
        i++;
      }else{
        insideQuotes = !insideQuotes;
      }
    }else if(char === "," && !insideQuotes){
      row.push(field);
      field = "";
    }else if((char === "\n" || char === "\r") && !insideQuotes){
      if(char === "\r" && next === "\n") i++;
      row.push(field);
      rows.push(row);
      row = [];
      field = "";
    }else{
      field += char;
    }
  }

  if(field.length > 0 || row.length > 0){
    row.push(field);
    rows.push(row);
  }
  return rows;
}

function parseDate(value){
  if(!value) return null;
  var normalized = String(value).trim().replace(" ", "T");
  var date = new Date(normalized);
  if(isNaN(date.getTime())) return null;
  return date;
}

function formatDate(value){
  var date = parseDate(value);
  if(!date) return value;
  return date.toLocaleString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit"
  });
}

function escapeHTML(value){
  return String(value || "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

var toastTimer;
function showToast(text){
  var toast = document.getElementById("toast");
  toast.textContent = text;
  toast.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(function(){
    toast.classList.remove("show");
  }, 1800);
}
</script>
</body>
</html>