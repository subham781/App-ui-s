  /* ===== Chapter notes from Drive (auto below MCQ) ===== */
  function normNotesKey(str) {
    return String(str || "")
      .toLowerCase()
      .replace(/\.html?$/i, "")
      .replace(/[^a-z0-9\u0900-\u097f]+/g, " ")
      .replace(/\s+/g, " ")
      .trim();
  }
  async function loadNotesIndex(force) {
    if (!force && _notesIndex && (Date.now() - _notesIndexAt) < NOTES_CACHE_TTL_MS) return _notesIndex;
    _notesIndex = {};
    var keyOk = DRIVE_API_KEY && String(DRIVE_API_KEY).indexOf("YOUR_") < 0;
    var folder = DRIVE_NOTES_FOLDER_ID && String(DRIVE_NOTES_FOLDER_ID).indexOf("YOUR_") < 0
      ? DRIVE_NOTES_FOLDER_ID
      : (DRIVE_FOLDER_ID && String(DRIVE_FOLDER_ID).indexOf("YOUR_") < 0 ? DRIVE_FOLDER_ID : "");
    if (!keyOk || !folder) return _notesIndex;
    try {
      var q = encodeURIComponent("'" + folder + "' in parents and trashed=false");
      var url = "https://www.googleapis.com/drive/v3/files?q=" + q +
        "&fields=files(id,name,mimeType,webViewLink)&pageSize=1000&key=" + encodeURIComponent(DRIVE_API_KEY);
      var res = await fetch(url);
      if (!res.ok) throw new Error("notes list " + res.status);
      var data = await res.json();
      (data.files || []).forEach(function (f) {
        var n = normNotesKey(f.name);
        if (!n) return;
        var isHtml = /\.html?$/i.test(f.name) || (f.mimeType || "").indexOf("html") >= 0;
        if (!_notesIndex[n] || isHtml) {
          _notesIndex[n] = { id: f.id, name: f.name, mimeType: f.mimeType || "", webViewLink: f.webViewLink || "", isHtml: isHtml };
        }
      });
      _notesIndexAt = Date.now();
      console.log("[notes] files", Object.keys(_notesIndex).length);
    } catch (e) { console.warn("[notes]", e); }
    return _notesIndex;
  }
  function scoreNotesMatch(query, fileKey) {
    if (!query || !fileKey) return 0;
    if (query === fileKey) return 100;
    if (fileKey.indexOf(query) >= 0 || query.indexOf(fileKey) >= 0) {
      var shorter = Math.min(query.length, fileKey.length);
      if (shorter < 4) return 0;
      return 60 + Math.min(30, shorter);
    }
    var qt = query.split(" "), ft = fileKey.split(" "), hit = 0;
    qt.forEach(function (t) { if (t.length > 2 && ft.indexOf(t) >= 0) hit++; });
    if (hit && hit === qt.length) return 80;
    if (hit >= 2) return 50;
    if (hit === 1 && qt.length === 1) return 40;
    return 0;
  }
  function resolveNotesFile(item) {
    if (!_notesIndex) return null;
    var chapter = normNotesKey(item.chapter || item.Chapter || "");
    var topic = normNotesKey(item.topic || item.topics || "");
    var subject = normNotesKey(item.subject || "");
    var best = null, bestScore = 0;
    Object.keys(_notesIndex).forEach(function (key) {
      var sc = 0;
      if (chapter) sc = Math.max(sc, scoreNotesMatch(chapter, key));
      if (topic) sc = Math.max(sc, scoreNotesMatch(topic, key) - 5);
      if (subject && chapter) sc = Math.max(sc, scoreNotesMatch(subject + " " + chapter, key) - 10);
      if (sc > bestScore) { bestScore = sc; best = _notesIndex[key]; }
    });
    return bestScore >= 40 ? best : null;
  }
  async function fetchNotesHtml(fileId) {
    if (_notesHtmlCache[fileId]) return _notesHtmlCache[fileId];
    var url = "https://www.googleapis.com/drive/v3/files/" + encodeURIComponent(fileId) +
      "?alt=media&key=" + encodeURIComponent(DRIVE_API_KEY);
    var res = await fetch(url);
    if (!res.ok) throw new Error("notes body " + res.status);
    var text = await res.text();
    _notesHtmlCache[fileId] = text;
    return text;
  }
  /* ===== Bottom sheet: height in px for reliable drag ===== */
  var _nsH = 0;
  var _nsDragging = false;
  var _nsStartY = 0;
  var _nsStartH = 0;
  var _nsMax = 0;
  var _nsMin = 0;
  var _nsHalf = 0;

  function nsMeasure() {
    _nsMax = Math.round(window.innerHeight * 0.94);
    _nsMin = Math.round(window.innerHeight * 0.28);
    _nsHalf = Math.round(window.innerHeight * 0.5);
  }

  function nsApplyH(px, anim) {
    var sheet = $("notesSheet");
    if (!sheet) return;
    px = Math.max(_nsMin, Math.min(_nsMax, px));
    _nsH = px;
    if (!anim) sheet.classList.add("no-anim");
    else sheet.classList.remove("no-anim");
    sheet.style.height = px + "px";
    var hint = $("notesSheetHint");
    if (hint) {
      hint.textContent = px > window.innerHeight * 0.75 ? "↓ pull down to close" : "↑ pull up for full · ↓ close";
    }
    if (!anim) {
      /* force reflow then allow anim later */
      void sheet.offsetHeight;
    }
  }

  function closeNotesSheet() {
    var sheet = $("notesSheet");
    var backdrop = $("notesSheetBackdrop");
    var frame = $("notesSheetFrame");
    var loading = $("notesSheetLoading");
    if (!sheet) return;
    sheet.classList.remove("open");
    if (backdrop) backdrop.classList.remove("open");
    sheet.setAttribute("aria-hidden", "true");
    setTimeout(function () {
      try {
        if (frame) {
          frame.removeAttribute("src");
          frame.style.display = "none";
          var doc = frame.contentDocument || frame.contentWindow.document;
          doc.open(); doc.write(""); doc.close();
        }
      } catch (err) {}
      if (loading) {
        loading.classList.remove("hide");
        loading.textContent = "Loading chapter…";
      }
      nsMeasure();
      nsApplyH(_nsHalf, false);
    }, 280);
    try { sendWebViewString(MSG_BACK); } catch (err) {}
  }

  function openChapterNotes(fileMeta) {
    var sheet = $("notesSheet");
    var backdrop = $("notesSheetBackdrop");
    var frame = $("notesSheetFrame");
    var loading = $("notesSheetLoading");
    var titleEl = $("notesSheetTitle");
    if (!sheet) return;

    nsMeasure();
    nsApplyH(_nsHalf, false);

    var title = String(fileMeta.name || "Chapter").replace(/\.html?$/i, "").replace(/-/g, " ");
    if (titleEl) titleEl.textContent = title;
    if (loading) {
      loading.classList.remove("hide");
      loading.textContent = "Loading chapter…";
    }
    if (frame) {
      frame.style.display = "none";
      try { frame.removeAttribute("src"); } catch (err) {}
    }

    if (backdrop) backdrop.classList.add("open");
    sheet.classList.add("open");
    sheet.setAttribute("aria-hidden", "false");
    var fullBtn = $("notesSheetFull");
    var closeBtn = $("notesSheetClose");
    if (fullBtn) {
      fullBtn.textContent = "Full";
      fullBtn.onclick = function (ev) {
        if (ev) { ev.preventDefault(); ev.stopPropagation(); }
        nsMeasure();
        if (_nsH >= window.innerHeight * 0.8) {
          nsApplyH(_nsHalf, true);
          fullBtn.textContent = "Full";
        } else {
          nsApplyH(_nsMax, true);
          fullBtn.textContent = "Half";
        }
      };
    }
    if (closeBtn) {
      closeBtn.onclick = function (ev) {
        if (ev) { ev.preventDefault(); ev.stopPropagation(); }
        closeNotesSheet();
      };
    }
    var backdrop = $("notesSheetBackdrop");
    if (backdrop) backdrop.onclick = function () { closeNotesSheet(); };
    try { sendWebViewString(MSG_OPEN); } catch (err) {}

    function showHtml(html) {
      try {
        var doc = frame.contentDocument || frame.contentWindow.document;
        doc.open();
        doc.write(html);
        doc.close();
        frame.style.display = "block";
        if (loading) loading.classList.add("hide");
      } catch (err) {
        showPreview();
      }
    }
    function showPreview() {
      frame.src = "https://drive.google.com/file/d/" + fileMeta.id + "/preview";
      frame.style.display = "block";
      if (loading) loading.classList.add("hide");
    }

    if (fileMeta.isHtml) {
      fetchNotesHtml(fileMeta.id).then(showHtml).catch(showPreview);
    } else {
      showPreview();
    }
  }

  function initNotesSheetDrag() {
    var sheet = $("notesSheet");
    var backdrop = $("notesSheetBackdrop");
    var closeBtn = $("notesSheetClose");
    var fullBtn = $("notesSheetFull");
    if (!sheet) return;

    nsMeasure();
    nsApplyH(_nsHalf, false);

    function toggleFull() {
      nsMeasure();
      if (_nsH >= window.innerHeight * 0.8) {
        nsApplyH(_nsHalf, true);
        if (fullBtn) fullBtn.textContent = "Full";
      } else {
        nsApplyH(_nsMax, true);
        if (fullBtn) fullBtn.textContent = "Half";
      }
    }

    if (fullBtn) {
      fullBtn.onclick = function (ev) {
        ev.preventDefault();
        ev.stopPropagation();
        toggleFull();
      };
    }
    if (closeBtn) {
      closeBtn.onclick = function (ev) {
        ev.preventDefault();
        ev.stopPropagation();
        closeNotesSheet();
      };
    }
    if (backdrop) {
      backdrop.onclick = function () { closeNotesSheet(); };
    }

    /* Optional light drag on handle only — buttons are primary */
    var drag = $("notesSheetDrag");
    if (drag) {
      function pointerY(ev) {
        if (ev.touches && ev.touches[0]) return ev.touches[0].clientY;
        if (ev.changedTouches && ev.changedTouches[0]) return ev.changedTouches[0].clientY;
        return ev.clientY;
      }
      function isBtn(t) {
        return t && (t.id === "notesSheetClose" || t.id === "notesSheetFull" ||
          (t.closest && (t.closest("#notesSheetClose") || t.closest("#notesSheetFull"))));
      }
      drag.addEventListener("touchstart", function (ev) {
        if (isBtn(ev.target)) return;
        _nsDragging = true;
        _nsStartY = pointerY(ev);
        _nsStartH = _nsH || sheet.offsetHeight;
        sheet.classList.add("no-anim");
      }, { passive: true });
      drag.addEventListener("touchmove", function (ev) {
        if (!_nsDragging) return;
        if (ev.cancelable) ev.preventDefault();
        nsApplyH(_nsStartH + (_nsStartY - pointerY(ev)), false);
      }, { passive: false });
      drag.addEventListener("touchend", function () {
        if (!_nsDragging) return;
        _nsDragging = false;
        sheet.classList.remove("no-anim");
        if (_nsH < window.innerHeight * 0.36) closeNotesSheet();
        else if (_nsH > window.innerHeight * 0.7) {
          nsApplyH(_nsMax, true);
          if (fullBtn) fullBtn.textContent = "Half";
        } else {
          nsApplyH(_nsHalf, true);
          if (fullBtn) fullBtn.textContent = "Full";
        }
      }, { passive: true });
    }

    window.addEventListener("resize", function () {
      if (!sheet.classList.contains("open")) {
        nsMeasure();
        nsApplyH(_nsHalf, false);
      }
    });
  }

