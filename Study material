<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Exam Playlists</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{font-family:Inter,system-ui,sans-serif;background:#f4f6fb;color:#0f172a;min-height:100vh}
.wrap{max-width:640px;margin:0 auto;padding:14px 14px 40px}
h1{font-size:1.15rem;font-weight:700}
.sub{font-size:.8rem;color:#64748b;margin:4px 0 12px}
.chips{display:flex;gap:8px;overflow-x:auto;padding-bottom:8px;margin-bottom:12px;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.chip{
  flex-shrink:0;border:1.5px solid #e2e8f0;background:#fff;border-radius:999px;
  padding:8px 14px;font-size:.8rem;font-weight:600;color:#475569
}
.chip.on{background:#2563eb;border-color:#2563eb;color:#fff}
.section{
  font-size:.72rem;font-weight:700;color:#6366f1;text-transform:uppercase;
  letter-spacing:.4px;margin:16px 0 10px
}
.banner-card{
  background:#fff;border:1px solid #e8ecf4;border-radius:16px;overflow:hidden;
  margin-bottom:12px;box-shadow:0 2px 12px rgba(15,23,42,.05);cursor:pointer
}
.banner-card:active{transform:scale(.99)}
.banner-wrap{width:100%;aspect-ratio:16/9;background:#e2e8f0;overflow:hidden}
.banner-wrap img{width:100%;height:100%;object-fit:cover;display:block}
.banner-info{padding:12px}
.banner-info b{display:block;font-size:.9rem;line-height:1.35;margin-bottom:4px}
.banner-info span{font-size:.72rem;color:#64748b}
.bar{margin-bottom:12px}
.btn{border:0;border-radius:10px;padding:10px 14px;font-weight:600;font-size:.82rem;background:#e2e8f0}
.player-box{display:none;background:#000;border-radius:14px;overflow:hidden;margin-bottom:12px;aspect-ratio:16/9}
.player-box.show{display:block}
.player-box iframe{width:100%;height:100%;border:0}
.vid{
  display:flex;gap:10px;align-items:center;background:#fff;border:1px solid #e8ecf4;
  border-radius:12px;padding:10px;margin-bottom:8px;cursor:pointer
}
.vid img{width:96px;height:54px;border-radius:8px;object-fit:cover;background:#e2e8f0}
.vid b{font-size:.84rem;display:block}
.loading,.empty{text-align:center;padding:28px;color:#64748b;font-size:.9rem}
.err{background:#fef2f2;color:#b91c1c;border-radius:12px;padding:12px;font-size:.85rem;margin:10px 0}
.hidden{display:none}
</style>
</head>
<body>
<div class="wrap">
  <div id="home">
    <h1>Exam Playlists</h1>
    <p class="sub">Choose exam · open playlist · watch</p>
    <div class="chips" id="examChips"></div>
    <div class="section" id="discoverTitle">Playlists · NDA</div>
    <div id="discoverList"></div>
    <div class="loading" id="loadingHome">Loading playlists...</div>
    <div class="err hidden" id="errHome"></div>
  </div>

  <div id="playlistView" class="hidden">
    <div class="bar">
      <button class="btn" type="button" id="btnBack">← Back</button>
    </div>
    <div class="section" id="plTitle">Playlist</div>
    <div class="player-box" id="playerBox">
      <iframe
        id="player"
        referrerpolicy="strict-origin-when-cross-origin"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
        allowfullscreen
        playsinline
      ></iframe>
    </div>
    <div class="section">Videos in this playlist</div>
    <div id="videoList"></div>
    <div class="loading hidden" id="loadingPl">Loading...</div>
    <div class="err hidden" id="errPl"></div>
  </div>
</div>

<script>
(function () {
  // Apni key yahan — Cloud me restrict karo (YouTube Data API only)
  var API_KEY = "AIzaSyCVSN5-wdrjfUHLYbyfdmS5LdtzISaqCcI";

  var EXAMS = [
    { id: "NDA", q: "NDA exam full preparation playlist" },
    { id: "CDS", q: "CDS exam preparation complete playlist" },
    { id: "SSC", q: "SSC CGL complete course playlist" },
    { id: "AFCAT", q: "AFCAT exam preparation playlist" },
    { id: "Army", q: "Indian Army GD Agniveer preparation playlist" }
  ];

  var currentExam = "NDA";

  function $(id) { return document.getElementById(id); }

  function escapeHtml(s) {
    return String(s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  // Error 153 fix: nocookie + playsinline
  function playUrl(videoId) {
    return "https://www.youtube-nocookie.com/embed/" + encodeURIComponent(videoId) +
      "?autoplay=1&rel=0&playsinline=1&modestbranding=1";
  }

  function renderChips() {
    var box = $("examChips");
    box.innerHTML = "";
    EXAMS.forEach(function (e) {
      var b = document.createElement("button");
      b.type = "button";
      b.className = "chip" + (e.id === currentExam ? " on" : "");
      b.textContent = e.id;
      b.onclick = function () {
        currentExam = e.id;
        renderChips();
        loadDiscover();
      };
      box.appendChild(b);
    });
  }

  async function searchPlaylists(examId) {
    if (!API_KEY || API_KEY.indexOf("YOUR_") === 0) {
      throw new Error("YouTube API key daalo");
    }
    var exam = EXAMS.find(function (e) { return e.id === examId; }) || EXAMS[0];
    var url =
      "https://www.googleapis.com/youtube/v3/search?part=snippet&type=playlist&maxResults=12&q=" +
      encodeURIComponent(exam.q) +
      "&key=" + encodeURIComponent(API_KEY);

    var res = await fetch(url);
    var data = await res.json();
    if (data.error) throw new Error(data.error.message || "Search failed");

    return (data.items || []).map(function (it) {
      var sn = it.snippet || {};
      var thumbs = sn.thumbnails || {};
      var thumb = (thumbs.high || thumbs.medium || thumbs.default || {}).url || "";
      return {
        playlistId: it.id && it.id.playlistId,
        title: sn.title || "Playlist",
        channel: sn.channelTitle || "",
        thumb: thumb,
        exam: examId
      };
    }).filter(function (x) { return x.playlistId; });
  }

  async function loadDiscover() {
    $("discoverTitle").textContent = "Playlists · " + currentExam;
    $("discoverList").innerHTML = "";
    $("errHome").classList.add("hidden");
    $("loadingHome").classList.remove("hidden");

    try {
      var items = await searchPlaylists(currentExam);
      $("loadingHome").classList.add("hidden");
      if (!items.length) {
        $("discoverList").innerHTML = '<div class="empty">No playlists found</div>';
        return;
      }
      items.forEach(function (pl) {
        var card = document.createElement("div");
        card.className = "banner-card";
        card.innerHTML =
          '<div class="banner-wrap">' +
            (pl.thumb ? '<img src="' + pl.thumb + '" alt="">' : "") +
          "</div>" +
          '<div class="banner-info"><b>' + escapeHtml(pl.title) + "</b>" +
          "<span>" + escapeHtml(pl.channel) + " · " + escapeHtml(pl.exam) + "</span></div>";
        card.onclick = function () { openPlaylist(pl); };
        $("discoverList").appendChild(card);
      });
    } catch (e) {
      $("loadingHome").classList.add("hidden");
      $("errHome").textContent = String(e.message || e);
      $("errHome").classList.remove("hidden");
    }
  }

  async function fetchVideos(playlistId) {
    var items = [];
    var pageToken = "";
    for (var p = 0; p < 2; p++) {
      var url =
        "https://www.googleapis.com/youtube/v3/playlistItems?part=snippet,contentDetails&maxResults=50&playlistId=" +
        encodeURIComponent(playlistId) +
        "&key=" + encodeURIComponent(API_KEY) +
        (pageToken ? "&pageToken=" + pageToken : "");
      var res = await fetch(url);
      var data = await res.json();
      if (data.error) throw new Error(data.error.message || "Playlist error");
      (data.items || []).forEach(function (it) {
        var sn = it.snippet || {};
        var vid = (it.contentDetails && it.contentDetails.videoId) ||
          (sn.resourceId && sn.resourceId.videoId);
        if (!vid || sn.title === "Private video" || sn.title === "Deleted video") return;
        var thumbs = sn.thumbnails || {};
        items.push({
          id: vid,
          title: sn.title || "Video",
          thumb: (thumbs.medium || thumbs.default || {}).url || ""
        });
      });
      pageToken = data.nextPageToken || "";
      if (!pageToken) break;
    }
    return items;
  }

  async function openPlaylist(pl) {
    $("home").classList.add("hidden");
    $("playlistView").classList.remove("hidden");
    $("plTitle").textContent = pl.title;
    $("playerBox").classList.remove("show");
    $("player").src = "about:blank";
    $("videoList").innerHTML = "";
    $("errPl").classList.add("hidden");
    $("loadingPl").classList.remove("hidden");

    try {
      var videos = await fetchVideos(pl.playlistId);
      $("loadingPl").classList.add("hidden");
      if (!videos.length) {
        $("errPl").textContent = "No public videos in this playlist";
        $("errPl").classList.remove("hidden");
        return;
      }
      videos.forEach(function (v) {
        var row = document.createElement("div");
        row.className = "vid";
        row.innerHTML =
          (v.thumb ? '<img src="' + v.thumb + '" alt="">' : "") +
          "<div><b>" + escapeHtml(v.title) + "</b></div>";
        row.onclick = function () {
          $("playerBox").classList.add("show");
          $("player").src = playUrl(v.id);
        };
        $("videoList").appendChild(row);
      });
      $("playerBox").classList.add("show");
      $("player").src = playUrl(videos[0].id);
    } catch (e) {
      $("loadingPl").classList.add("hidden");
      $("errPl").textContent = String(e.message || e);
      $("errPl").classList.remove("hidden");
    }
  }

  $("btnBack").onclick = function () {
    $("playlistView").classList.add("hidden");
    $("home").classList.remove("hidden");
    $("player").src = "about:blank";
  };

  renderChips();
  loadDiscover();
})();
</script>
</body>
</html>