  /* ===== Filters UI ===== */
  function fillSelect(id, values, keepFirst) {
    var sel = $(id);
    var cur = sel.value;
    var first = sel.options[0] ? sel.options[0].outerHTML : '<option value="">All</option>';
    sel.innerHTML = keepFirst !== false ? first : "";
    (values || []).forEach(function (v) {
      if (!v) return;
      var o = document.createElement("option");
      o.value = v;
      o.textContent = v;
      sel.appendChild(o);
    });
    if (cur) sel.value = cur;
  }

  function applyMetaToFilters() {
    fillSelect("fExam", filterMeta.exams);
    fillSelect("fSubject", filterMeta.subjects);
    fillSelect("fTopic", filterMeta.topics);
    fillSelect("fYear", filterMeta.years);
    fillSelect("fShift", filterMeta.shifts);
    fillSelect("fSection", filterMeta.sections);
