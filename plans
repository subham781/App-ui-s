  };

  firebase.initializeApp(firebaseConfig);
  const db = firebase.database();

  var USER_ID = "";
  var DISPLAY_NAME = "";
  var CHANNEL_NAME = "";
  var correctAns = "A";

  // ===== SAME as Profile.html =====
  function normalizeUserKey(raw) {
    var s = String(raw || "").trim();
    if (!s) return "";
    if (s.indexOf("USER|") === 0) s = s.substring(5).trim();
    if (s.indexOf("@") > 0) s = s.split("@")[0];
    return s.replace(/@gmail\.com$/i, "").trim();
  }

  function getUserFromKodular() {
    try {
      if (window.AppInventor && window.AppInventor.getWebViewString) {
        var s = window.AppInventor.getWebViewString() || "";
        s = normalizeUserKey(s);
        if (s) return s;
      }
    } catch (e) {}
    try {
      if (window.Kodular && window.Kodular.getWebViewString) {
        var s2 = normalizeUserKey(window.Kodular.getWebViewString() || "");
        if (s2) return s2;
      }
    } catch (e) {}
    try {
      var q = new URLSearchParams(location.search).get("user");
      return q ? normalizeUserKey(q) : "";
    } catch (e) {
      return "";
    }
  }

  function setHeader(name, id, note) {
    document.getElementById("dispName").textContent = name || "—";
    document.getElementById("dispId").textContent =
      (id ? ("ID: " + id) : "—") + (note ? (" · " + note) : "");
    document.getElementById("av").textContent = String(name || id || "?").charAt(0).toUpperCase();
  }

  // Profile page jaisa: Users/{id} → profile.name / channelName / displayName
  function loadUser(name) {
    name = normalizeUserKey(name);
    USER_ID = name;

    if (!name) {
      setHeader("Username nahi mila", "", "WebViewString = Label5");
      return;
    }

    setHeader("Loading...", name, "");

    db.ref("Users/" + name)
      .once("value")
      .then(function (snap) {
        if (!snap.exists()) {
          DISPLAY_NAME = name;
          CHANNEL_NAME = name;
          setHeader(name, name, "path not found");
          return;
        }

        var data = snap.val() || {};
        var p = data.profile || {};

        // display name priority (jo bhi profile me ho)
        DISPLAY_NAME = String(
          p.name ||
          p.displayName ||
          p["display name"] ||
          p.channelName ||
          name
        ).trim();

        CHANNEL_NAME = String(
          p.channelName ||
          p.name ||
          p.displayName ||
          DISPLAY_NAME
        ).trim();

        setHeader(DISPLAY_NAME, name, "ok");
      })
      .catch(function (err) {
        DISPLAY_NAME = name;
        CHANNEL_NAME = name;
        setHeader(name, name, err.message || "error");
      });
  }

  function start() {
    var username = getUserFromKodular();
    if (username) {
      loadUser(username);
    } else {
      setHeader("Waiting Label5...", "", "WebViewString empty");
      // Kodular late string
      setTimeout(function () {
        var u2 = getUserFromKodular();
        if (u2) loadUser(u2);
      }, 500);
      setTimeout(function () {
        var u3 = getUserFromKodular();
        if (u3) loadUser(u3);
      }, 1500);
    }
  }

  function uid(prefix) {
    return prefix + "_" + Date.now() + "_" + Math.floor(1000 + Math.random() * 9000);
  }

