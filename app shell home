  async function runGlobalSearch(q){
    var box=$("searchResults");
    box.classList.add("show");
    box.innerHTML='<div class="sr-empty">Searching…</div>';
    var results=[], nq=normKey(q);

    allMcqs.forEach(function(m){
      var hay=normKey([m.q,m.subject,m.topic,m.exam,m.year,m.source].join(" "));
      if(hay.indexOf(nq)>=0) results.push({type:"MCQ",title:m.q,meta:(m.exam||m.subject||"")+(m.year?" · "+m.year:""),data:m});
    });
    allOneLiners.forEach(function(ol){
      if(normKey(ol.question+" "+ol.answer).indexOf(nq)>=0)
        results.push({type:"One-liner",title:ol.question,meta:"Answer available",data:ol});
    });

    try{
      if(MCQ_API.indexOf("YOUR_")<0){
        var res=await fetch(buildSearchUrl(q),{cache:"no-store",redirect:"follow"});
        if(res.ok){
          var data=await res.json();
          var rows=Array.isArray(data)?data:(data.rows||data.data||data.questions||[]);
          (rows||[]).forEach(function(r){
            var m=normalizeMcq(r); if(!m||!m.q) return;
            results.push({type:"Sheet",title:m.q,meta:[m.exam,m.subject,m.year].filter(Boolean).join(" · ")||"Sheet",data:m});
          });
        }
      }
    }catch(e){}

    try{
      if(DRIVE_API_KEY.indexOf("YOUR_")<0&&DRIVE_FOLDER_ID.indexOf("YOUR_")<0){
        var dq=encodeURIComponent("'"+DRIVE_FOLDER_ID+"' in parents and trashed=false and name contains '"+q.replace(/'/g,"\\'")+"'");
        var driveUrl="https://www.googleapis.com/drive/v3/files?q="+dq+"&fields=files(id,name,mimeType,webViewLink)&key="+encodeURIComponent(DRIVE_API_KEY)+"&pageSize=12";
        var dres=await fetch(driveUrl);
        if(dres.ok){
          var djson=await dres.json();
          (djson.files||[]).forEach(function(f){
            results.push({type:"PDF / Drive",title:f.name,meta:f.mimeType||"File",data:{link:f.webViewLink||("https://drive.google.com/file/d/"+f.id+"/view"),name:f.name}});
          });
        }
      }
    }catch(e){}

    var seen={};
    results=results.filter(function(r){ var k=normKey(r.type+r.title).slice(0,80); if(seen[k]) return false; seen[k]=true; return true; }).slice(0,28);
    if(!results.length){ box.innerHTML='<div class="sr-empty">No match. Try exam / subject / year.</div>'; return; }

    box.innerHTML=results.map(function(r,i){
      return '<div class="sr-item" data-i="'+i+'"><div class="sr-type">'+escapeHTML(r.type)+'</div><div class="sr-title">'+escapeHTML(r.title)+'</div><div class="sr-meta">'+escapeHTML(r.meta)+"</div></div>";
    }).join("");
    box.querySelectorAll(".sr-item").forEach(function(el){
      el.onclick=function(){
        var r=results[parseInt(el.getAttribute("data-i"),10)]; if(!r) return;
        box.classList.remove("show");
        if(r.type.indexOf("Drive")>=0||r.type.indexOf("PDF")>=0){ sendWebViewString(MSG_OPEN); openViewer(r.data.name,r.data.link); }
        else if(r.type==="One-liner"){ alert("Q: "+r.data.question+"\n\nA: "+r.data.answer); }
        else if(r.data&&r.data.q){
          var feed=$("mixedFeed");
          var card=renderMcq(r.data,"search_"+Date.now());
          feed.insertBefore(card,feed.firstChild);
          card.scrollIntoView({behavior:"smooth",block:"center"});
        }
      };
    });
  }

