<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>MCQ Practice</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:Inter,sans-serif;background:#f0f2f5;color:#050505;height:100vh;overflow:hidden}
#feedPage{height:100vh;display:flex;flex-direction:column}
.top-bar{background:#fff;border-bottom:1px solid #e4e6eb;padding:10px 12px;display:flex;justify-content:space-between;align-items:center;gap:8px}
.top-bar h1{font-size:1rem;font-weight:700}
.user-chip{font-size:.72rem;font-weight:700;background:#eef2ff;color:#3730a3;padding:4px 10px;border-radius:999px;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.lang-switch{display:flex;background:#f0f2f5;border-radius:10px;padding:3px}
.lang-btn{border:0;background:transparent;padding:6px 12px;border-radius:8px;font-size:.8rem;font-weight:700;color:#65676b}
.lang-btn.active{background:#1877f2;color:#fff}
.feed{flex:1;overflow-y:auto;padding:12px;-webkit-overflow-scrolling:touch}
.post-card{background:#fff;border-radius:12px;padding:16px;margin-bottom:12px;box-shadow:0 1px 2px rgba(0,0,0,.08)}
.post-header{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.avatar{width:40px;height:40px;border-radius:50%;background:#e4e6eb;display:flex;align-items:center;justify-content:center;font-weight:700;color:#65676b}
.channel-info h3{font-size:.95rem;font-weight:600}
.channel-info p{font-size:.78rem;color:#65676b}
.question-text{font-size:1.05rem;line-height:1.45;margin-bottom:14px;font-weight:500}
.options{display:flex;flex-direction:column;gap:8px}
.option{border:1.5px solid #ccd0d5;border-radius:8px;padding:12px 14px;font-size:.95rem;cursor:pointer;background:#fff;word-break:break-word}
.option.correct{background:#e7f6ec;border-color:#31a24c;color:#31a24c;font-weight:600}
.option.wrong{background:#fde8e8;border-color:#e41e3f;color:#e41e3f}
.option.disabled{pointer-events:none}
.post-footer{display:flex;justify-content:space-between;align-items:center;margin-top:14px;padding-top:12px;border-top:1px solid #e4e6eb}
.answered{font-size:.82rem;color:#65676b}
.actions{display:flex;gap:18px}
.action-btn{background:none;border:none;font-size:1.25rem;cursor:pointer;color:#65676b}
.action-btn.liked{color:#e41e3f}
.action-btn.saved{color:#1877f2}
.loading,.error{text-align:center;padding:40px 14px;color:#65676b;font-size:.9rem;line-height:1.45}
.error{color:#b91c1c}
.insight-wrap{display:none;margin-top:14px;padding-top:12px;border-top:1px solid #e4e6eb}
.insight-wrap.show{display:block}
.insight-title{font-size:.82rem;font-weight:700;color:#1877f2;margin-bottom:8px}
.insight-scroll{display:flex;gap:10px;overflow-x:auto;padding-bottom:6px;scrollbar-width:none}
.insight-card{min-width:220px;max-width:240px;background:#f0f7ff;border:1px solid #dbeafe;border-radius:12px;padding:12px;flex-shrink:0;cursor:pointer}
.insight-card h4{font-size:.88rem;font-weight:700;margin-bottom:6px}
.insight-card p{font-size:.78rem;color:#4b5563;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}
.sheet-overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1000;display:none;align-items:flex-end;justify-content:center}
.sheet-overlay.show{display:flex}
.sheet{width:100%;max-width:700px;height:85vh;background:#fff;border-radius:18px 18px 0 0;display:flex;flex-direction:column;overflow:hidden}
.sheet-header{display:flex;align-items:center;gap:10px;padding:12px 14px;border-bottom:1px solid #e4e6eb;background:#f8fafc}
.sheet-header h3{flex:1;font-size:.95rem;font-weight:700}
.sheet-close{border:0;background:#e4e6eb;width:34px;height:34px;border-radius:10px}
.sheet-frame{flex:1;width:100%;border:0;display:none}
.sheet-loading{padding:20px;text-align:center;color:#65676b}
</style>
</head>
<body>
<div id="feedPage">
  <div class="top-bar">
    <h1>MCQ Practice</h1>
    <span class="user-chip" id="userChip">â€”</span>
    <div class="lang-switch">
      <button class="lang-btn active" id="btn-en" type="button" onclick="setLang('en')">EN</button>
      <button class="lang-btn" id="btn-hi" type="button" onclick="setLang('hi')">à¤¹à¤¿à¤‚</button>
    </div>
  </div>
  <div class="feed" id="feed"><div class="loading">Loading questions...</div></div>
</div>

<div class="sheet-overlay" id="sheetOverlay" onclick="closeSheet(event)">
  <div class="sheet" onclick="event.stopPropagation()">
    <div class="sheet-header">
      <h3 id="sheetTitle">Topic</h3>
      <button class="sheet-close" type="button" onclick="hideSheet()">âœ•</button>
    </div>
    <div class="sheet-loading" id="sheetLoading">Opening...</div>
    <iframe class="sheet-frame" id="sheetFrame"></iframe>
  </div>
</div>

<script>
  // ===== SAME URL (working) =====
  const API_URL = "https://script.google.com/macros/s/AKfycbyICNHxGGgvd7TBcgSxjQm3obJqDOGtHHiwiwUoXnxiNurmqmWDfwOXo5x9rfQqnXs/exec";

  const firebaseConfig = {
    apiKey: "AIzaSyCDvOq7CUmM92aDNyEfP7TNXsCLgmDoQxg",
    authDomain: "prepexam-f98bf.firebaseapp.com",
    databaseURL: "https://prepexam-f98bf-default-rtdb.firebaseio.com",
    projectId: "prepexam-f98bf",
    storageBucket: "prepexam-f98bf.firebasestorage.app",
    messagingSenderId: "570075784084",
    appId: "1:570075784084:web:0ebdbef4a887ce777aa581"
  };

  let db = null;
  let allQuestions = [];
  let wikiLang = "en";
  let MY_ID = "";

  function normalizeUserKey(raw) {
    var s = String(raw || "").trim();
    if (!s) return "";
    if (s.indexOf("USER|") === 0) s = s.substring(5).trim();
    if (s.indexOf("@") > 0) s = s.split("@")[0];
    return s.replace(/@gmail\.com$/i, "").trim();
  }

  function getUserFromKodular() {
    try {
      if (window.AppInventor && window.AppInventor.getWebViewString) {
        var s = normalizeUserKey(window.AppInventor.getWebViewString() || "");
        if (s) return s;
      }
    } catch (e) {}
    try {
      var q = new URLSearchParams(location.search).get("user");
      return normalizeUserKey(q || "");
    } catch (e) { return ""; }
  }

  function refreshMyId() {
    MY_ID = getUserFromKodular() || localStorage.getItem("mcq_user_name") || "";
    if (MY_ID) localStorage.setItem("mcq_user_name", MY_ID);
    var chip = document.getElementById("userChip");
    if (chip) chip.textContent = MY_ID || "no id";
    return MY_ID;
  }

  function setLang(lang) {
    wikiLang = lang;
    document.getElementById("btn-en").classList.toggle("active", lang === "en");
    document.getElementById("btn-hi").classList.toggle("active", lang === "hi");
  }

  function getData(k){ try{return JSON.parse(localStorage.getItem(k)||"[]");}catch(e){return[];} }
  function setData(k,v){ localStorage.setItem(k, JSON.stringify(v)); }
  function escapeHTML(v){ return String(v||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }

  // ---------- QUESTIONS FIRST (no Firebase wait) ----------
  function loadQuestions() {
    var feed = document.getElementById("feed");
    feed.innerHTML = '<div class="loading">Loading questions...</div>';

    var done = false;
    var timer = setTimeout(function () {
      if (done) return;
      done = true;
      feed.innerHTML = '<div class="error">Timeout 20s<br>API slow / network issue<br><button onclick="loadQuestions()" style="margin-top:10px;padding:8px 14px;border:0;border-radius:8px;background:#1877f2;color:#fff;font-weight:700">Retry</button></div>';
    }, 20000);

    var url = API_URL + (API_URL.indexOf("?") >= 0 ? "&" : "?") + "t=" + Date.now();

    fetch(url, { method: "GET", redirect: "follow", cache: "no-store" })
      .then(function (res) {
        if (!res.ok) throw new Error("HTTP " + res.status);
        return res.text();
      })
      .then(function (text) {
        if (done) return;
        clearTimeout(timer);
        done = true;
        var data;
        try { data = JSON.parse(text); }
        catch (e) {
          feed.innerHTML = '<div class="error">JSON parse fail<br><small>' + escapeHTML(text.slice(0, 200)) + '</small></div>';
          return;
        }
        if (data && Array.isArray(data.questions)) data = data.questions;
        if (data && Array.isArray(data.data)) data = data.data;
        if (!Array.isArray(data) || !data.length) {
          feed.innerHTML = '<div class="error">No questions array</div>';
          return;
        }
        allQuestions = data;
        renderFeed();
        // Firebase AFTER questions shown
        loadFirebaseLater();
      })
      .catch(function (err) {
        if (done) return;
        clearTimeout(timer);
        done = true;
        feed.innerHTML = '<div class="error">Failed: ' + escapeHTML(err.message) +
          '<br><button onclick="loadQuestions()" style="margin-top:10px;padding:8px 14px;border:0;border-radius:8px;background:#1877f2;color:#fff;font-weight:700">Retry</button></div>';
      });
  }

  function renderFeed() {
    var feed = document.getElementById("feed");
    feed.innerHTML = "";
    var myLikes = getData("mcq_likes");
    var mySaved = getData("mcq_saved");

    allQuestions.forEach(function (item, index) {
      var liked = item.uid && myLikes.indexOf(item.uid) >= 0;
      var saved = item.uid && mySaved.some(function (s) { return s.uid === item.uid; });

      var card = document.createElement("div");
      card.className = "post-card";
      card.innerHTML =
        '<div class="post-header">' +
          '<div class="avatar">' + (item.username || "E").charAt(0) + '</div>' +
          '<div class="channel-info">' +
            '<h3>' + escapeHTML(item.username || "Educator") + '</h3>' +
            '<p>' + escapeHTML(item.subject || "General") + ' â€¢ ' + escapeHTML(item.difficulty || "Medium") + '</p>' +
          '</div>' +
        '</div>' +
        '<div class="question-text"></div>' +
        '<div class="options" id="options-' + index + '"></div>' +
        '<div class="insight-wrap" id="insight-' + index + '"></div>' +
        '<div class="post-footer">' +
          '<div class="answered" id="answered-' + index + '">Tap option to answer</div>' +
          '<div class="actions">' +
            '<button type="button" class="action-btn' + (liked ? " liked" : "") + '" id="like-' + index + '">ðŸ‘</button>' +
            '<button type="button" class="action-btn' + (saved ? " saved" : "") + '" id="save-' + index + '">ðŸ”–</button>' +
          '</div>' +
        '</div>';

      card.querySelector(".question-text").textContent = item.q || "";

      var optBox = card.querySelector("#options-" + index);
      (item.options || []).forEach(function (opt, i) {
        var d = document.createElement("div");
        d.className = "option";
        d.textContent = opt || "â€”";
        d.onclick = function () { selectOption(index, i); };
        optBox.appendChild(d);
      });

      card.querySelector("#like-" + index).onclick = function () { toggleLike(item.uid, this); };
      card.querySelector("#save-" + index).onclick = function () { toggleSave(index, this); };
      feed.appendChild(card);
    });
  }

  function selectOption(qIndex, selected) {
    var item = allQuestions[qIndex];
    document.querySelectorAll("#options-" + qIndex + " .option").forEach(function (opt, i) {
      opt.classList.add("disabled");
      if (i === item.correct) opt.classList.add("correct");
      if (i === selected && selected !== item.correct) opt.classList.add("wrong");
    });
    document.getElementById("answered-" + qIndex).textContent =
      selected === item.correct ? "Correct âœ“" : "Wrong âœ—";
    showTopicInsight(qIndex, item);
  }

  async function toggleLike(uid, btn) {
    if (!uid) return;
    var id = refreshMyId();
    if (!id) { alert("Label5 se user id nahi mili (WebViewString)"); return; }

    var likes = getData("mcq_likes");
    var isLiked = likes.indexOf(uid) >= 0;
    if (isLiked) {
      likes = likes.filter(function (x) { return x !== uid; });
      btn.classList.remove("liked");
    } else {
      likes.push(uid);
      btn.classList.add("liked");
    }
    setData("mcq_likes", likes);

    if (db) {
      try {
        var ref = db.ref("Users/" + id + "/consume/likedMcq/" + uid);
        if (!isLiked) await ref.set({ ts: Math.floor(Date.now() / 1000) });
        else await ref.remove();
      } catch (e) { console.log(e); }
    }
  }

  async function toggleSave(qIndex, btn) {
    var item = allQuestions[qIndex];
    if (!item || !item.uid) return;
    var id = refreshMyId();
    if (!id) { alert("Label5 se user id nahi mili"); return; }

    var saved = getData("mcq_saved");
    var exists = saved.some(function (s) { return s.uid === item.uid; });
    if (exists) {
      saved = saved.filter(function (s) { return s.uid !== item.uid; });
      btn.classList.remove("saved");
    } else {
      saved.push({ uid: item.uid, q: item.q });
      btn.classList.add("saved");
    }
    setData("mcq_saved", saved);

    if (db) {
      try {
        var ref = db.ref("Users/" + id + "/consume/savedMcq/" + item.uid);
        if (!exists) await ref.set({ ts: Math.floor(Date.now() / 1000) });
        else await ref.remove();
      } catch (e) {}
    }
  }

  // ---------- Firebase AFTER UI ready ----------
  function loadFirebaseLater() {
    if (window.firebase && firebase.apps && firebase.apps.length) {
      try { db = firebase.database(); } catch (e) {}
      return;
    }
    var s1 = document.createElement("script");
    s1.src = "https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js";
    s1.onload = function () {
      var s2 = document.createElement("script");
      s2.src = "https://www.gstatic.com/firebasejs/9.22.2/firebase-database-compat.js";
      s2.onload = function () {
        try {
          if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
          db = firebase.database();
        } catch (e) { console.log(e); }
      };
      document.head.appendChild(s2);
    };
    document.head.appendChild(s1);
  }

  // Wiki (light)
  async function showTopicInsight(qIndex, item) {
    var box = document.getElementById("insight-" + qIndex);
    if (!box || box.dataset.loaded === "1") return;
    box.classList.add("show");
    box.innerHTML = '<div style="font-size:.82rem;color:#65676b">Loading notes...</div>';
    try {
      var host = wikiLang === "hi" ? "https://hi.wikipedia.org" : "https://en.wikipedia.org";
      var subject = (item.subject || "").trim();
      var q = (item.q || "").replace(/[^\w\s\u0900-\u097F]/g, " ");
      var query = subject || q.split(/\s+/).filter(function (w) { return w.length > 3; }).slice(0, 5).join(" ") || "exam";
      var res = await fetch(host + "/w/api.php?action=query&list=search&srsearch=" + encodeURIComponent(query) + "&srlimit=4&format=json&origin=*");
      var data = await res.json();
      var results = (data.query && data.query.search) || [];
      if (!results.length) {
        box.innerHTML = '<div class="insight-title">ðŸ“š Topic</div><div style="font-size:.82rem;color:#65676b">No notes</div>';
        return;
      }
      var html = '<div class="insight-title">ðŸ“š Exam notes</div><div class="insight-scroll">';
      results.forEach(function (r) {
        html += '<div class="insight-card"><h4>' + escapeHTML(r.title) + '</h4><p>' +
          escapeHTML((r.snippet || "").replace(/<[^>]+>/g, "")) + '</p></div>';
      });
      html += '</div>';
      box.innerHTML = html;
      box.dataset.loaded = "1";
    } catch (e) {
      box.innerHTML = '<div style="font-size:.82rem;color:#65676b">Wiki failed</div>';
    }
  }

  function hideSheet() {
    document.getElementById("sheetOverlay").classList.remove("show");
    document.getElementById("sheetFrame").src = "about:blank";
  }
  function closeSheet(e) {
    if (e.target.id === "sheetOverlay") hideSheet();
  }

  refreshMyId();
  loadQuestions(); // pehle questions â€” Firebase baad
</script>
</body>
</html>
