  $("featToggle").onclick = function () { $("featDrop").classList.toggle("open"); };
  function bindDrop(toggleId, panelId) {
    var t = $(toggleId), p = $(panelId);
    if (t && p) t.onclick = function () { p.classList.toggle("open"); };
  }
  bindDrop("filterToggle", "filterDrop");
  bindDrop("analysisToggle", "analysisDrop");
  bindDrop("lbToggle", "lbDrop");

  function openViewer(title, url) {
    $("main-page").style.display = "none";
    $("viewer").style.display = "flex";
    $("viewer-title").textContent = title;
    $("loading").style.display = "flex";
