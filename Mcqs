<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>MCQ Practice</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:Inter,sans-serif;background:#f0f2f5;color:#050505;height:100vh;overflow:hidden}
#feedPage{height:100vh;display:flex;flex-direction:column}
.top-bar{background:#fff;border-bottom:1px solid #e4e6eb;padding:10px 12px;display:flex;justify-content:space-between;align-items:center}
.top-bar h1{font-size:1rem;font-weight:700}
.lang-switch{display:flex;background:#f0f2f5;border-radius:10px;padding:3px}
.lang-btn{border:0;background:transparent;padding:6px 12px;border-radius:8px;font-size:.8rem;font-weight:700;color:#65676b}
.lang-btn.active{background:#1877f2;color:#fff}
.feed{flex:1;overflow-y:auto;padding:12px;-webkit-overflow-scrolling:touch}
.post-card{background:#fff;border-radius:12px;padding:16px;margin-bottom:12px;box-shadow:0 1px 2px rgba(0,0,0,.08)}
.post-header{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.avatar{width:40px;height:40px;border-radius:50%;background:#e4e6eb;display:flex;align-items:center;justify-content:center;font-weight:700;color:#65676b}
.channel-info h3{font-size:.95rem;font-weight:600}
.channel-info p{font-size:.78rem;color:#65676b}
.question-text{font-size:1.05rem;line-height:1.45;margin-bottom:14px;font-weight:500}
.options{display:flex;flex-direction:column;gap:8px}
.option{border:1.5px solid #ccd0d5;border-radius:8px;padding:12px 14px;font-size:.95rem;cursor:pointer;background:#fff;word-break:break-word}
.option.correct{background:#e7f6ec;border-color:#31a24c;color:#31a24c;font-weight:600}
.option.wrong{background:#fde8e8;border-color:#e41e3f;color:#e41e3f}
.option.disabled{pointer-events:none}
.post-footer{margin-top:14px;padding-top:12px;border-top:1px solid #e4e6eb;font-size:.82rem;color:#65676b}
.loading{text-align:center;padding:40px;color:#65676b}
.error{text-align:center;padding:40px 14px;color:#b91c1c;font-size:.9rem}
.retry{margin-top:12px;border:0;background:#1877f2;color:#fff;padding:10px 16px;border-radius:10px;font-weight:700}
.insight-wrap{display:none;margin-top:14px;padding-top:12px;border-top:1px solid #e4e6eb}
.insight-wrap.show{display:block}
.insight-title{font-size:.82rem;font-weight:700;color:#1877f2;margin-bottom:8px}
.insight-scroll{display:flex;gap:10px;overflow-x:auto;padding-bottom:6px;scrollbar-width:none}
.insight-scroll::-webkit-scrollbar{display:none}
.insight-card{min-width:220px;max-width:240px;background:#f0f7ff;border:1px solid #dbeafe;border-radius:12px;padding:12px;flex-shrink:0;cursor:pointer}
.insight-card h4{font-size:.88rem;font-weight:700;margin-bottom:6px}
.insight-card p{font-size:.78rem;color:#4b5563;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}
.insight-card .open-hint{margin-top:8px;font-size:.72rem;font-weight:700;color:#1877f2}
.sheet-overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1000;display:none;align-items:flex-end;justify-content:center}
.sheet-overlay.show{display:flex}
.sheet{width:100%;max-width:700px;height:85vh;background:#fff;border-radius:18px 18px 0 0;display:flex;flex-direction:column;overflow:hidden}
.sheet-header{display:flex;align-items:center;gap:10px;padding:12px 14px;border-bottom:1px solid #e4e6eb;background:#f8fafc}
.sheet-header h3{flex:1;font-size:.95rem;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sheet-close{border:0;background:#e4e6eb;width:34px;height:34px;border-radius:10px}
.sheet-frame{flex:1;width:100%;border:0;display:none}
.sheet-loading{padding:20px;text-align:center;color:#65676b}
</style>
</head>
<body>
<div id="feedPage">
  <div class="top-bar">
    <h1>MCQ Practice</h1>
    <div class="lang-switch">
      <button class="lang-btn active" id="btn-en" type="button" onclick="setLang('en')">EN</button>
      <button class="lang-btn" id="btn-hi" type="button" onclick="setLang('hi')">हिं</button>
    </div>
  </div>
  <div class="feed" id="feed"><div class="loading">Loading questions...</div></div>
</div>

<div class="sheet-overlay" id="sheetOverlay" onclick="closeSheet(event)">
  <div class="sheet" onclick="event.stopPropagation()">
    <div class="sheet-header">
      <h3 id="sheetTitle">Topic</h3>
      <button class="sheet-close" type="button" onclick="hideSheet()">✕</button>
    </div>
    <div class="sheet-loading" id="sheetLoading">Opening...</div>
    <iframe class="sheet-frame" id="sheetFrame"></iframe>
  </div>
</div>

<script>
(function () {
  // ===== Questions API (fast) =====
  var API_URL = "https://script.google.com/macros/s/AKfycbyICNHxGGgvd7TBcgSxjQm3obJqDOGtHHiwiwUoXnxiNurmqmWDfwOXo5x9rfQqnXs/exec";

  var allQuestions = [];
  var wikiLang = "en";

  function setLang(lang) {
    wikiLang = lang;
    document.getElementById("btn-en").classList.toggle("active", lang === "en");
    document.getElementById("btn-hi").classList.toggle("active", lang === "hi");
  }
  window.setLang = setLang;

  function wikiHost() {
    return wikiLang === "hi" ? "https://hi.wikipedia.org" : "https://en.wikipedia.org";
  }

  function escapeHTML(v) {
    return String(v || "")
      .replace(/&/g, "&amp;").replace(/</g, "&lt;")
      .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }

  function buildSearchQuery(item) {
    var chapter = (item.chapter || "").trim();
    var subject = (item.subject || "").trim();
    var q = (item.q || "").replace(/[^\w\s\u0900-\u097F]/g, " ");
    var words = q.split(/\s+/).filter(function (w) { return w.length > 3; }).slice(0, 5).join(" ");
    if (chapter.length > 2) return chapter + (subject ? " " + subject : "");
    if (subject.length > 2) return subject + " " + words;
    return words || "general knowledge";
  }

  async function fetchWikipediaInsights(query) {
    var host = wikiHost();
    var searchUrl = host + "/w/api.php?action=query&list=search&srsearch=" +
      encodeURIComponent(query) + "&srlimit=4&format=json&origin=*";

    var searchRes = await fetch(searchUrl);
    if (!searchRes.ok) throw new Error("Wiki search failed");
    var searchData = await searchRes.json();
    var results = (searchData.query && searchData.query.search) || [];
    if (!results.length) return [];

    // Fast: summary only for top results (parallel)
    var tasks = results.slice(0, 4).map(function (r) {
      return fetch(host + "/api/rest_v1/page/summary/" + encodeURIComponent(r.title))
        .then(function (res) { return res.ok ? res.json() : null; })
        .then(function (sum) {
          if (!sum || sum.type === "disambiguation") return null;
          return {
            t: sum.title || r.title,
            d: sum.extract || (r.snippet || "").replace(/<[^>]+>/g, ""),
            pageUrl: host + "/wiki/" + encodeURIComponent((sum.title || r.title).replace(/ /g, "_"))
          };
        })
        .catch(function () { return null; });
    });

    var cards = await Promise.all(tasks);
    return cards.filter(Boolean);
  }

  async function showTopicInsight(qIndex, item) {
    var box = document.getElementById("insight-" + qIndex);
    if (!box || box.dataset.loaded === "1") return;

    box.classList.add("show");
    box.innerHTML = '<div style="font-size:.82rem;color:#65676b">' +
      (wikiLang === "hi" ? "विषय नोट्स लोड..." : "Loading exam notes...") +
      "</div>";

    try {
      var cards = await fetchWikipediaInsights(buildSearchQuery(item));
      if (!cards.length) {
        box.innerHTML = '<div class="insight-title">📚 Topic</div><div style="font-size:.82rem;color:#65676b">' +
          (wikiLang === "hi" ? "नहीं मिला" : "No related topic") + "</div>";
        return;
      }

      var title = wikiLang === "hi" ? "📚 परीक्षा नोट्स" : "📚 Exam notes";
      var openTxt = wikiLang === "hi" ? "पूरा पेज →" : "Open full page →";
      var html = '<div class="insight-title">' + title + '</div><div class="insight-scroll">';

      cards.forEach(function (c, idx) {
        html +=
          '<div class="insight-card" id="ic-' + qIndex + '-' + idx + '">' +
            '<h4>' + escapeHTML(c.t) + '</h4>' +
            '<p>' + escapeHTML(c.d) + '</p>' +
            '<div class="open-hint">' + openTxt + '</div>' +
          '</div>';
      });
      html += '</div>';
      box.innerHTML = html;
      box.dataset.loaded = "1";

      cards.forEach(function (c, idx) {
        var el = document.getElementById("ic-" + qIndex + "-" + idx);
        if (el) el.onclick = function () { openSheet(c.t, c.pageUrl); };
      });
    } catch (e) {
      box.innerHTML = '<div class="insight-title">📚 Topic</div><div style="font-size:.82rem;color:#65676b">Wiki load fail</div>';
    }
  }

  function openSheet(title, url) {
    document.getElementById("sheetTitle").textContent = title;
    document.getElementById("sheetOverlay").classList.add("show");
    var frame = document.getElementById("sheetFrame");
    var loading = document.getElementById("sheetLoading");
    loading.style.display = "block";
    frame.style.display = "none";
    frame.onload = function () {
      loading.style.display = "none";
      frame.style.display = "block";
    };
    frame.src = url;
  }
  function hideSheet() {
    document.getElementById("sheetOverlay").classList.remove("show");
    document.getElementById("sheetFrame").src = "about:blank";
  }
  function closeSheet(e) {
    if (e.target.id === "sheetOverlay") hideSheet();
  }
  window.hideSheet = hideSheet;
  window.closeSheet = closeSheet;

  // ===== FAST question load =====
  function loadQuestions() {
    var feed = document.getElementById("feed");
    feed.innerHTML = '<div class="loading">Loading questions...</div>';

    var done = false;
    var timer = setTimeout(function () {
      if (done) return;
      done = true;
      feed.innerHTML = '<div class="error">Timeout 15s<button class="retry" type="button" onclick="loadQuestions()">Retry</button></div>';
    }, 15000);

    var url = API_URL + (API_URL.indexOf("?") >= 0 ? "&" : "?") + "t=" + Date.now();

    fetch(url, { method: "GET", redirect: "follow", cache: "no-store" })
      .then(function (res) {
        if (!res.ok) throw new Error("HTTP " + res.status);
        return res.json();
      })
      .then(function (data) {
        if (done) return;
        clearTimeout(timer);
        done = true;

        if (data && Array.isArray(data.questions)) data = data.questions;
        if (data && Array.isArray(data.data)) data = data.data;
        if (!Array.isArray(data) || !data.length) throw new Error("No questions");

        allQuestions = data;
        renderFeed();
      })
      .catch(function (err) {
        if (done) return;
        clearTimeout(timer);
        done = true;
        feed.innerHTML = '<div class="error">Failed: ' + escapeHTML(err.message) +
          '<br><button class="retry" type="button" onclick="loadQuestions()">Retry</button></div>';
      });
  }
  window.loadQuestions = loadQuestions;

  function renderFeed() {
    var feed = document.getElementById("feed");
    feed.innerHTML = "";

    allQuestions.forEach(function (item, index) {
      var card = document.createElement("div");
      card.className = "post-card";

      var uname = item.username || "Educator";
      card.innerHTML =
        '<div class="post-header">' +
          '<div class="avatar">' + uname.charAt(0) + '</div>' +
          '<div class="channel-info">' +
            '<h3>' + escapeHTML(uname) + '</h3>' +
            '<p>' + escapeHTML(item.subject || "General") + ' • ' + escapeHTML(item.difficulty || "Medium") + '</p>' +
          '</div>' +
        '</div>' +
        '<div class="question-text"></div>' +
        '<div class="options" id="options-' + index + '"></div>' +
        '<div class="insight-wrap" id="insight-' + index + '"></div>' +
        '<div class="post-footer" id="answered-' + index + '">Tap option to answer</div>';

      card.querySelector(".question-text").textContent = item.q || "";

      var optBox = card.querySelector("#options-" + index);
      (item.options || []).forEach(function (opt, i) {
        var d = document.createElement("div");
        d.className = "option";
        d.textContent = opt || "—";
        d.onclick = function () { selectOption(index, i); };
        optBox.appendChild(d);
      });

      feed.appendChild(card);
    });
  }

  function selectOption(qIndex, selected) {
    var item = allQuestions[qIndex];
    var options = document.querySelectorAll("#options-" + qIndex + " .option");

    options.forEach(function (opt, i) {
      opt.classList.add("disabled");
      if (i === item.correct) opt.classList.add("correct");
      if (i === selected && selected !== item.correct) opt.classList.add("wrong");
    });

    var ans = document.getElementById("answered-" + qIndex);
    if (ans) ans.textContent = (selected === item.correct) ? "Correct ✓" : "Wrong ✗";

    // Wiki only after answer (fast feed load)
    showTopicInsight(qIndex, item);
  }

  loadQuestions();
})();
</script>
</body>
</html>
