  function normalizeMcq(raw){
    if(!raw||typeof raw!=="object") return null;
    var opts=raw.options;
    if(!opts||!opts.length){
      opts=[raw.optionA||raw.OPTIONA||"",raw.optionB||raw.OPTIONB||"",raw.optionC||raw.OPTIONC||"",raw.optionD||raw.OPTIOND||""];
    }
    var correct=raw.correct!=null?raw.correct:(raw.CORRECTANSWER||raw.correctAnswer||raw.answer);
    var map={A:0,B:1,C:2,D:3,a:0,b:1,c:2,d:3};
    if(typeof correct==="string"&&map[correct.trim()]!==undefined) correct=map[correct.trim()];
    else if(typeof correct==="string"&&/^\d+$/.test(correct)) correct=parseInt(correct,10);
    return {
      q:raw.q||raw.question||raw.Question||"", options:opts, correct:correct,
      username:raw.username||raw.channelName||"Educator",
      subject:raw.subject||"General", topic:raw.topic||raw.chapter||"", chapter:raw.chapter||raw.Chapter||raw.topic||"",
      difficulty:raw.difficulty||raw.level||"Medium",
      exam:raw.exam||raw.examName||"", year:raw.year||raw.pyqYear||"",
      shift:raw.shift||"", section:raw.section||"", source:raw.source||"",
