  function currentFilters() {
    return {
      exam: $("fExam").value,
      subject: $("fSubject").value,
      topic: $("fTopic").value,
      level: $("fLevel").value,
      year: $("fYear").value,
      shift: $("fShift").value,
      section: $("fSection").value,
      source: $("fSource").value,
      language: $("fLang").value,
      type: $("fType").value || "All",
      limit: 40
    };
  }

  function buildMcqUrl(filters) {
    var u = MCQ_API + (MCQ_API.indexOf("?") >= 0 ? "&" : "?");
    var q = ["action=questions", "t=" + Date.now()];
    Object.keys(filters).forEach(function (k) {
      if (filters[k] !== "" && filters[k] != null && k !== "type")
        q.push(encodeURIComponent(k) + "=" + encodeURIComponent(filters[k]));
    });
    return u + q.join("&");
  }

  /* ===== User / analysis / leaderboard ===== */
  function normalizeAnalysis(raw) {
    var a = emptyAnalysis();
    if (!raw || typeof raw !== "object") return a;
    ["allTime", "today"].forEach(function (k) {
      if (raw[k]) {
        a[k].attempted = Number(raw[k].attempted) || 0;
        a[k].correct = Number(raw[k].correct) || 0;
        a[k].wrong = Number(raw[k].wrong) || 0;
        a[k].accuracy = calcAcc(a[k].correct, a[k].attempted);
        if (k === "today") a.today.date = raw.today.date || "";
      }
    });
    ["subjects", "topics", "exams", "pyqYears"].forEach(function (bucket) {
      if (raw[bucket] && typeof raw[bucket] === "object") {
        Object.keys(raw[bucket]).forEach(function (key) {
          var s = raw[bucket][key] || {};
          a[bucket][key] = {
            attempted: Number(s.attempted) || 0,
            correct: Number(s.correct) || 0,
            wrong: Number(s.wrong) || 0,
            accuracy: calcAcc(Number(s.correct) || 0, Number(s.attempted) || 0)
          };
        });
      }
    });
    return a;
  }

  function renderStats() {
    var at = analysis.allTime;
    $("stAttempted").textContent = at.attempted || 0;
    $("stCorrect").textContent = at.correct || 0;
    $("stWrong").textContent = at.wrong || 0;
    $("stAccuracy").textContent = (at.accuracy || 0) + "%";
    var mini = $("stAccuracyMini");
    if (mini) mini.textContent = (at.accuracy || 0) + "%";
    renderAnalysisBars();
  }

  function renderAnalysisBars() {
    var mode = $("analysisMode").value;
    var map = analysis.subjects;
    if (mode === "topic") map = analysis.topics;
    if (mode === "exam") map = analysis.exams;
    if (mode === "pyq") map = analysis.pyqYears;

    var entries = Object.keys(map || {}).map(function (k) {
      return { k: k, v: map[k] };
    }).filter(function (e) { return e.v.attempted > 0; });
    entries.sort(function (a, b) { return b.v.attempted - a.v.attempted; });

    var box = $("analysisBars");
    if (!entries.length) {
      box.innerHTML = '<div style="font-size:.8rem;color:#64748b">Attempt questions to see breakdown</div>';
      return;
    }
    var max = entries[0].v.attempted || 1;
    box.innerHTML = entries.slice(0, 8).map(function (e) {
      var pct = Math.round((e.v.attempted / max) * 100);
      return '<div class="bar-row"><div class="bar-top"><b>' + escapeHTML(e.k) +
        "</b><span>" + e.v.accuracy + "% · " + e.v.attempted + ' Q</span></div>' +
        '<div class="track"><div class="fill" style="width:' + pct + '%"></div></div></div>';
    }).join("");
  }
  $("analysisMode").onchange = renderAnalysisBars;

  async function loadCurrentUser() {
    userId = getWebViewString();
    if (userId.indexOf("|") > 0) userId = userId.split("|").pop();
    if (userId.indexOf("@") > 0) userId = userId.split("@")[0];
    userId = userId.replace(/[.#$\[\]\/]/g, "_").trim();
    if (!userId) {
      await new Promise(function (r) { setTimeout(r, 400); });
      userId = getWebViewString();
      if (userId.indexOf("|") > 0) userId = userId.split("|").pop();
      if (userId.indexOf("@") > 0) userId = userId.split("@")[0];
      userId = String(userId || "").replace(/[.#$\[\]\/]/g, "_").trim();
    }
    if (!userId) return;
    try {
      var data = await firebaseGet("Users/" + safeKey(userId));
      if (data && typeof data === "object") {
        userName = (data.profile && (data.profile.name || data.profile.channelName)) || userId;
        likedQuestions = data.likedQuestions || (data.consume && data.consume.likedMcq) || {};
        savedQuestions = data.savedQuestions || (data.consume && data.consume.savedMcq) || {};
        revisionQuestions = data.revisionQuestions || {};
        followedUsers = data.following || {};
        analysis = normalizeAnalysis(data.analysis);
      }
      renderStats();
      refreshActionStates();
    } catch (e) { console.warn(e); }
  }

  function bumpBucket(bucket, key, isCorrect) {
    if (!key) return;
    if (!bucket[key]) bucket[key] = { attempted: 0, correct: 0, wrong: 0, accuracy: 0 };
    bucket[key].attempted++;
    if (isCorrect) bucket[key].correct++; else bucket[key].wrong++;
    bucket[key].accuracy = calcAcc(bucket[key].correct, bucket[key].attempted);
  }

  async function recordAnswer(item, isCorrect) {
    var qid = getQid(item) || ("tmp_" + Date.now());
    if (sessionAnswered[qid]) return;
    sessionAnswered[qid] = true;

    var subject = getSubject(item);
    var topic = getTopic(item) || "General";
    var exam = getExam(item) || "General";
    var year = getYear(item);
    var today = todayStr();

    if (!analysis.today || analysis.today.date !== today) {
      analysis.today = { date: today, attempted: 0, correct: 0, wrong: 0, accuracy: 0 };
    }
    analysis.allTime.attempted++;
    analysis.today.attempted++;
    if (isCorrect) { analysis.allTime.correct++; analysis.today.correct++; }
    else { analysis.allTime.wrong++; analysis.today.wrong++; }
    analysis.allTime.accuracy = calcAcc(analysis.allTime.correct, analysis.allTime.attempted);
    analysis.today.accuracy = calcAcc(analysis.today.correct, analysis.today.attempted);

    bumpBucket(analysis.subjects, subject, isCorrect);
    bumpBucket(analysis.topics, topic, isCorrect);
    bumpBucket(analysis.exams, exam, isCorrect);
    if (year) bumpBucket(analysis.pyqYears, String(year), isCorrect);

    /* wrong → auto revision by qid */
    if (!isCorrect && qid) {
      revisionQuestions[qid] = true;
    }

    renderStats();
    if (!userId) return;

    try {
      var base = "Users/" + safeKey(userId) + "/analysis";
      var values = {};
      values[base + "/allTime"] = analysis.allTime;
      values[base + "/today"] = analysis.today;
      values[base + "/subjects/" + safeKey(subject)] = analysis.subjects[subject];
      values[base + "/topics/" + safeKey(topic)] = analysis.topics[topic];
      values[base + "/exams/" + safeKey(exam)] = analysis.exams[exam];
      if (year) values[base + "/pyqYears/" + safeKey(year)] = analysis.pyqYears[year];
      values[base + "/lastAnswer"] = { qid: qid, subject: subject, topic: topic, exam: exam, year: year || null, correct: !!isCorrect, ts: Date.now() };
      if (!isCorrect && qid) {
        values["Users/" + safeKey(userId) + "/revisionQuestions/" + safeKey(qid)] = true;
      }
      /* leaderboard entry */
      values["leaderboard/" + safeKey(userId)] = {
        name: userName || userId,
        accuracy: analysis.allTime.accuracy,
        attempted: analysis.allTime.attempted,
        correct: analysis.allTime.correct,
        ts: Date.now()
      };
      await firebasePatch(values);
      loadLeaderboard();
    } catch (e) { console.warn("Analysis save failed", e); }
  }

  async function loadLeaderboard() {
    var box = $("leaderboard");
    try {
      var data = await firebaseGet("leaderboard");
      if (!data || typeof data !== "object") {
        box.innerHTML = '<div style="font-size:.8rem;color:#64748b">No leaderboard data yet</div>';
        return;
      }
      var mode = $("lbMode").value;
      var rows = Object.keys(data).map(function (id) {
        var x = data[id] || {};
        return {
          id: id,
          name: x.name || id,
          accuracy: Number(x.accuracy) || 0,
          attempted: Number(x.attempted) || 0
        };
      }).filter(function (r) { return r.attempted >= 3; });

      rows.sort(function (a, b) {
        if (mode === "attempted") return b.attempted - a.attempted;
        if (b.accuracy !== a.accuracy) return b.accuracy - a.accuracy;
        return b.attempted - a.attempted;
      });
      rows = rows.slice(0, 10);
      if (!rows.length) {
        box.innerHTML = '<div style="font-size:.8rem;color:#64748b">Need ≥3 attempts to rank</div>';
        return;
      }
      box.innerHTML = rows.map(function (r, i) {
        return '<div class="lb-row"><div class="lb-rank">' + (i + 1) + "</div><b>" +
          escapeHTML(r.name) + "</b><span>" + r.accuracy + "% · " + r.attempted + "Q</span></div>";
      }).join("");
    } catch (e) {
      box.innerHTML = '<div style="font-size:.8rem;color:#64748b">Leaderboard unavailable</div>';
    }
  }
  $("lbMode").onchange = loadLeaderboard;

  /* ===== Save / Like / Follow — IDs only ===== */
  async function setUserFlag(path, key, enabled) {
    if (!userId || !key) {
      alert("User ID nahi mili (WebViewString).");
      return false;
    }
    try {
      var values = {};
      values["Users/" + safeKey(userId) + "/" + path + "/" + safeKey(key)] = enabled ? true : null;
      await firebasePatch(values);
      return true;
    } catch (e) {
      alert("Save failed");
      return false;
    }
  }

  async function toggleSave(qid, btn) {
    if (!qid) return;
    var next = !Boolean(savedQuestions[qid]);
    var ok = await setUserFlag("savedQuestions", qid, next);
    if (!ok) return;
    if (next) savedQuestions[qid] = true; else delete savedQuestions[qid];
    btn.classList.toggle("active", next);
    btn.textContent = next ? "✓ Saved" : "Save";
  }

  async function toggleLike(qid, btn) {
    if (!qid) return;
    var next = !Boolean(likedQuestions[qid]);
    var ok = await setUserFlag("likedQuestions", qid, next);
    if (!ok) return;
