<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Feed</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #fafafa;
            color: #111;
            font-family: Arial, Helvetica, sans-serif;
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 100;
            height: 60px;
            background: white;
            border-bottom: 1px solid #ddd;

            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo {
            font-size: 22px;
            font-weight: 700;
        }

        .feed {
            width: 100%;
            max-width: 600px;
            margin: 25px auto;
        }

        .post {
            background: white;
            border: 1px solid #ddd;
            border-radius: 8px;
            margin-bottom: 25px;
            overflow: hidden;
        }

        .post-header {
            height: 58px;
            display: flex;
            align-items: center;
            padding: 10px 14px;
        }

        .avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(
                135deg,
                #ffdc80,
                #fcaf45,
                #f77737,
                #e1306c,
                #c13584,
                #833ab4
            );

            display: flex;
            align-items: center;
            justify-content: center;

            color: white;
            font-weight: bold;
            margin-right: 10px;
        }

        .username {
            font-weight: 600;
            font-size: 14px;
        }

        .time {
            color: #888;
            font-size: 12px;
            margin-left: 8px;
        }

        .post-image {
            width: 100%;
            display: block;
            max-height: 700px;
            object-fit: cover;
            background: #eee;
        }

        .post-content {
            padding: 12px 14px 16px;
        }

        .actions {
            display: flex;
            gap: 18px;
            margin-bottom: 10px;
        }

        .action {
            border: none;
            background: none;
            padding: 0;
            cursor: pointer;
            font-size: 25px;
        }

        .action.like.active {
            color: #ed4956;
        }

        .likes {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .title {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .description {
            font-size: 14px;
            line-height: 1.5;
            color: #333;
        }

        .comments {
            margin-top: 10px;
            color: #777;
            font-size: 13px;
        }

        .loading {
            text-align: center;
            padding: 60px 20px;
            color: #777;
        }

        .error {
            background: #fff;
            border: 1px solid #e33;
            color: #c00;
            padding: 20px;
            margin: 30px auto;
            max-width: 600px;
            border-radius: 8px;
        }

        @media (max-width: 650px) {
            .feed {
                margin: 0 auto;
            }

            .post {
                border-left: 0;
                border-right: 0;
                border-radius: 0;
                margin-bottom: 15px;
            }

            .post-image {
                max-height: 600px;
            }
        }
    </style>
</head>

<body>

    <header class="topbar">
        <div class="logo">My Feed</div>
    </header>

    <main id="feed" class="feed">
        <div class="loading">
            Loading posts...
        </div>
    </main>


    <script>

        // =====================================================
        // CHANGE ONLY THIS URL
        // =====================================================

        const API_URL =
            "https://script.google.com/macros/s/AKfycbzVYw5uC-1sASG-6BAMChC3JhCqKK-0LHMgmkQjEmAolRF8_3ozyETPH6cEWBVqDil3/exec";


        // =====================================================
        // LOAD POSTS
        // =====================================================

        async function loadPosts() {

            const feed = document.getElementById("feed");

            try {

                const response = await fetch(API_URL);

                if (!response.ok) {
                    throw new Error("API request failed");
                }

                const data = await response.json();

                if (!data.success) {
                    throw new Error("API returned an error");
                }

                feed.innerHTML = "";

                if (!data.posts || data.posts.length === 0) {

                    feed.innerHTML = `
                        <div class="loading">
                            No posts found.
                        </div>
                    `;

                    return;
                }

                data.posts.forEach(post => {
                    createPost(post);
                });

            } catch (error) {

                console.error(error);

                feed.innerHTML = `
                    <div class="error">
                        <strong>Unable to load posts.</strong>
                        <br><br>
                        Check your Apps Script URL and deployment settings.
                    </div>
                `;
            }
        }


        // =====================================================
        // CREATE POST
        // =====================================================

        function createPost(post) {

            const feed = document.getElementById("feed");

            const postElement = document.createElement("article");

            postElement.className = "post";

            postElement.innerHTML = `

                <div class="post-header">

                    <div class="avatar">
                        ${escapeHTML(post.username.charAt(0).toUpperCase())}
                    </div>

                    <div>
                        <span class="username">
                            ${escapeHTML(post.username)}
                        </span>

                        <span class="time">
                            ${escapeHTML(post.time)}
                        </span>
                    </div>

                </div>


                <img
                    class="post-image"
                    src="${escapeAttribute(post.image)}"
                    alt="${escapeAttribute(post.title)}"
                    loading="lazy"
                    onerror="this.style.display='none'"
                >


                <div class="post-content">

                    <div class="actions">

                        <button
                            class="action like"
                            onclick="toggleLike(this, ${post.likes})"
                            aria-label="Like"
                        >
                            ♡
                        </button>

                        <button
                            class="action"
                            onclick="sharePost()"
                            aria-label="Share"
                        >
                            ♢
                        </button>

                    </div>


                    <div class="likes">
                        <span class="like-count">
                            ${formatNumber(post.likes)}
                        </span>
                        likes
                    </div>


                    <div class="title">
                        ${escapeHTML(post.title)}
                    </div>


                    <div class="description">
                        ${escapeHTML(post.description)}
                    </div>


                    <div class="comments">
                        View all ${formatNumber(post.comments)} comments
                    </div>

                </div>
            `;

            feed.appendChild(postElement);
        }


        // =====================================================
        // LIKE BUTTON
        // =====================================================

        function toggleLike(button, originalLikes) {

            const post = button.closest(".post");

            const countElement =
                post.querySelector(".like-count");

            let current =
                parseInt(
                    countElement.textContent.replace(/,/g, "")
                );

            if (button.classList.contains("active")) {

                button.classList.remove("active");

                button.innerHTML = "♡";

                current--;

            } else {

                button.classList.add("active");

                button.innerHTML = "♥";

                current++;
            }

            countElement.textContent =
                formatNumber(current);
        }


        // =====================================================
        // SHARE
        // =====================================================

        function sharePost() {

            if (navigator.share) {

                navigator.share({
                    title: document.title,
                    url: window.location.href
                });

            } else {

                navigator.clipboard.writeText(
                    window.location.href
                );

                alert("Link copied!");
            }
        }


        // =====================================================
        // NUMBER FORMAT
        // =====================================================

        function formatNumber(number) {

            return Number(number).toLocaleString();
        }


        // =====================================================
        // SECURITY HELPERS
        // =====================================================

        function escapeHTML(value) {

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }


        function escapeAttribute(value) {

            return escapeHTML(value);
        }


        // =====================================================
        // START
        // =====================================================

        loadPosts();

    </script>

</body>
</html>


