<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Plans</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;
  background:#f3f6fb;
  color:#0f172a;
  min-height:100vh;
}
.wrap{
  max-width:480px;
  margin:0 auto;
  padding:18px 16px 40px;
}
.hero{
  text-align:center;
  margin-bottom:18px;
}
.hero h1{
  font-size:1.45rem;
  font-weight:800;
  letter-spacing:-0.3px;
}
.hero p{
  margin-top:6px;
  color:#64748b;
  font-size:0.9rem;
  line-height:1.5;
}
.plan{
  background:#fff;
  border:1px solid #e7eef8;
  border-radius:22px;
  padding:18px;
  margin-bottom:14px;
  box-shadow:0 10px 28px rgba(15,23,42,0.06);
  position:relative;
  overflow:hidden;
}
.plan.popular{
  border:2px solid #2563eb;
  background:linear-gradient(180deg,#ffffff 0%,#f8fbff 100%);
}
.tag{
  position:absolute;
  top:14px;
  right:14px;
  background:#2563eb;
  color:#fff;
  font-size:0.7rem;
  font-weight:700;
  padding:5px 9px;
  border-radius:999px;
}
.plan-name{
  font-size:1.05rem;
  font-weight:800;
  margin-bottom:4px;
}
.plan-desc{
  color:#64748b;
  font-size:0.82rem;
  margin-bottom:14px;
}
.price-row{
  display:flex;
  align-items:flex-end;
  gap:6px;
  margin-bottom:4px;
}
.price{
  font-size:2rem;
  font-weight:800;
  color:#0f172a;
  line-height:1;
}
.period{
  color:#64748b;
  font-size:0.85rem;
  margin-bottom:4px;
}
.old-price{
  color:#94a3b8;
  text-decoration:line-through;
  font-size:0.85rem;
  margin-bottom:14px;
}
.features{
  list-style:none;
  margin:14px 0 16px;
}
.features li{
  display:flex;
  gap:10px;
  align-items:flex-start;
  padding:8px 0;
  font-size:0.9rem;
  color:#334155;
  border-top:1px solid #f1f5f9;
}
.features li:first-child{border-top:0}
.check{
  width:20px;
  height:20px;
  border-radius:50%;
  background:#e8f9ee;
  color:#16a34a;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:12px;
  font-weight:700;
  flex-shrink:0;
  margin-top:1px;
}
.btn{
  width:100%;
  border:0;
  border-radius:14px;
  padding:14px;
  font-size:0.95rem;
  font-weight:700;
  cursor:pointer;
}
.btn-primary{
  background:linear-gradient(135deg,#2563eb,#4f46e5);
  color:#fff;
  box-shadow:0 8px 18px rgba(37,99,235,0.25);
}
.btn-soft{
  background:#f1f5f9;
  color:#0f172a;
}
.btn:active{transform:scale(0.98)}
.note{
  text-align:center;
  margin-top:10px;
  color:#94a3b8;
  font-size:0.78rem;
}
.free-banner{
  background:linear-gradient(135deg,#0f172a,#1e293b);
  color:#fff;
  border-radius:22px;
  padding:18px;
  margin-bottom:14px;
}
.free-banner h3{
  font-size:1.05rem;
  margin-bottom:6px;
}
.free-banner p{
  color:#cbd5e1;
  font-size:0.84rem;
  line-height:1.5;
  margin-bottom:14px;
}
</style>
</head>
<body>
<div class="wrap">

  <div class="hero">
    <h1>Choose Your Plan</h1>
    <p>Unlock mock tests, analysis and premium study tools</p>
  </div>

  <div class="free-banner">
    <h3>Free Starter</h3>
    <p>Practice limited tests, basic analysis and free tools. Upgrade anytime.</p>
    <button class="btn btn-soft" onclick="selectPlan('free')">Continue Free</button>
  </div>

  <div class="plan">
    <div class="plan-name">Monthly</div>
    <div class="plan-desc">Best for short-term exam prep</div>
    <div class="price-row">
      <div class="price">₹99</div>
      <div class="period">/ month</div>
    </div>
    <div class="old-price">₹199</div>
    <ul class="features">
      <li><span class="check">✓</span><span>Full length mock tests</span></li>
      <li><span class="check">✓</span><span>Subject-wise practice</span></li>
      <li><span class="check">✓</span><span>Performance analysis</span></li>
      <li><span class="check">✓</span><span>Saved questions sync</span></li>
    </ul>
    <button class="btn btn-primary" onclick="selectPlan('monthly')">Get Monthly</button>
  </div>

  <div class="plan popular">
    <div class="tag">Most Popular</div>
    <div class="plan-name">Yearly</div>
    <div class="plan-desc">Best value for serious aspirants</div>
    <div class="price-row">
      <div class="price">₹499</div>
      <div class="period">/ year</div>
    </div>
    <div class="old-price">₹1199</div>
    <ul class="features">
      <li><span class="check">✓</span><span>Everything in Monthly</span></li>
      <li><span class="check">✓</span><span>Priority new mock tests</span></li>
      <li><span class="check">✓</span><span>Advanced analysis insights</span></li>
      <li><span class="check">✓</span><span>Ad-free experience</span></li>
      <li><span class="check">✓</span><span>Save more than 60%</span></li>
    </ul>
    <button class="btn btn-primary" onclick="selectPlan('yearly')">Get Yearly</button>
  </div>

  <div class="plan">
    <div class="plan-name">Lifetime</div>
    <div class="plan-desc">One-time payment, lifetime access</div>
    <div class="price-row">
      <div class="price">₹999</div>
      <div class="period">one time</div>
    </div>
    <div class="old-price">₹2499</div>
    <ul class="features">
      <li><span class="check">✓</span><span>All premium features forever</span></li>
      <li><span class="check">✓</span><span>Future content included</span></li>
      <li><span class="check">✓</span><span>No recurring payment</span></li>
      <li><span class="check">✓</span><span>Best for long-term use</span></li>
    </ul>
    <button class="btn btn-primary" onclick="selectPlan('lifetime')">Get Lifetime</button>
  </div>

  <p class="note">Cancel anytime on monthly plan • Secure payment</p>
</div>

<script>
function selectPlan(plan){
  var msg = "PLAN|" + plan;
  try{
    if(window.Kodular && window.Kodular.setWebViewString){
      window.Kodular.setWebViewString(msg);
    }
    if(window.AppInventor && window.AppInventor.setWebViewString){
      window.AppInventor.setWebViewString(msg);
    }
  }catch(e){}
  alert("Selected: " + plan);
}
</script>
</body>
</html>
