  async function loadMixedFeed(){
    var box=$("mixedFeed");
    box.innerHTML='<div class="loading">Loading practice…</div>';
    renderAds();
    var filters=currentFilters();
    try{
      var tasks=[];
      if(filters.type!=="Post"&&filters.type!=="OneLiner")
        tasks.push(fetch(buildMcqUrl(filters),{cache:"no-store",redirect:"follow"}).then(function(r){ if(!r.ok) throw new Error("MCQ "+r.status); return r.json(); }));
      else tasks.push(Promise.resolve([]));
      if(filters.type!=="MCQ"&&filters.type!=="OneLiner")
        tasks.push(fetch(POSTS_API+(POSTS_API.indexOf("?")>=0?"&":"?")+"t="+Date.now(),{cache:"no-store",redirect:"follow"}).then(function(r){ if(!r.ok) throw new Error("Posts "+r.status); return r.json(); }));
      else tasks.push(Promise.resolve([]));
      if(filters.type==="All"||filters.type==="OneLiner") tasks.push(loadOneLiners());
      else tasks.push(Promise.resolve([]));

      var results=await Promise.allSettled(tasks);
      allMcqs=[]; allPosts=[]; allOneLiners=[];
      if(results[0].status==="fulfilled"){
        var d=results[0].value;
        if(d&&Array.isArray(d.questions)) d=d.questions; else if(d&&Array.isArray(d.data)) d=d.data;
        if(Array.isArray(d)) allMcqs=d.map(normalizeMcq).filter(Boolean);
      }
      if(results[1].status==="fulfilled"){
        var p=results[1].value;
        if(p&&p.success&&Array.isArray(p.posts)) allPosts=p.posts;
        else if(Array.isArray(p)) allPosts=p;
        else if(p&&Array.isArray(p.data)) allPosts=p.data;
      }
      if(results[2].status==="fulfilled") allOneLiners=results[2].value||[];

      allMcqs.forEach(function(q){
        if(q.exam&&filterMeta.exams.indexOf(q.exam)<0) filterMeta.exams.push(q.exam);
        if(q.subject&&filterMeta.subjects.indexOf(q.subject)<0) filterMeta.subjects.push(q.subject);
        if(q.topic&&filterMeta.topics.indexOf(q.topic)<0) filterMeta.topics.push(q.topic);
        if(q.year&&filterMeta.years.indexOf(String(q.year))<0) filterMeta.years.push(String(q.year));
      });
      applyMeta();
      if(!allMcqs.length&&!allPosts.length&&!allOneLiners.length){
        box.innerHTML='<div class="error">No questions<br><button class="retry" type="button" id="retryFeed">Reset</button></div>';
        $("retryFeed").onclick=function(){ $("btnReset").click(); };
        return;
      }
      renderFeed(filters.type);
    }catch(e){
      box.innerHTML='<div class="error">Failed: '+escapeHTML(e.message||e)+'<br><button class="retry" type="button" id="retryFeed">Retry</button></div>';
      $("retryFeed").onclick=loadMixedFeed;
    }
  }

  function matchFilter(item,f){
    function has(field,val){ if(!val) return true; return String(field||"").toLowerCase()===String(val).toLowerCase(); }
    if(!has(item.exam,f.exam)) return false;
    if(!has(item.subject,f.subject)) return false;
    if(f.topic&&String(item.topic||"").toLowerCase().indexOf(String(f.topic).toLowerCase())<0) return false;
    if(f.level&&String(item.difficulty||"").toLowerCase()!==String(f.level).toLowerCase()) return false;
    if(f.year&&String(item.year||"")!==String(f.year)) return false;
    if(f.source&&String(item.source||"").toLowerCase().indexOf(String(f.source).toLowerCase())<0) return false;
    return true;
  }
function renderFeed(type){
    var box=$("mixedFeed");
    var filters=currentFilters();
    type=type||filters.type||"All";
    var mcqs=allMcqs.filter(function(q){ return matchFilter(q,filters); });
    var posts=allPosts.slice(), ols=allOneLiners.slice();
    mcqs=shuffle(mcqs); posts=shuffle(posts); ols=shuffle(ols);
    if(type==="MCQ"){ posts=[]; ols=[]; }
    if(type==="Post"){ mcqs=[]; ols=[]; }
    if(type==="OneLiner"){ mcqs=[]; posts=[]; }
    if(!mcqs.length&&!posts.length&&!ols.length){
      box.innerHTML='<div class="error">No questions for filter<br><button class="retry" type="button" id="retryFeed">Reset</button></div>';
      var rb=$("retryFeed"); if(rb) rb.onclick=function(){ $("btnReset").click(); };
      return;
    }
    box.innerHTML="";
    var byTopic={}, noTopic=[];
    mcqs.forEach(function(q){ var t=(q.topic||"").trim(); if(!t){ noTopic.push(q); return; } if(!byTopic[t]) byTopic[t]=[]; byTopic[t].push(q); });
    Object.keys(byTopic).forEach(function(t){
      if(byTopic[t].length>=2){
        var block=document.createElement("div"); block.className="topic-block";
        block.innerHTML='<div class="topic-head"><b>'+escapeHTML(t)+'</b><span>'+byTopic[t].length+' · swipe</span></div>';
        var sc=document.createElement("div"); sc.className="topic-scroll";
        byTopic[t].slice(0,10).forEach(function(q,i){ sc.appendChild(renderMcq(q,"t_"+domId(t)+"_"+i)); });
        block.appendChild(sc); box.appendChild(block);
      } else noTopic=noTopic.concat(byTopic[t]);
    });
    var items=[];
    shuffle(noTopic).slice(0,18).forEach(function(q,i){ items.push({type:"mcq",data:q,index:"m_"+i}); });
    posts.slice(0,8).forEach(function(p){ items.push({type:"post",data:p}); });
    ols.slice(0,10).forEach(function(ol,i){ items.push({type:"ol",data:ol,index:"ol_"+i}); });
    shuffle(items).forEach(function(it){
      if(it.type==="mcq") box.appendChild(renderMcq(it.data,it.index));
      else if(it.type==="post") box.appendChild(renderPost(it.data));
      else box.appendChild(renderOneLiner(it.data,it.index));
    });
  }

  function examTagsHtml(item){
    var chips=[]; if(item.exam) chips.push(item.exam); if(item.year) chips.push("PYQ "+item.year);
    if(!chips.length) chips.push(item.subject||"Practice");
    return chips.map(function(c,i){ return '<span class="exam-chip'+(i&&/PYQ/i.test(c)?' py':'')+'">'+escapeHTML(String(c))+'</span>'; }).join("");
