<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>MCQ Practice</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      background: #f0f2f5;
      color: #050505;
      height: 100vh;
      overflow: hidden;
    }
    #feedPage {
      height: 100vh;
      display: flex;
      flex-direction: column;
      background: #f0f2f5;
    }
    .top-bar {
      background: #fff;
      border-bottom: 1px solid #e4e6eb;
      padding: 10px 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .top-bar h1 {
      font-size: 1rem;
      font-weight: 700;
    }
    .lang-switch {
      display: flex;
      background: #f0f2f5;
      border-radius: 10px;
      padding: 3px;
      gap: 2px;
    }
    .lang-btn {
      border: 0;
      background: transparent;
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 700;
      color: #65676b;
      cursor: pointer;
    }
    .lang-btn.active {
      background: #1877f2;
      color: #fff;
    }
    .feed {
      flex: 1;
      overflow-y: auto;
      padding: 12px;
      -webkit-overflow-scrolling: touch;
    }
    .post-card {
      background: white;
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 12px;
      box-shadow: 0 1px 2px rgba(0,0,0,0.08);
    }
    .post-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }
    .avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #e4e6eb;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      color: #65676b;
      font-size: 0.9rem;
    }
    .channel-info h3 { font-size: 0.95rem; font-weight: 600; }
    .channel-info p { font-size: 0.78rem; color: #65676b; }
    .question-text {
      font-size: 1.05rem;
      line-height: 1.45;
      margin-bottom: 14px;
      font-weight: 500;
    }
    .options { display: flex; flex-direction: column; gap: 8px; }
    .option {
      border: 1.5px solid #ccd0d5;
      border-radius: 8px;
      padding: 12px 14px;
      font-size: 0.95rem;
      cursor: pointer;
      background: white;
      word-break: break-word;
    }
    .option:active { background: #f0f2f5; }
    .option.correct {
      background: #e7f6ec;
      border-color: #31a24c;
      color: #31a24c;
      font-weight: 600;
    }
    .option.wrong {
      background: #fde8e8;
      border-color: #e41e3f;
      color: #e41e3f;
    }
    .option.disabled { pointer-events: none; }
    .post-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px solid #e4e6eb;
    }
    .answered { font-size: 0.82rem; color: #65676b; }
    .actions { display: flex; gap: 18px; }
    .action-btn {
      background: none;
      border: none;
      font-size: 1.25rem;
      cursor: pointer;
      color: #65676b;
    }
    .action-btn.liked { color: #e41e3f; }
    .action-btn.saved { color: #1877f2; }
    .loading { text-align: center; padding: 40px; color: #65676b; }

    /* Insight */
    .insight-wrap {
      display: none;
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px solid #e4e6eb;
    }
    .insight-wrap.show { display: block; }
    .insight-title {
      font-size: 0.82rem;
      font-weight: 700;
      color: #1877f2;
      margin-bottom: 8px;
    }
    .insight-scroll {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      padding-bottom: 6px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .insight-scroll::-webkit-scrollbar { display: none; }
    .insight-card {
      min-width: 220px;
      max-width: 240px;
      background: #f0f7ff;
      border: 1px solid #dbeafe;
      border-radius: 12px;
      padding: 12px;
      flex-shrink: 0;
      cursor: pointer;
    }
    .insight-card:active { transform: scale(0.98); }
    .insight-card h4 {
      font-size: 0.88rem;
      font-weight: 700;
      margin-bottom: 6px;
      color: #0f172a;
    }
    .insight-card p {
      font-size: 0.78rem;
      line-height: 1.4;
      color: #4b5563;
      display: -webkit-box;
      -webkit-line-clamp: 4;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .insight-card .open-hint {
      margin-top: 8px;
      font-size: 0.72rem;
      font-weight: 700;
      color: #1877f2;
    }
    .insight-loading { font-size: 0.82rem; color: #65676b; padding: 6px 0; }

    /* Bottom sheet */
    .sheet-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.45);
      z-index: 1000;
      display: none;
      align-items: flex-end;
      justify-content: center;
    }
    .sheet-overlay.show { display: flex; }
    .sheet {
      width: 100%;
      max-width: 700px;
      height: 85vh;
      background: #fff;
      border-radius: 18px 18px 0 0;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      animation: sheetUp 0.25s ease;
    }
    @keyframes sheetUp {
      from { transform: translateY(40px); opacity: 0.6; }
      to { transform: translateY(0); opacity: 1; }
    }
    .sheet-header {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 14px;
      border-bottom: 1px solid #e4e6eb;
      background: #f8fafc;
    }
    .sheet-header h3 {
      flex: 1;
      font-size: 0.95rem;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .sheet-close {
      border: 0;
      background: #e4e6eb;
      width: 34px;
      height: 34px;
      border-radius: 10px;
      font-size: 16px;
      cursor: pointer;
    }
    .sheet-frame {
      flex: 1;
      width: 100%;
      border: 0;
    }
    .sheet-loading {
      padding: 20px;
      text-align: center;
      color: #65676b;
      font-size: 0.9rem;
    }
  </style>
</head>
<body>
  <div id="feedPage">
    <div class="top-bar">
      <h1>MCQ Practice</h1>
      <div class="lang-switch">
        <button class="lang-btn active" id="btn-en" onclick="setLang('en')">EN</button>
        <button class="lang-btn" id="btn-hi" onclick="setLang('hi')">हिं</button>
      </div>
    </div>

    <div class="feed" id="feed">
      <div class="loading">Loading questions...</div>
    </div>
  </div>

  <!-- Bottom sheet for full Wikipedia -->
  <div class="sheet-overlay" id="sheetOverlay" onclick="closeSheet(event)">
    <div class="sheet" onclick="event.stopPropagation()">
      <div class="sheet-header">
        <h3 id="sheetTitle">Topic</h3>
        <button class="sheet-close" onclick="hideSheet()">✕</button>
      </div>
      <div class="sheet-loading" id="sheetLoading">Opening full page...</div>
      <iframe class="sheet-frame" id="sheetFrame" style="display:none;"></iframe>
    </div>
  </div>

  <script>
    const API_URL = "https://script.google.com/macros/s/AKfycbyICNHxGGgvd7TBcgSxjQm3obJqDOGtHHiwiwUoXnxiNurmqmWDfwOXo5x9rfQqnXs/exec";
    let allQuestions = [];
    let wikiLang = "en"; // en | hi

    function setLang(lang) {
      wikiLang = lang;
      document.getElementById("btn-en").classList.toggle("active", lang === "en");
      document.getElementById("btn-hi").classList.toggle("active", lang === "hi");
    }

    function wikiHost() {
      return wikiLang === "hi" ? "https://hi.wikipedia.org" : "https://en.wikipedia.org";
    }

    function getData(key) {
      try { return JSON.parse(localStorage.getItem(key) || "[]"); }
      catch (e) { return []; }
    }
    function setData(key, data) {
      localStorage.setItem(key, JSON.stringify(data));
    }
    function getStats() {
      try {
        return JSON.parse(localStorage.getItem("mcq_stats") || '{"attempted":0,"correct":0,"streak":0,"lastDate":"","subjects":{}}');
      } catch (e) {
        return {attempted:0, correct:0, streak:0, lastDate:"", subjects:{}};
      }
    }
    function saveStats(stats) {
      localStorage.setItem("mcq_stats", JSON.stringify(stats));
    }

    /* Competitive-focused search query */
    function buildSearchQuery(item) {
      var chapter = (item.chapter || "").trim();
      var subject = (item.subject || "").trim();
      var exam = (item.exam || "").trim();
      var q = (item.q || "").replace(/[^\w\s\u0900-\u097F]/g, " ");
      var words = q.split(/\s+/).filter(function (w) { return w.length > 3; }).slice(0, 6).join(" ");

      // Priority for exam students: chapter > subject keywords > question words
      if (chapter.length > 2) return chapter + (subject ? " " + subject : "");
      if (subject.length > 2) return subject + " " + words;
      return words || exam || "general knowledge";
    }

    async function fetchWikipediaInsights(query) {
      var host = wikiHost();
      var searchUrl = host + "/w/api.php?action=query&list=search&srsearch=" +
        encodeURIComponent(query) + "&srlimit=5&format=json&origin=*";

      var searchRes = await fetch(searchUrl);
      if (!searchRes.ok) throw new Error("Wiki search failed");
      var searchData = await searchRes.json();
      var results = (searchData.query && searchData.query.search) || [];
      if (!results.length) return [];

      var cards = [];
      for (var i = 0; i < Math.min(5, results.length); i++) {
        var title = results[i].title;
        try {
          var sumUrl = host + "/api/rest_v1/page/summary/" + encodeURIComponent(title);
          var sumRes = await fetch(sumUrl);
          if (!sumRes.ok) continue;
          var sum = await sumRes.json();
          if (sum.type === "disambiguation") continue;

          cards.push({
            t: sum.title || title,
            d: sum.extract || (results[i].snippet || "").replace(/<[^>]+>/g, ""),
            pageUrl: host + "/wiki/" + encodeURIComponent(title.replace(/ /g, "_"))
          });
        } catch (e) {}
      }
      return cards;
    }

    async function showTopicInsight(qIndex, item) {
      var box = document.getElementById("insight-" + qIndex);
      if (!box || box.dataset.loaded === "1") return;

      box.classList.add("show");
      box.innerHTML = '<div class="insight-loading">' +
        (wikiLang === "hi" ? "विषय सार लोड हो रहा है..." : "Loading exam-focused topic briefs...") +
        "</div>";

      try {
        var query = buildSearchQuery(item);
        var cards = await fetchWikipediaInsights(query);

        if (!cards.length) {
          box.innerHTML = '<div class="insight-title">📚 Topic Insight</div>' +
            '<div class="insight-loading">' +
            (wikiLang === "hi" ? "संबंधित विषय नहीं मिला।" : "No related topic found.") +
            "</div>";
          return;
        }

        var title = wikiLang === "hi" ? "📚 परीक्षा नोट्स (संक्षेप)" : "📚 Exam notes (brief)";
        var openTxt = wikiLang === "hi" ? "पूरा पेज खोलें →" : "Open full page →";

        var html = '<div class="insight-title">' + title + '</div><div class="insight-scroll">';
        cards.forEach(function (c, idx) {
          html +=
            '<div class="insight-card" data-url="' + escapeAttr(c.pageUrl) + '" data-title="' + escapeAttr(c.t) + '" id="ic-' + qIndex + '-' + idx + '">' +
              '<h4>' + escapeHTML(c.t) + '</h4>' +
              '<p>' + escapeHTML(c.d) + '</p>' +
              '<div class="open-hint">' + openTxt + '</div>' +
            '</div>';
        });
        html += '</div>';
        box.innerHTML = html;
        box.dataset.loaded = "1";

        cards.forEach(function (c, idx) {
          var el = document.getElementById("ic-" + qIndex + "-" + idx);
          if (el) {
            el.onclick = function () {
              openSheet(c.t, c.pageUrl);
            };
          }
        });
      } catch (err) {
        console.error(err);
        box.innerHTML = '<div class="insight-title">📚 Topic Insight</div>' +
          '<div class="insight-loading">' +
          (wikiLang === "hi" ? "Wikipedia लोड नहीं हुआ। Internet check करें।" : "Could not load Wikipedia. Check internet.") +
          "</div>";
      }
    }

    function openSheet(title, url) {
      document.getElementById("sheetTitle").textContent = title;
      document.getElementById("sheetOverlay").classList.add("show");
      var frame = document.getElementById("sheetFrame");
      var loading = document.getElementById("sheetLoading");
      loading.style.display = "block";
      frame.style.display = "none";
      frame.onload = function () {
        loading.style.display = "none";
        frame.style.display = "block";
      };
      frame.src = url;
    }

    function hideSheet() {
      document.getElementById("sheetOverlay").classList.remove("show");
      document.getElementById("sheetFrame").src = "about:blank";
    }

    function closeSheet(e) {
      if (e.target.id === "sheetOverlay") hideSheet();
    }

    function escapeHTML(v) {
      return String(v || "")
        .replace(/&/g, "&amp;").replace(/</g, "&lt;")
        .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }
    function escapeAttr(v) {
      return escapeHTML(v).replace(/'/g, "&#039;");
    }

    async function loadQuestions() {
      const feed = document.getElementById("feed");
      feed.innerHTML = '<div class="loading">Loading questions...</div>';
      try {
        const res = await fetch(API_URL);
        const data = await res.json();
        if (!Array.isArray(data) || data.length === 0) throw new Error("No questions received");
        allQuestions = data;
        renderFeed();
      } catch (err) {
        feed.innerHTML = '<div class="loading">Failed to load questions.<br><small>' + err.message + '</small></div>';
      }
    }

    function renderFeed() {
      const feed = document.getElementById("feed");
      feed.innerHTML = "";
      if (!allQuestions.length) {
        feed.innerHTML = '<div class="loading">No questions found</div>';
        return;
      }

      allQuestions.forEach((item, index) => {
        const card = document.createElement("div");
        card.className = "post-card";

        const header = document.createElement("div");
        header.className = "post-header";
        header.innerHTML =
          '<div class="avatar">' + (item.username || "E").charAt(0) + '</div>' +
          '<div class="channel-info">' +
            '<h3>' + (item.username || "Educator") + '</h3>' +
            '<p>' + (item.subject || "General") + ' • ' + (item.difficulty || "Medium") + '</p>' +
          '</div>';
        card.appendChild(header);

        const qDiv = document.createElement("div");
        qDiv.className = "question-text";
        qDiv.textContent = item.q || "";
        card.appendChild(qDiv);

        const optionsDiv = document.createElement("div");
        optionsDiv.className = "options";
        optionsDiv.id = "options-" + index;
        (item.options || []).forEach((opt, i) => {
          const optDiv = document.createElement("div");
          optDiv.className = "option";
          optDiv.textContent = opt || "—";
          optDiv.onclick = function () { selectOption(index, i); };
          optionsDiv.appendChild(optDiv);
        });
        card.appendChild(optionsDiv);

        const insight = document.createElement("div");
        insight.className = "insight-wrap";
        insight.id = "insight-" + index;
        card.appendChild(insight);

        const footer = document.createElement("div");
        footer.className = "post-footer";

        const answered = document.createElement("div");
        answered.className = "answered";
        answered.id = "answered-" + index;
        answered.textContent = "Tap option to answer";
        footer.appendChild(answered);

        const actions = document.createElement("div");
        actions.className = "actions";

        const likeBtn = document.createElement("button");
        likeBtn.className = "action-btn";
        likeBtn.textContent = "👍";
        likeBtn.onclick = function () { toggleLike(item.uid, likeBtn); };
        actions.appendChild(likeBtn);

        const saveBtn = document.createElement("button");
        saveBtn.className = "action-btn";
        saveBtn.textContent = "🔖";
        saveBtn.onclick = function () { toggleSave(index, saveBtn); };
        actions.appendChild(saveBtn);

        footer.appendChild(actions);
        card.appendChild(footer);
        feed.appendChild(card);
      });
    }

    function selectOption(qIndex, selected) {
      const item = allQuestions[qIndex];
      const options = document.querySelectorAll("#options-" + qIndex + " .option");

      options.forEach((opt, i) => {
        opt.classList.add("disabled");
        if (i === item.correct) opt.classList.add("correct");
        if (i === selected && selected !== item.correct) opt.classList.add("wrong");
      });

      var ans = document.getElementById("answered-" + qIndex);
      if (ans) ans.textContent = (selected === item.correct) ? "Correct ✓" : "Wrong ✗";

      showTopicInsight(qIndex, item);

      const stats = getStats();
      stats.attempted = (stats.attempted || 0) + 1;
      if (selected === item.correct) stats.correct = (stats.correct || 0) + 1;

      const subject = item.subject || "General";
      if (!stats.subjects) stats.subjects = {};
      if (!stats.subjects[subject]) stats.subjects[subject] = { attempted: 0, correct: 0 };
      stats.subjects[subject].attempted++;
      if (selected === item.correct) stats.subjects[subject].correct++;

      const today = new Date().toDateString();
      if (stats.lastDate !== today) {
        const yesterday = new Date();
        yesterday.setDate(yesterday.getDate() - 1);
        stats.streak = (stats.lastDate === yesterday.toDateString()) ? (stats.streak || 0) + 1 : 1;
        stats.lastDate = today;
      }
      saveStats(stats);
    }

    function toggleLike(uid, btn) {
      let likes = getData("mcq_likes");
      if (likes.includes(uid)) {
        likes = likes.filter(function (id) { return id !== uid; });
        btn.classList.remove("liked");
      } else {
        likes.push(uid);
        btn.classList.add("liked");
      }
      setData("mcq_likes", likes);
    }

    function toggleSave(qIndex, btn) {
      let saved = getData("mcq_saved");
      const item = allQuestions[qIndex];
      const exists = saved.find(function (s) { return s.uid === item.uid; });
      if (exists) {
        saved = saved.filter(function (s) { return s.uid !== item.uid; });
        btn.classList.remove("saved");
      } else {
        saved.push({
          q: item.q, subject: item.subject, difficulty: item.difficulty,
          uid: item.uid, username: item.username
        });
        btn.classList.add("saved");
      }
      setData("mcq_saved", saved);
    }

    loadQuestions();
  </script>
</body>
</html>
