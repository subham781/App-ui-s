<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Exam Updates</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: Inter, Arial, Helvetica, sans-serif;
      background: #f5f7fb;
      color: #1f2937;
    }

    .container {
      width: min(1450px, 96%);
      margin: 16px auto 24px;
    }

    .toolbar {
      background: #ffffff;
      padding: 12px;
      border-radius: 12px;
      margin-bottom: 12px;
      box-shadow: 0 3px 14px rgba(0, 0, 0, 0.06);
    }

    .search {
      width: 100%;
      border: 1px solid #d1d5db;
      outline: none;
      padding: 12px 14px;
      border-radius: 9px;
      font-size: 15px;
    }

    .search:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    .tabs {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding: 2px 2px 10px;
      margin-bottom: 10px;
    }

    .tab {
      border: 0;
      background: #ffffff;
      color: #374151;
      padding: 10px 16px;
      border-radius: 9px;
      cursor: pointer;
      font-size: 14px;
      font-weight: 700;
      white-space: nowrap;
      box-shadow: 0 2px 9px rgba(0, 0, 0, 0.06);
    }

    .tab.active {
      color: #ffffff;
      background: #2563eb;
    }

    .status {
      background: #ffffff;
      border-radius: 10px;
      padding: 10px 14px;
      margin-bottom: 12px;
      color: #4b5563;
      font-size: 13px;
    }

    .table-card {
      background: #ffffff;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.07);
    }

    .table-scroll { overflow-x: auto; }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 900px;
    }

    thead { background: #111827; color: #ffffff; }

    th {
      padding: 13px;
      text-align: left;
      font-size: 13px;
      white-space: nowrap;
    }

    td {
      padding: 12px 13px;
      border-bottom: 1px solid #e5e7eb;
      font-size: 14px;
      vertical-align: top;
      line-height: 1.45;
    }

    tbody tr:hover { background: #f8fafc; }
    tbody tr:last-child td { border-bottom: 0; }

    .post-date { color: #2563eb; font-weight: 700; white-space: nowrap; }
    .board { font-weight: 600; color: #374151; }
    .post-name { font-weight: 700; color: #111827; }
    .qualification { color: #4b5563; }
    .advt { color: #6b7280; white-space: nowrap; }
    .last-date { color: #dc2626; font-weight: 700; white-space: nowrap; }

    .loading, .empty {
      padding: 40px 20px;
      text-align: center;
      color: #6b7280;
      font-size: 14px;
    }

    .spinner {
      width: 26px;
      height: 26px;
      border: 3px solid #e5e7eb;
      border-top-color: #2563eb;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 0 auto 10px;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .error {
      padding: 20px;
      background: #fef2f2;
      color: #991b1b;
      border: 1px solid #fecaca;
      border-radius: 10px;
      line-height: 1.6;
      margin: 12px;
    }

    @media (max-width: 700px) {
      .container { width: 96%; margin: 10px auto; }
      .tab { padding: 9px 13px; }
    }
  </style>
</head>

<body>
  <div class="container">

    <div class="toolbar">
      <input
        type="search"
        id="search"
        class="search"
        placeholder="Search exam, post, board, qualification..."
        autocomplete="off"
      >
    </div>

    <div id="tabs" class="tabs"></div>

    <div id="status" class="status">Loading...</div>

    <div class="table-card">
      <div class="table-scroll">
        <div id="tableContainer">
          <div class="loading">
            <div class="spinner"></div>
            Loading...
          </div>
        </div>
      </div>
    </div>

  </div>

<script>
  const API_URL = "https://script.google.com/macros/s/AKfycbzGDazBXohrCZ_uibsKM0hC91-5yPpR1G-J1nnyu4_DOYgAdD0Zy9_PSNWHvTR4mspVdg/exec";

  let sheetData = [];
  let currentSheet = 0;

  async function loadData() {
    const tableContainer = document.getElementById("tableContainer");
    const status = document.getElementById("status");

    try {
      tableContainer.innerHTML =
        '<div class="loading"><div class="spinner"></div>Loading...</div>';

      const response = await fetch(API_URL + "?t=" + Date.now(), {
        method: "GET",
        cache: "no-store"
      });

      if (!response.ok) {
        throw new Error("Server response: " + response.status);
      }

      const data = await response.json();

      if (!data.success) {
        throw new Error(data.error || "Unknown error");
      }

      sheetData = Array.isArray(data.sheets) ? data.sheets : [];

      if (!sheetData.length) {
        throw new Error("No sheets found");
      }

      createTabs();
      currentSheet = 0;
      showSheet(0);

    } catch (error) {
      console.error(error);

      tableContainer.innerHTML =
        '<div class="error"><strong>Data load failed</strong><br><br>' +
        escapeHTML(error.message) +
        "</div>";

      status.textContent = "Failed to load data";
    }
  }

  function createTabs() {
    const tabs = document.getElementById("tabs");
    tabs.innerHTML = "";

    sheetData.forEach(function (sheet, index) {
      const button = document.createElement("button");
      button.className = "tab" + (index === 0 ? " active" : "");
      button.textContent = sheet.name;

      button.addEventListener("click", function () {
        currentSheet = index;

        document.querySelectorAll(".tab").forEach(function (tab) {
          tab.classList.remove("active");
        });

        button.classList.add("active");
        document.getElementById("search").value = "";
        showSheet(index);
      });

      tabs.appendChild(button);
    });
  }

  function showSheet(index) {
    const sheet = sheetData[index];
    if (!sheet) return;

    const rows = sheet.rows || [];
    renderTable(rows);

    document.getElementById("status").textContent =
      sheet.name + " • " + rows.length + " items";
  }

  function renderTable(rows) {
    const container = document.getElementById("tableContainer");

    if (!rows.length) {
      container.innerHTML = '<div class="empty">No data found</div>';
      return;
    }

    var html =
      "<table><thead><tr>" +
      "<th>Post Date</th>" +
      "<th>Board</th>" +
      "<th>Exam / Post</th>" +
      "<th>Qualification</th>" +
      "<th>Advt No</th>" +
      "<th>Last Date</th>" +
      "</tr></thead><tbody>";

    rows.forEach(function (item) {
      html +=
        "<tr>" +
        '<td class="post-date">' + escapeHTML(item.postDate) + "</td>" +
        '<td class="board">' + escapeHTML(item.board) + "</td>" +
        '<td class="post-name">' + escapeHTML(item.postName) + "</td>" +
        '<td class="qualification">' + escapeHTML(item.qualification) + "</td>" +
        '<td class="advt">' + escapeHTML(item.advtNo) + "</td>" +
        '<td class="last-date">' + escapeHTML(item.lastDate) + "</td>" +
        "</tr>";
    });

    html += "</tbody></table>";
    container.innerHTML = html;
  }

  document.getElementById("search").addEventListener("input", function () {
    const query = this.value.toLowerCase().trim();
    const sheet = sheetData[currentSheet];
    if (!sheet) return;

    const rows = sheet.rows || [];

    if (!query) {
      renderTable(rows);
      document.getElementById("status").textContent =
        sheet.name + " • " + rows.length + " items";
      return;
    }

    const filtered = rows.filter(function (item) {
      return [
        item.postDate,
        item.board,
        item.postName,
        item.qualification,
        item.advtNo,
        item.lastDate
      ].join(" ").toLowerCase().includes(query);
    });

    renderTable(filtered);
    document.getElementById("status").textContent =
      filtered.length + " result(s)";
  });

  function escapeHTML(value) {
    return String(value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  loadData();
</script>
</body>
</html>
