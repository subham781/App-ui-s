<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
<title>PrepExam Home</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Inter,system-ui,sans-serif;-webkit-tap-highlight-color:transparent}
body{background:#eef2f7;color:#0f172a;min-height:100vh}
.page{max-width:640px;margin:0 auto;padding:12px 12px 90px}
.section-label{font-size:.68rem;font-weight:800;color:#64748b;text-transform:uppercase;letter-spacing:.45px;margin:0 0 8px 2px}

.adds-wrapper{overflow-x:auto;padding-bottom:4px;margin-bottom:12px;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.adds-wrapper::-webkit-scrollbar{display:none}
.adds-track{display:flex;gap:10px;width:max-content}
.ad-card{width:200px;height:100px;border-radius:14px;overflow:hidden;flex-shrink:0;cursor:pointer;border:1px solid #e2e8f0;position:relative;background:linear-gradient(135deg,#dbeafe,#e0e7ff)}
.ad-card img{width:100%;height:100%;object-fit:cover;display:block}
.ad-card::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 35%,rgba(15,23,42,.8) 100%)}
.ad-label{position:absolute;left:10px;right:10px;bottom:8px;z-index:1;color:#fff;font-size:.75rem;font-weight:700}
.ad-pill{position:absolute;top:8px;left:8px;z-index:1;background:rgba(255,255,255,.95);color:#0f172a;font-size:.6rem;font-weight:800;padding:3px 7px;border-radius:999px}

.feat-drop{background:#fff;border:1px solid #e8ecf4;border-radius:16px;margin-bottom:12px;box-shadow:0 2px 12px rgba(15,23,42,.04);overflow:hidden}
.feat-toggle{width:100%;border:0;background:#fff;padding:12px 14px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;font-weight:700;font-size:.88rem}
.feat-toggle .hint{font-size:.72rem;font-weight:600;color:#64748b}
.feat-toggle .chev{transition:transform .2s;color:#64748b;font-size:12px}
.feat-drop.open .chev{transform:rotate(180deg)}
.feat-body{display:none;padding:0 10px 12px;border-top:1px solid #f1f5f9}
.feat-drop.open .feat-body{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding-top:10px}
.feature-card{background:#f8fafc;border-radius:14px;padding:12px;border:1px solid #eef2f7;cursor:pointer;text-align:left}
.feature-card:active{transform:scale(.97)}
.icon-box{width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:18px;margin-bottom:8px}
.feature-card h3{font-size:.82rem;font-weight:700;margin-bottom:2px}
.feature-card p{font-size:.68rem;color:#64748b;line-height:1.3}
.color-1{background:linear-gradient(135deg,#dbeafe,#bfdbfe)}
.color-2{background:linear-gradient(135deg,#fce7f3,#fbcfe8)}
.color-3{background:linear-gradient(135deg,#d1fae5,#a7f3d0)}
.color-4{background:linear-gradient(135deg,#fef3c7,#fde68a)}
.color-5{background:linear-gradient(135deg,#e0e7ff,#c7d2fe)}

.feed-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:4px 0 8px;flex-wrap:wrap}
.feed-head h2{font-size:1.05rem;font-weight:800}
.feed-actions{display:flex;align-items:center;gap:8px}
.live{font-size:.68rem;font-weight:700;color:#059669;background:#ecfdf5;border:1px solid #a7f3d0;padding:4px 8px;border-radius:999px}
.refresh-btn{border:1px solid #e2e8f0;background:#fff;border-radius:10px;padding:7px 10px;font-size:.72rem;font-weight:800;color:#334155;cursor:pointer}

.stats-bar{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;background:#fff;border:1px solid #e8ecf4;border-radius:14px;padding:12px 10px;margin-bottom:10px;box-shadow:0 2px 10px rgba(15,23,42,.04)}
.stat-item{text-align:center}
.stat-item b{display:block;font-size:1rem;font-weight:800;line-height:1.2}
.stat-item span{font-size:.62rem;font-weight:700;color:#64748b;text-transform:uppercase}
.stat-item.acc b{color:#2563eb}.stat-item.ok b{color:#15803d}.stat-item.bad b{color:#b91c1c}

.panel{background:#fff;border:1px solid #e8ecf4;border-radius:16px;padding:12px;margin-bottom:12px;box-shadow:0 2px 10px rgba(15,23,42,.04)}
.panel-h{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px}
.panel-h b{font-size:.85rem;font-weight:800}
.panel select{border:1px solid #e2e8f0;border-radius:10px;padding:7px 10px;font-size:.75rem;font-weight:700;background:#f8fafc;color:#334155;max-width:55%}
.bars{display:flex;flex-direction:column;gap:8px}
.bar-row{display:flex;flex-direction:column;gap:3px}
.bar-top{display:flex;justify-content:space-between;font-size:.74rem;font-weight:700}
.bar-top span{color:#64748b;font-weight:600}
.track{height:7px;background:#eef2ff;border-radius:99px;overflow:hidden}
.fill{height:100%;background:linear-gradient(90deg,#3b82f6,#6366f1);border-radius:99px}

.filter-box{background:#fff;border:1px solid #e8ecf4;border-radius:16px;padding:12px;margin-bottom:12px;box-shadow:0 2px 10px rgba(15,23,42,.04)}
.filter-box h3{font-size:.82rem;font-weight:800;margin-bottom:10px}
.fgrid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.fgrid label{display:block;font-size:.62rem;font-weight:700;color:#64748b;margin-bottom:3px;text-transform:uppercase}
.fgrid select,.fgrid input{
  width:100%;border:1px solid #e2e8f0;border-radius:10px;padding:8px 10px;
  font-size:.78rem;font-weight:600;background:#f8fafc
}
.f-actions{display:flex;gap:8px;margin-top:10px}
.f-actions button{flex:1;border:0;border-radius:10px;padding:10px;font-size:.78rem;font-weight:800;cursor:pointer}
.btn-apply{background:#2563eb;color:#fff}
.btn-reset{background:#e2e8f0;color:#0f172a}

.lb-list{display:flex;flex-direction:column;gap:6px}
.lb-row{display:flex;align-items:center;gap:10px;padding:8px 10px;background:#f8fafc;border-radius:12px;border:1px solid #eef2f7}
.lb-rank{width:24px;height:24px;border-radius:8px;background:#e0e7ff;color:#3730a3;font-size:.72rem;font-weight:800;display:flex;align-items:center;justify-content:center}
.lb-row b{flex:1;font-size:.8rem}
.lb-row span{font-size:.75rem;font-weight:800;color:#2563eb}

.card{background:#fff;border-radius:16px;padding:14px;margin-bottom:12px;border:1px solid #e8ecf4;box-shadow:0 2px 12px rgba(15,23,42,.04)}
.tag{display:inline-block;font-size:.62rem;font-weight:800;text-transform:uppercase;letter-spacing:.3px;padding:3px 8px;border-radius:999px;margin-bottom:8px}
.tag-mcq{background:#eff6ff;color:#1d4ed8}
.tag-post{background:#fdf2f8;color:#be185d}
.post-header{display:flex;align-items:flex-start;gap:10px;margin-bottom:10px}
.avatar{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#6366f1);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.9rem;flex-shrink:0}
.uname{font-size:.9rem;font-weight:700}
.exam-row{display:flex;flex-wrap:wrap;gap:4px;margin-top:4px}
.exam-chip{font-size:.62rem;font-weight:700;background:#f1f5f9;color:#334155;padding:2px 7px;border-radius:6px}
.exam-chip.py{background:#fff7ed;color:#c2410c}
.meta{font-size:.7rem;color:#94a3b8;margin-top:3px}
.q{font-size:1rem;font-weight:600;line-height:1.45;margin-bottom:12px}
.options{display:flex;flex-direction:column;gap:8px}
.option{border:1.5px solid #e2e8f0;border-radius:10px;padding:11px 12px;font-size:.9rem;cursor:pointer;background:#fff}
.option.correct{background:#ecfdf5;border-color:#22c55e;color:#15803d;font-weight:600}
.option.wrong{background:#fef2f2;border-color:#ef4444;color:#b91c1c}
.option.disabled{pointer-events:none}
.footer-line{margin-top:12px;padding-top:10px;border-top:1px solid #f1f5f9;font-size:.78rem;color:#64748b}
.q-actions{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.q-action{flex:1;min-width:92px;border:1px solid #e2e8f0;background:#f8fafc;border-radius:10px;padding:9px 8px;font-size:.72rem;font-weight:800;color:#475569;cursor:pointer}
.q-action.active{background:#eff6ff;border-color:#93c5fd;color:#1d4ed8}
.q-action.revision.active{background:#ecfdf5;border-color:#86efac;color:#15803d}
.follow-btn{margin-left:auto;border:1px solid #bfdbfe;background:#eff6ff;color:#2563eb;border-radius:999px;padding:6px 10px;font-size:.68rem;font-weight:800;cursor:pointer}
.follow-btn.following{background:#f1f5f9;color:#475569;border-color:#e2e8f0}
.user-line{display:flex;align-items:center;gap:8px;flex-wrap:wrap}

.post-img-wrap{width:100%;border-radius:12px;overflow:hidden;background:#e2e8f0;margin:6px 0 10px;min-height:120px;cursor:zoom-in;position:relative}
.post-img-wrap img{width:100%;max-height:none;object-fit:contain;display:block;background:#f1f5f9}
.post-img-wrap .zoom-hint{position:absolute;right:8px;bottom:8px;background:rgba(15,23,42,.75);color:#fff;font-size:.62rem;font-weight:700;padding:4px 8px;border-radius:999px;pointer-events:none}

/* Image lightbox / zoom viewer */
.img-lightbox{display:none;position:fixed;inset:0;z-index:30000;background:rgba(0,0,0,.92);align-items:center;justify-content:center;flex-direction:column;touch-action:none}
.img-lightbox.show{display:flex}
.img-lightbox .lb-close{position:absolute;top:12px;right:12px;width:40px;height:40px;border:0;border-radius:12px;background:rgba(255,255,255,.15);color:#fff;font-size:20px;cursor:pointer;z-index:2}
.img-lightbox .lb-stage{width:100%;height:100%;overflow:hidden;display:flex;align-items:center;justify-content:center;position:relative}
.img-lightbox .lb-stage img{max-width:100%;max-height:100%;object-fit:contain;transform-origin:center center;transition:transform .05s linear;user-select:none;-webkit-user-drag:none;cursor:grab}
.img-lightbox .lb-hint{position:absolute;bottom:18px;left:50%;transform:translateX(-50%);color:rgba(255,255,255,.7);font-size:.72rem;font-weight:600;pointer-events:none}
.actions{display:flex;gap:14px;align-items:center;margin-bottom:8px}
.action{border:0;background:none;padding:0;cursor:pointer}
.action svg{width:24px;height:24px;stroke:#262626;fill:none;stroke-width:2}
.action.like.active svg{fill:#ed4956;stroke:#ed4956}
.action.save{margin-left:auto}
.action.save.active svg{fill:#262626}
.likes{font-size:.84rem;font-weight:700;margin-bottom:4px}
.ptitle{font-size:.9rem;font-weight:700;margin-bottom:4px}
.pdesc{font-size:.84rem;color:#334155;line-height:1.45}

.loading,.error{text-align:center;padding:32px 16px;color:#64748b;font-size:.9rem}
.retry{margin-top:10px;border:0;background:#2563eb;color:#fff;padding:10px 14px;border-radius:10px;font-weight:700}

.insight-wrap{display:none;margin-top:12px}
.insight-wrap.show{display:block}
.insight-title{font-size:.78rem;font-weight:700;color:#2563eb;margin-bottom:8px}
.insight-scroll{display:flex;gap:10px;overflow-x:auto;scrollbar-width:none}
.insight-card{min-width:200px;background:#f0f7ff;border:1px solid #dbeafe;border-radius:12px;padding:11px;flex-shrink:0;cursor:pointer}
.insight-card h4{font-size:.82rem;font-weight:700;margin-bottom:5px}
.insight-card p{font-size:.72rem;color:#4b5563;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}

.scroll-hint{position:fixed;left:50%;bottom:18px;transform:translateX(-50%);z-index:50;display:flex;flex-direction:column;align-items:center;gap:4px;background:rgba(15,23,42,.88);color:#fff;padding:10px 16px;border-radius:999px;font-size:.72rem;font-weight:700;animation:bob 1.4s ease-in-out infinite;pointer-events:none;transition:opacity .4s}
.scroll-hint.hide{opacity:0}
@keyframes bob{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(5px)}}

#viewer{display:none;position:fixed;inset:0;background:#fff;z-index:9999;flex-direction:column}
.viewer-header{display:flex;align-items:center;gap:12px;padding:12px 16px;background:#f8fafc;border-bottom:1px solid #e2e8f0}
.back-btn{width:40px;height:40px;border-radius:12px;border:0;background:#e2e8f0;font-size:18px}
.viewer-title{font-size:1rem;font-weight:700}
#viewer-frame{flex:1;width:100%;border:0}
.v-loading{flex:1;display:flex;align-items:center;justify-content:center;color:#64748b}

.sheet-overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:10000;display:none;align-items:flex-end;justify-content:center}
.sheet-overlay.show{display:flex}
.sheet{width:100%;max-width:700px;height:85vh;background:#fff;border-radius:18px 18px 0 0;display:flex;flex-direction:column;overflow:hidden}
.sheet-header{display:flex;align-items:center;gap:10px;padding:12px 14px;border-bottom:1px solid #e4e6eb}
.sheet-header h3{flex:1;font-size:.95rem;font-weight:700}
.sheet-close{border:0;background:#e4e6eb;width:34px;height:34px;border-radius:10px}
.sheet-frame{flex:1;width:100%;border:0;display:none}
.sheet-loading{padding:20px;text-align:center;color:#65676b}

/* Collapsible panels */
.drop-panel{background:#fff;border:1px solid #e8ecf4;border-radius:16px;margin-bottom:12px;box-shadow:0 2px 12px rgba(15,23,42,.04);overflow:hidden}
.drop-toggle{width:100%;border:0;background:#fff;padding:12px 14px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;font-weight:700;font-size:.88rem;gap:8px}
.drop-toggle .left{display:flex;align-items:center;gap:8px;min-width:0}
.drop-toggle .hint{font-size:.72rem;font-weight:600;color:#64748b}
.drop-toggle .chev{transition:transform .2s;color:#64748b;font-size:12px}
.drop-panel.open .chev{transform:rotate(180deg)}
.drop-body{display:none;padding:0 12px 12px;border-top:1px solid #f1f5f9}
.drop-panel.open .drop-body{display:block;padding-top:12px}
.acc-mini{font-size:.78rem;font-weight:800;color:#2563eb;background:#eff6ff;padding:4px 10px;border-radius:999px}

/* Horizontal filters */
.h-filters{display:flex;gap:8px;overflow-x:auto;padding:4px 0 6px;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.h-filters::-webkit-scrollbar{display:none}
.h-filter{flex:0 0 auto;min-width:120px}
.h-filter label{display:block;font-size:.6rem;font-weight:700;color:#64748b;margin-bottom:3px;text-transform:uppercase}
.h-filter select,.h-filter input{
  width:100%;min-width:120px;border:1px solid #e2e8f0;border-radius:12px;padding:8px 10px;
  font-size:.75rem;font-weight:600;background:#f8fafc;color:#0f172a
}
.f-actions{display:flex;gap:8px;margin-top:10px}
.f-actions button{flex:1;border:0;border-radius:12px;padding:10px;font-size:.78rem;font-weight:800;cursor:pointer}
.btn-apply{background:linear-gradient(135deg,#2563eb,#4f46e5);color:#fff}
.btn-reset{background:#e2e8f0;color:#0f172a}

/* Topic horizontal strip */
.topic-block{margin-bottom:14px}
.topic-head{display:flex;align-items:center;justify-content:space-between;margin:4px 2px 8px}
.topic-head b{font-size:.82rem;font-weight:800;color:#0f172a}
.topic-head span{font-size:.68rem;font-weight:700;color:#64748b}
.topic-scroll{display:flex;gap:12px;overflow-x:auto;padding-bottom:6px;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.topic-scroll::-webkit-scrollbar{display:none}
.topic-scroll .card{min-width:min(300px,86vw);max-width:320px;flex-shrink:0;margin-bottom:0}

/* Correct animation */
.option.correct{animation:popOk .45s ease}
@keyframes popOk{
  0%{transform:scale(1)}
  40%{transform:scale(1.04);box-shadow:0 0 0 3px rgba(34,197,94,.35)}
  100%{transform:scale(1)}
}
.option.correct::after{content:" ✓";font-weight:800}
.burst{position:fixed;z-index:20000;pointer-events:none;font-size:22px;animation:burstUp .8s ease forwards}
@keyframes burstUp{0%{opacity:1;transform:translateY(0) scale(1)}100%{opacity:0;transform:translateY(-40px) scale(1.3)}}

.stats-bar{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;background:#f8fafc;border:1px solid #eef2f7;border-radius:14px;padding:12px 10px;margin-bottom:10px}

</style>
</head>
<body>
<div class="page" id="main-page">
  <div class="section-label">Sponsored</div>
  <div class="adds-wrapper"><div class="adds-track" id="addsTrack"></div></div>

  <div class="feat-drop" id="featDrop">
    <button class="feat-toggle" type="button" id="featToggle">
      <span>⚡ Tools & Features</span>
      <span><span class="hint">tap</span> <span class="chev">▼</span></span>
    </button>
    <div class="feat-body" id="featuresContainer"></div>
  </div>

  <!-- FILTERS (horizontal + collapsible) -->
  <div class="drop-panel" id="filterDrop">
    <button class="drop-toggle" type="button" id="filterToggle">
      <span class="left"><span>🎯 Filters</span> <span class="hint" id="filterHint">tap to open</span></span>
      <span class="chev">▼</span>
    </button>
    <div class="drop-body">
      <div class="h-filters">
        <div class="h-filter"><label>Exam</label><select id="fExam"><option value="">All</option></select></div>
        <div class="h-filter"><label>Subject</label><select id="fSubject"><option value="">All</option></select></div>
        <div class="h-filter"><label>Topic</label><select id="fTopic"><option value="">All</option></select></div>
        <div class="h-filter"><label>Level</label><select id="fLevel"><option value="">All</option><option>Easy</option><option>Medium</option><option>Hard</option></select></div>
        <div class="h-filter"><label>Year</label><select id="fYear"><option value="">All</option></select></div>
        <div class="h-filter"><label>Shift</label><select id="fShift"><option value="">All</option></select></div>
        <div class="h-filter"><label>Section</label><select id="fSection"><option value="">All</option></select></div>
        <div class="h-filter"><label>Source</label><select id="fSource"><option value="">All</option><option>PYQ</option><option>Practice</option><option>Mock</option></select></div>
        <div class="h-filter"><label>Language</label><select id="fLang"><option value="">All</option><option value="en">English</option><option value="hi">Hindi</option></select></div>
        <div class="h-filter"><label>Type</label><select id="fType"><option value="All">All</option><option value="MCQ">MCQ</option><option value="Post">Post</option></select></div>
      </div>
      <div class="f-actions">
        <button class="btn-apply" type="button" id="btnApply">Apply</button>
        <button class="btn-reset" type="button" id="btnReset">Reset</button>
      </div>
    </div>
  </div>

  <!-- ANALYSIS (tap to open) -->
  <div class="drop-panel" id="analysisDrop">
    <button class="drop-toggle" type="button" id="analysisToggle">
      <span class="left"><span>📊 Your analysis</span> <span class="acc-mini" id="stAccuracyMini">0%</span></span>
      <span class="chev">▼</span>
    </button>
    <div class="drop-body">
      <div class="stats-bar">
        <div class="stat-item"><b id="stAttempted">0</b><span>Attempted</span></div>
        <div class="stat-item ok"><b id="stCorrect">0</b><span>Correct</span></div>
        <div class="stat-item bad"><b id="stWrong">0</b><span>Wrong</span></div>
        <div class="stat-item acc"><b id="stAccuracy">0%</b><span>Accuracy</span></div>
      </div>
      <div class="panel-h" style="margin-bottom:8px">
        <b style="font-size:.8rem">Breakdown</b>
        <select id="analysisMode">
          <option value="subject">Subject-wise</option>
          <option value="topic">Topic-wise</option>
          <option value="exam">Exam-wise</option>
          <option value="pyq">PYQ year-wise</option>
        </select>
      </div>
      <div class="bars" id="analysisBars"><div style="font-size:.8rem;color:#64748b">Attempt questions to see breakdown</div></div>
    </div>
  </div>

  <!-- LEADERBOARD (tap) -->
  <div class="drop-panel" id="lbDrop">
    <button class="drop-toggle" type="button" id="lbToggle">
      <span class="left"><span>🏆 Top accuracy</span> <span class="hint">tap</span></span>
      <span class="chev">▼</span>
    </button>
    <div class="drop-body">
      <div class="panel-h" style="margin-bottom:8px">
        <b style="font-size:.8rem">Leaderboard</b>
        <select id="lbMode">
          <option value="accuracy">By accuracy</option>
          <option value="attempted">By attempted</option>
        </select>
      </div>
      <div class="lb-list" id="leaderboard"><div style="font-size:.8rem;color:#64748b">Loading…</div></div>
    </div>
  </div>

  <div class="feed-head">
    <h2>Practice feed</h2>
    <div class="feed-actions">
      <span class="live">● Live</span>
      <button class="refresh-btn" type="button" id="btnRefresh">↻ Refresh</button>
    </div>
  </div>

  <div id="mixedFeed"><div class="loading">Loading practice…</div></div>
</div>

<div class="scroll-hint" id="scrollHint"><span>↓</span><span>Scroll &amp; practice</span></div>

<div id="viewer">
  <div class="viewer-header">
    <button class="back-btn" type="button" id="btnViewerBack">←</button>
    <div class="viewer-title" id="viewer-title">Loading…</div>
  </div>
  <div class="v-loading" id="loading">Loading…</div>
  <iframe id="viewer-frame" style="display:none"></iframe>
</div>

<div class="sheet-overlay" id="sheetOverlay">
  <div class="sheet">
    <div class="sheet-header">
      <h3 id="sheetTitle">Topic</h3>
