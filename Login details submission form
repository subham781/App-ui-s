<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Login / Setup</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:Inter,system-ui,sans-serif;background:#f0f2f5;color:#0f172a;min-height:100vh;padding:20px}
.wrap{max-width:420px;margin:0 auto}
.card{background:#fff;border-radius:18px;padding:20px;border:1px solid #e4e6eb;box-shadow:0 4px 16px rgba(0,0,0,.05)}
h1{font-size:1.25rem;margin-bottom:6px}
.sub{font-size:.85rem;color:#64748b;margin-bottom:16px;line-height:1.4}
label{display:block;font-size:.78rem;font-weight:600;color:#475569;margin:12px 0 5px}
input,select,textarea{
  width:100%;border:1.5px solid #e4e6eb;border-radius:12px;padding:12px;
  font-size:.95rem;font-family:inherit;background:#fafbfc
}
textarea{min-height:70px;resize:vertical}
.btn{
  width:100%;border:0;border-radius:12px;padding:14px;margin-top:16px;
  font-weight:700;background:linear-gradient(135deg,#1877f2,#4f46e5);color:#fff;cursor:pointer
}
.btn:disabled{opacity:.6}
.msg{margin-top:12px;font-size:.85rem;text-align:center;line-height:1.4}
.ok{color:#15803d}.err{color:#b91c1c}
.hidden{display:none}
.status{text-align:center;padding:40px 10px;color:#64748b}
</style>
</head>
<body>
<div class="wrap">
  <div class="card">
    <div id="status" class="status">Checking account...</div>

    <div id="formBox" class="hidden">
      <h1>Create profile</h1>
      <p class="sub">Pehli baar login — details bharo. ID: <b id="showId">—</b></p>

      <label>Display name *</label>
      <input id="name" type="text" placeholder="Rahul Sharma">

      <label>Channel name</label>
      <input id="channel" type="text" placeholder="Rahul Study">

      <label>Bio</label>
      <textarea id="bio" placeholder="NDA aspirant"></textarea>

      <label>Target exam</label>
      <select id="exam">
        <option>NDA</option>
        <option>CDS</option>
        <option>AFCAT</option>
        <option>Other</option>
      </select>

      <label>Target year</label>
      <input id="year" type="text" placeholder="2026" value="2026">

      <label>Language</label>
      <select id="lang">
        <option value="hi">Hindi</option>
        <option value="en">English</option>
      </select>

      <button class="btn" id="saveBtn" type="button">Save & Continue</button>
      <div class="msg" id="msg"></div>
    </div>
  </div>
</div>

<script>
(function () {
  // ========== FIREBASE — yahan apni details ==========
  // Browser REST use (simple, no SDK needed)
  const DB = "https://prepexam-f98bf-default-rtdb.firebaseio.com";
  // Agar project badle to sirf yeh URL badlo:
  // Firebase Console → Realtime Database → copy databaseURL
  // ==================================================

  var USER_ID = "";
  var USER_EMAIL = "";

  // email / label → firebase key (gmail local part)
  function toUserId(raw) {
    var s = String(raw || "").trim();
    if (!s) return "";
    if (s.indexOf("USER|") === 0) s = s.substring(5).trim();
    if (s.indexOf("@") > 0) {
      USER_EMAIL = s;
      s = s.split("@")[0];
    } else {
      USER_EMAIL = s + "@gmail.com";
    }
    return s.replace(/@gmail\.com$/i, "").trim();
  }

  function getFromKodular() {
    try {
      if (window.AppInventor && window.AppInventor.getWebViewString) {
        var s = (window.AppInventor.getWebViewString() || "").trim();
        if (s) return s;
      }
    } catch (e) {}
    try {
      var q = new URLSearchParams(location.search).get("email") ||
              new URLSearchParams(location.search).get("user");
      if (q) return q.trim();
    } catch (e) {}
    return "";
  }

  // Kodular ko string wapas
  function sendToKodular(value) {
    try {
      if (window.AppInventor && window.AppInventor.setWebViewString) {
        window.AppInventor.setWebViewString(value);
      }
    } catch (e) {}
    console.log("WebViewString →", value);
  }

  function showStatus(t) {
    document.getElementById("status").textContent = t;
    document.getElementById("status").classList.remove("hidden");
    document.getElementById("formBox").classList.add("hidden");
  }

  function showForm() {
    document.getElementById("status").classList.add("hidden");
    document.getElementById("formBox").classList.remove("hidden");
    document.getElementById("showId").textContent = USER_ID;
  }

  // Check: Users/{id} exists?
  async function checkUser(id) {
    var url = DB + "/Users/" + encodeURIComponent(id) + ".json?t=" + Date.now();
    var res = await fetch(url);
    if (!res.ok) throw new Error("Firebase HTTP " + res.status);
    var data = await res.json();
    return data; // null = not exists
  }

  async function start() {
    var raw = getFromKodular();
    USER_ID = toUserId(raw);

    if (!USER_ID) {
      showStatus("Email / Label empty. WebViewString = Label (email) bhejo.");
      sendToKodular("ERROR|NO_EMAIL");
      // late retry (Kodular)
      setTimeout(function () {
        var r2 = getFromKodular();
        if (r2) {
          USER_ID = toUserId(r2);
          if (USER_ID) runCheck();
        }
      }, 800);
      return;
    }

    runCheck();
  }

  async function runCheck() {
    showStatus("Checking: " + USER_ID + " ...");
    try {
      var data = await checkUser(USER_ID);

      if (data && data.profile) {
        // pehle se account hai
        showStatus("Welcome " + (data.profile.name || USER_ID));
        sendToKodular("EXISTS|" + USER_ID);
        return;
      }

      // naya user → form
      showForm();
      sendToKodular("NEW|" + USER_ID);
    } catch (e) {
      showStatus("Error: " + e.message);
      sendToKodular("ERROR|" + e.message);
    }
  }

  // naya profile save (simple JSON)
  document.getElementById("saveBtn").onclick = async function () {
    var msg = document.getElementById("msg");
    var btn = this;
    var name = document.getElementById("name").value.trim();
    var channel = document.getElementById("channel").value.trim() || name;
    var bio = document.getElementById("bio").value.trim();
    var exam = document.getElementById("exam").value;
    var year = document.getElementById("year").value.trim() || "2026";
    var lang = document.getElementById("lang").value;

    if (!name) {
      msg.innerHTML = '<span class="err">Name required</span>';
      return;
    }
    if (!USER_ID) {
      msg.innerHTML = '<span class="err">User id missing</span>';
      return;
    }

    // same structure as your json file (basic)
    var userData = {
      profile: {
        name: name,
        email: USER_EMAIL || (USER_ID + "@gmail.com"),
        photo: "",
        bio: bio,
        channelName: channel,
        loginType: "google",
        role: "student",
        joined: new Date().toISOString().slice(0, 10),
        isCreator: false,
        targetExam: exam,
        targetExams: [exam],
        targetYear: year
      },
      settings: { language: lang },
      publicStats: {
        mcqPosted: 0,
        postsCount: 0,
        coursesCount: 0,
        mocksCount: 0,
        testSeriesCount: 0,
        likesReceived: 0,
        savesReceived: 0,
        commentsReceived: 0,
        followers: 0,
        following: 0
      },
      provide: { mcq: {}, posts: {}, courses: {}, mocks: {}, testSeries: {} },
      consume: {
        savedMcq: {},
        likedMcq: {},
        commentsMade: {},
        attemptedMocks: {},
        purchased: { mocks: {}, courses: {}, testSeries: {} }
      },
      analysis: {
        allTime: {
          attempted: 0, correct: 0, wrong: 0, accuracy: 0,
          streak: 0, bestStreak: 0, lastActiveDate: "", studyMinutes: 0
        },
        today: { date: "", attempted: 0, correct: 0, wrong: 0, accuracy: 0, studyMinutes: 0 },
        yesterday: { date: "", accuracy: 0 },
        history: {},
        subjects: {},
        streakLog: {}
      },
      payments: {
        upi: "",
        razorpayContactId: "",
        orders: {},
        earnings: { total: 0, withdrawable: 0, withdrawn: 0, sales: {} }
      },
      lastSync: new Date().toISOString()
    };

    btn.disabled = true;
    msg.textContent = "Saving...";

    try {
      var url = DB + "/Users/" + encodeURIComponent(USER_ID) + ".json";
      var res = await fetch(url, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(userData)
      });
      if (!res.ok) throw new Error("Save failed HTTP " + res.status);

      msg.innerHTML = '<span class="ok">Saved!</span>';
      sendToKodular("CREATED|" + USER_ID);
    } catch (e) {
      msg.innerHTML = '<span class="err">' + e.message + '</span>';
      sendToKodular("ERROR|" + e.message);
    }
    btn.disabled = false;
  };

  start();
})();
</script>
</body>
</html>
