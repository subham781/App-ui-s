<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
<title>PrepExam Home</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Inter,system-ui,sans-serif;-webkit-tap-highlight-color:transparent}
body{background:#f1f5f9;color:#0f172a;min-height:100vh}
.page{max-width:640px;margin:0 auto;padding:12px 12px 28px}
.section-label{font-size:.65rem;font-weight:800;color:#64748b;text-transform:uppercase;letter-spacing:.4px;margin:0 0 8px 2px}

/* Bigger sponsored */
.adds-wrapper{overflow-x:auto;padding-bottom:6px;margin-bottom:14px;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.adds-wrapper::-webkit-scrollbar{display:none}
.adds-track{display:flex;gap:12px;width:max-content}
.ad-card{width:280px;height:140px;border-radius:16px;overflow:hidden;flex-shrink:0;cursor:pointer;border:1px solid #e2e8f0;position:relative;background:linear-gradient(135deg,#dbeafe,#e0e7ff)}
.ad-card img{width:100%;height:100%;object-fit:cover;display:block}
.ad-card::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 28%,rgba(15,23,42,.88) 100%)}
.ad-label{position:absolute;left:12px;right:12px;bottom:10px;z-index:1;color:#fff;font-size:.84rem;font-weight:700}
.ad-pill{position:absolute;top:10px;left:10px;z-index:1;background:rgba(255,255,255,.95);color:#0f172a;font-size:.62rem;font-weight:800;padding:4px 8px;border-radius:999px}

/* Search row: search | study tools | filter */
.search-row{display:flex;align-items:center;gap:8px;margin-bottom:10px}
.search-wrap{position:relative;flex:1;min-width:0}
.search-wrap input{
  width:100%;border:1px solid #e2e8f0;border-radius:14px;padding:12px 12px 12px 40px;
  font-size:.86rem;font-weight:600;background:#fff;outline:none;box-shadow:0 2px 10px rgba(15,23,42,.04)
}
.search-wrap input:focus{border-color:#93c5fd}
.search-ico{position:absolute;left:12px;top:50%;transform:translateY(-50%);width:18px;height:18px;color:#94a3b8;pointer-events:none}
.search-ico svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.tool-btn,.filter-btn{
  flex-shrink:0;border:1px solid #e2e8f0;background:#fff;border-radius:14px;
  width:44px;height:44px;display:flex;align-items:center;justify-content:center;cursor:pointer;
  box-shadow:0 2px 8px rgba(15,23,42,.04);color:#334155
}
.tool-btn:active,.filter-btn:active{transform:scale(.96)}
.tool-btn svg,.filter-btn svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
.filter-btn.active{background:#eff6ff;border-color:#93c5fd;color:#1d4ed8}
.tool-btn.active{background:#f0fdf4;border-color:#86efac;color:#15803d}

.search-results{
  display:none;background:#fff;border:1px solid #e2e8f0;border-radius:14px;margin-bottom:12px;
  max-height:300px;overflow-y:auto;box-shadow:0 8px 24px rgba(15,23,42,.1)
}
.search-results.show{display:block}
.sr-item{padding:12px 14px;border-bottom:1px solid #f1f5f9;cursor:pointer}
.sr-item:last-child{border-bottom:0}
.sr-item:active{background:#f8fafc}
.sr-type{font-size:.6rem;font-weight:800;text-transform:uppercase;color:#64748b;margin-bottom:3px}
.sr-title{font-size:.84rem;font-weight:700;line-height:1.35}
.sr-meta{font-size:.7rem;color:#94a3b8;margin-top:2px}
.sr-empty{padding:18px;text-align:center;color:#64748b;font-size:.85rem}

/* Study tools panel */
.tools-panel{display:none;background:#fff;border:1px solid #e8ecf4;border-radius:16px;padding:12px;margin-bottom:12px;box-shadow:0 2px 12px rgba(15,23,42,.04)}
.tools-panel.open{display:block}
.tools-panel h3{font-size:.78rem;font-weight:800;margin-bottom:10px;color:#0f172a}
.tools-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.tool-card{background:#f8fafc;border:1px solid #eef2f7;border-radius:14px;padding:12px;cursor:pointer;text-align:left}
.tool-card:active{transform:scale(.97)}
.tool-card .ibox{width:36px;height:36px;border-radius:11px;display:flex;align-items:center;justify-content:center;margin-bottom:8px}
.tool-card .ibox svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2}
.tool-card h4{font-size:.8rem;font-weight:700;margin-bottom:2px}
.tool-card p{font-size:.65rem;color:#64748b;line-height:1.3}
.c1{background:#dbeafe;color:#1d4ed8}.c2{background:#fce7f3;color:#be185d}
.c3{background:#d1fae5;color:#047857}.c4{background:#fef3c7;color:#b45309}.c5{background:#e0e7ff;color:#4338ca}

/* Filter panel */
.filter-panel{display:none;background:#fff;border:1px solid #e8ecf4;border-radius:16px;padding:12px;margin-bottom:12px;box-shadow:0 2px 12px rgba(15,23,42,.04)}
.filter-panel.open{display:block}
.h-filters{display:flex;gap:8px;overflow-x:auto;padding:2px 0 6px;scrollbar-width:none}
.h-filters::-webkit-scrollbar{display:none}
.h-filter{flex:0 0 auto;min-width:118px}
.h-filter label{display:block;font-size:.58rem;font-weight:700;color:#64748b;margin-bottom:3px;text-transform:uppercase}
.h-filter select{width:100%;border:1px solid #e2e8f0;border-radius:12px;padding:8px 10px;font-size:.74rem;font-weight:600;background:#f8fafc}
.f-actions{display:flex;gap:8px;margin-top:10px}
.f-actions button{flex:1;border:0;border-radius:12px;padding:10px;font-size:.78rem;font-weight:800;cursor:pointer}
.btn-apply{background:linear-gradient(135deg,#2563eb,#4f46e5);color:#fff}
.btn-reset{background:#e2e8f0;color:#0f172a}

.feed-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:6px 0 10px}
.feed-head h2{font-size:1.02rem;font-weight:800}
.feed-actions{display:flex;align-items:center;gap:8px}
.live{font-size:.66rem;font-weight:700;color:#059669;background:#ecfdf5;border:1px solid #a7f3d0;padding:4px 8px;border-radius:999px}
.refresh-btn{border:1px solid #e2e8f0;background:#fff;border-radius:10px;padding:7px 10px;font-size:.72rem;font-weight:800;color:#334155;cursor:pointer}

.card{background:#fff;border-radius:16px;padding:14px;margin-bottom:12px;border:1px solid #e8ecf4;box-shadow:0 2px 12px rgba(15,23,42,.04)}
.tag{display:inline-block;font-size:.6rem;font-weight:800;text-transform:uppercase;letter-spacing:.3px;padding:3px 8px;border-radius:999px;margin-bottom:8px}
.tag-mcq{background:#eff6ff;color:#1d4ed8}
.tag-post{background:#fdf2f8;color:#be185d}
.tag-oneliner{background:#f0fdf4;color:#15803d}
.tag-pdf{background:#fff7ed;color:#c2410c}
.post-header{display:flex;align-items:flex-start;gap:10px;margin-bottom:10px}
.avatar{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#6366f1);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.88rem;flex-shrink:0}
.uname{font-size:.88rem;font-weight:700}
.exam-row{display:flex;flex-wrap:wrap;gap:4px;margin-top:4px}
.exam-chip{font-size:.6rem;font-weight:700;background:#f1f5f9;color:#334155;padding:2px 7px;border-radius:6px}
.exam-chip.py{background:#fff7ed;color:#c2410c}
.meta{font-size:.68rem;color:#94a3b8;margin-top:3px}
.q{font-size:.98rem;font-weight:600;line-height:1.45;margin-bottom:12px}
.options{display:flex;flex-direction:column;gap:8px}
.option{border:1.5px solid #e2e8f0;border-radius:10px;padding:11px 12px;font-size:.88rem;cursor:pointer;background:#fff}
.option.correct{background:#ecfdf5;border-color:#22c55e;color:#15803d;font-weight:600}
.option.wrong{background:#fef2f2;border-color:#ef4444;color:#b91c1c}
.option.disabled{pointer-events:none}
.footer-line{margin-top:12px;padding-top:10px;border-top:1px solid #f1f5f9;font-size:.76rem;color:#64748b}
.q-actions{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.q-action{flex:1;min-width:88px;border:1px solid #e2e8f0;background:#f8fafc;border-radius:10px;padding:9px 8px;font-size:.7rem;font-weight:800;color:#475569;cursor:pointer}
.q-action.active{background:#eff6ff;border-color:#93c5fd;color:#1d4ed8}
.q-action.revision.active{background:#ecfdf5;border-color:#86efac;color:#15803d}
.loading,.error{text-align:center;padding:32px 16px;color:#64748b;font-size:.9rem}
.retry{margin-top:10px;border:0;background:#2563eb;color:#fff;padding:10px 14px;border-radius:10px;font-weight:700}
.topic-block{margin-bottom:14px}
.topic-head{display:flex;align-items:center;justify-content:space-between;margin:4px 2px 8px}
.topic-head b{font-size:.8rem;font-weight:800}
.topic-head span{font-size:.66rem;font-weight:700;color:#64748b}
.topic-scroll{display:flex;gap:12px;overflow-x:auto;padding-bottom:6px;scrollbar-width:none}
.topic-scroll::-webkit-scrollbar{display:none}
.topic-scroll .card{min-width:min(300px,86vw);max-width:320px;flex-shrink:0;margin-bottom:0}
.ol-ans{background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:10px 12px;font-size:.86rem;display:none;margin-top:8px}
.ol-ans.show{display:block}
.ol-ans.ok{background:#ecfdf5;border-color:#a7f3d0;color:#065f46}
.ol-ans.bad{background:#fef2f2;border-color:#fecaca;color:#991b1b}
.ol-input{width:100%;border:1.5px solid #e2e8f0;border-radius:12px;padding:11px 12px;font:inherit;font-size:.88rem;background:#fafbfc;margin-top:4px}
.ol-actions{display:flex;gap:8px;margin-top:10px}
.ol-btn{border:1px solid #e2e8f0;background:#fff;border-radius:10px;padding:9px 12px;font-size:.74rem;font-weight:800;color:#334155;cursor:pointer}
.ol-btn.primary{background:#2563eb;border-color:#2563eb;color:#fff}
.ptitle{font-size:.9rem;font-weight:700;margin-bottom:4px}
.pdesc{font-size:.84rem;color:#334155;line-height:1.45}
#viewer{display:none;position:fixed;inset:0;background:#fff;z-index:9999;flex-direction:column}
.viewer-header{display:flex;align-items:center;gap:12px;padding:12px 16px;background:#f8fafc;border-bottom:1px solid #e2e8f0}
.back-btn{width:40px;height:40px;border-radius:12px;border:0;background:#e2e8f0;font-size:18px}
.viewer-title{font-size:1rem;font-weight:700}
#viewer-frame{flex:1;width:100%;border:0}
.v-loading{flex:1;display:flex;align-items:center;justify-content:center;color:#64748b}

/* Chapter notes CTA below MCQ — opens viewer like Study tools */
.chapter-notes-cta{
  margin-top:12px;width:100%;border:1.5px solid #bfdbfe;background:linear-gradient(135deg,#eff6ff,#f8fafc);
  border-radius:14px;padding:12px 14px;cursor:pointer;text-align:left;
  display:flex;align-items:center;gap:12px;font-family:inherit;
}
.chapter-notes-cta:active{transform:scale(.98);background:#dbeafe}
.chapter-notes-cta .cn-ico{
  width:40px;height:40px;border-radius:12px;background:#2563eb;color:#fff;
  display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:1.1rem;
}
.chapter-notes-cta .cn-text{flex:1;min-width:0}
.chapter-notes-cta .cn-text b{display:block;font-size:.84rem;font-weight:800;color:#1e40af;line-height:1.3}
.chapter-notes-cta .cn-text span{display:block;font-size:.7rem;color:#64748b;margin-top:2px;font-weight:600}
.chapter-notes-cta .cn-arrow{color:#2563eb;font-weight:800;font-size:1.1rem;flex-shrink:0}
.notes-slot .notes-loading{font-size:.72rem;color:#94a3b8;padding:8px 2px}


/* Chapter bottom sheet */
.notes-sheet-backdrop{
  display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:10000;
  opacity:0;transition:opacity .2s ease;-webkit-tap-highlight-color:transparent;
}
.notes-sheet-backdrop.open{display:block;opacity:1}
.notes-sheet{
  position:fixed;left:0;right:0;bottom:0;z-index:10001;
  background:#fff;border-radius:18px 18px 0 0;
  box-shadow:0 -8px 32px rgba(15,23,42,.2);
  display:flex;flex-direction:column;
  height:50vh;max-height:94vh;
  transform:translateY(110%);
  transition:transform .28s cubic-bezier(.2,.8,.2,1);
  will-change:transform,height;
}
.notes-sheet.open{transform:translateY(0)}
.notes-sheet.no-anim{transition:none !important}
.notes-sheet-handle-wrap{
  flex-shrink:0;padding:8px 12px 10px;cursor:grab;user-select:none;
  -webkit-user-select:none;touch-action:none;
  display:flex;flex-direction:column;align-items:center;gap:6px;
  background:#fff;border-radius:18px 18px 0 0;
}
.notes-sheet-handle-wrap:active{cursor:grabbing}
.notes-sheet-handle{
  width:44px;height:5px;border-radius:99px;background:#94a3b8;margin-bottom:2px;
}
.notes-sheet-bar{
  width:100%;display:flex;align-items:center;gap:8px;pointer-events:auto;
}
.notes-sheet-bar .ns-title{
  flex:1;min-width:0;font-size:.9rem;font-weight:800;letter-spacing:-.02em;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:left;
  pointer-events:none;
}
.notes-sheet-bar .ns-hint{
  font-size:.62rem;font-weight:600;color:#94a3b8;white-space:nowrap;pointer-events:none;
}
.ns-btn{
  border:0;border-radius:10px;padding:8px 12px;font-size:.75rem;font-weight:800;
  background:#eff6ff;color:#1d4ed8;cursor:pointer;flex-shrink:0;font-family:inherit;
  touch-action:manipulation;-webkit-tap-highlight-color:transparent;
}
.ns-btn:active{opacity:.85}
.ns-btn-close{background:#f1f5f9;color:#0f172a}
.notes-sheet-close{
  width:36px;height:36px;border:0;border-radius:11px;background:#f1f5f9;color:#0f172a;
  font-size:1.25rem;font-weight:700;cursor:pointer;flex-shrink:0;line-height:1;
  touch-action:manipulation;
}
.notes-sheet-body{
  flex:1;min-height:0;position:relative;background:#fff;
  /* iframe should not steal vertical drag from handle only */
}
.notes-sheet-body iframe{width:100%;height:100%;border:0;display:block;background:#fff}
.notes-sheet-loading{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  font-size:.85rem;font-weight:600;color:#64748b;background:#fff;z-index:2;
}
.notes-sheet-loading.hide{display:none}

</style>
</head>
<body>
<div class="page" id="main-page">
  <div class="section-label">Sponsored</div>
  <div class="adds-wrapper"><div class="adds-track" id="addsTrack"></div></div>

  <div class="search-row">
    <div class="search-wrap">
      <span class="search-ico"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3-3"/></svg></span>
      <input type="search" id="globalSearch" class="search" placeholder="Search question, exam, subject, PDF…" autocomplete="off">
    </div>
    <button type="button" class="tool-btn" id="btnStudyTools" title="Study Tools" aria-label="Study Tools">
      <svg viewBox="0 0 24 24"><path d="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3z"/><path d="M5 19h14"/><path d="M8 19v2M16 19v2"/></svg>
    </button>
    <button type="button" class="filter-btn" id="btnFilterToggle" title="Filter" aria-label="Filter">
      <svg viewBox="0 0 24 24"><path d="M4 5h16l-6 7v5l-4 2v-7L4 5z"/></svg>
    </button>
  </div>
  <div class="search-results" id="searchResults"></div>

  <div class="tools-panel" id="toolsPanel">
    <h3>Study Tools</h3>
    <div class="tools-grid" id="toolsGrid"></div>
  </div>

  <div class="filter-panel" id="filterPanel">
    <div class="h-filters">
      <div class="h-filter"><label>Exam</label><select id="fExam"><option value="">All</option></select></div>
      <div class="h-filter"><label>Subject</label><select id="fSubject"><option value="">All</option></select></div>
      <div class="h-filter"><label>Topic</label><select id="fTopic"><option value="">All</option></select></div>
      <div class="h-filter"><label>Level</label><select id="fLevel"><option value="">All</option><option>Easy</option><option>Medium</option><option>Hard</option></select></div>
      <div class="h-filter"><label>Year</label><select id="fYear"><option value="">All</option></select></div>
      <div class="h-filter"><label>Source</label><select id="fSource"><option value="">All</option><option>PYQ</option><option>Practice</option><option>Mock</option></select></div>
      <div class="h-filter"><label>Type</label><select id="fType"><option value="All">All</option><option value="MCQ">MCQ</option><option value="Post">Post</option><option value="OneLiner">One-liner</option></select></div>
    </div>
    <div class="f-actions">
      <button class="btn-apply" type="button" id="btnApply">Apply</button>
      <button class="btn-reset" type="button" id="btnReset">Reset</button>
    </div>
  </div>

  <div class="feed-head">
    <h2>Practice feed</h2>
    <div class="feed-actions">
      <span class="live">● Live</span>
      <button class="refresh-btn" type="button" id="btnRefresh">↻ Refresh</button>
    </div>
  </div>
  <div id="mixedFeed"><div class="loading">Loading practice…</div></div>
</div>

<div id="viewer">
  <div class="viewer-header">
    <button class="back-btn" type="button" id="btnViewerBack">←</button>
    <div class="viewer-title" id="viewer-title">Loading…</div>
  </div>
  <div class="v-loading" id="loading">Loading…</div>
  <iframe id="viewer-frame" style="display:none"></iframe>
</div>

<!-- Chapter notes bottom sheet -->
<div class="notes-sheet-backdrop" id="notesSheetBackdrop"></div>
<div class="notes-sheet" id="notesSheet" aria-hidden="true">
  <div class="notes-sheet-handle-wrap" id="notesSheetDrag">
    <div class="notes-sheet-handle"></div>
    <div class="notes-sheet-bar">
      <div class="ns-title" id="notesSheetTitle">Chapter</div>
      <button type="button" class="ns-btn" id="notesSheetFull" aria-label="Full screen">Full</button>
      <button type="button" class="ns-btn ns-btn-close" id="notesSheetClose" aria-label="Close">Close</button>
    </div>
  </div>
  <div class="notes-sheet-body">
    <div class="notes-sheet-loading" id="notesSheetLoading">Loading chapter…</div>
    <iframe id="notesSheetFrame" title="Chapter notes"></iframe>
  </div>
</div>



