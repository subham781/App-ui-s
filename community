<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>PrepExam Community</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden}
body{
  font-family:Inter,system-ui,sans-serif;
  background:#eceff4;
  color:#0f172a;
  display:flex;
  flex-direction:column;
}

/* Top bar */
.top{
  flex-shrink:0;
  background:#fff;
  border-bottom:1px solid #e2e8f0;
  padding:10px 12px 8px;
}
.top h1{font-size:1.05rem;font-weight:700}
.top .sub{font-size:.72rem;color:#64748b;margin-top:2px}
.chips{
  display:flex;gap:6px;overflow-x:auto;margin-top:10px;
  padding-bottom:2px;scrollbar-width:none;
}
.chips::-webkit-scrollbar{display:none}
.chip{
  flex-shrink:0;border:0;background:#f1f5f9;color:#475569;
  border-radius:999px;padding:7px 12px;font-size:.75rem;font-weight:600;
}
.chip.on{background:#2563eb;color:#fff}

/* Chat area */
.chat{
  flex:1;
  overflow-y:auto;
  padding:12px 12px 8px;
  -webkit-overflow-scrolling:touch;
}
.day{
  text-align:center;font-size:.68rem;color:#94a3b8;
  margin:10px 0 12px;font-weight:600;
}
.row{display:flex;margin-bottom:10px}
.row.me{justify-content:flex-end}
.bubble{
  max-width:88%;
  background:#fff;
  border-radius:16px 16px 16px 4px;
  padding:10px 12px;
  box-shadow:0 1px 3px rgba(15,23,42,.06);
}
.row.me .bubble{
  background:#dbeafe;
  border-radius:16px 16px 4px 16px;
}
.meta{
  display:flex;align-items:center;gap:6px;flex-wrap:wrap;
  margin-bottom:4px;
}
.name{font-size:.72rem;font-weight:700;color:#1e293b}
.row.me .name{color:#1d4ed8}
.badge{
  font-size:.6rem;font-weight:700;padding:2px 6px;border-radius:6px;
  text-transform:uppercase;
}
.badge.ssc{background:#dbeafe;color:#1d4ed8}
.badge.defence{background:#d1fae5;color:#047857}
.badge.general{background:#f1f5f9;color:#64748b}
.msg{
  font-size:.9rem;line-height:1.45;color:#0f172a;
  white-space:pre-wrap;word-break:break-word;
}
.link{
  display:inline-block;margin-top:6px;font-size:.78rem;font-weight:600;
  color:#2563eb;text-decoration:none;word-break:break-all;
}
.time{
  font-size:.62rem;color:#94a3b8;margin-top:5px;text-align:right;
}
.empty{
  text-align:center;color:#94a3b8;font-size:.85rem;
  padding:48px 16px;
}

/* Bottom composer — Kodular style */
.bottom{
  flex-shrink:0;
  background:#fff;
  border-top:1px solid #e2e8f0;
  padding:8px 10px calc(8px + env(safe-area-inset-bottom));
}
.sec-row{display:flex;gap:6px;margin-bottom:6px}
.sec-row select{
  flex:1;border:1px solid #e2e8f0;border-radius:10px;
  padding:7px 8px;font:inherit;font-size:.75rem;background:#f8fafc;color:#334155;
}
.link-row{margin-bottom:6px}
.link-row input{
  width:100%;border:1px solid #e2e8f0;border-radius:10px;
  padding:8px 10px;font:inherit;font-size:.8rem;background:#f8fafc;
}
.input-row{display:flex;align-items:flex-end;gap:8px}
.input-row textarea{
  flex:1;border:1px solid #e2e8f0;border-radius:18px;
  padding:10px 14px;font:inherit;font-size:.9rem;
  max-height:100px;min-height:42px;resize:none;background:#f1f5f9;
  line-height:1.35;
}
.send{
  width:44px;height:44px;border:0;border-radius:50%;
  background:#2563eb;color:#fff;font-size:1.1rem;font-weight:700;
  flex-shrink:0;cursor:pointer;
}
.send:disabled{opacity:.45}
.status{font-size:.68rem;color:#94a3b8;text-align:center;min-height:14px;margin-top:4px}
.status.err{color:#dc2626}
.status.ok{color:#16a34a}
</style>
</head>
<body>

<div class="top">
  <h1>Community</h1>
  <div class="sub" id="sub">Exam tips &amp; links · chat style</div>
  <div class="chips">
    <button type="button" class="chip on" data-sec="all">All</button>
    <button type="button" class="chip" data-sec="ssc">SSC</button>
    <button type="button" class="chip" data-sec="defence">Defence</button>
    <button type="button" class="chip" data-sec="general">General</button>
  </div>
</div>

<div class="chat" id="chat">
  <div class="empty">Loading...</div>
</div>

<div class="bottom">
  <div class="sec-row">
    <select id="section">
      <option value="ssc">SSC</option>
      <option value="defence">Defence</option>
      <option value="general">General</option>
    </select>
  </div>
  <div class="link-row">
    <input id="link" type="url" placeholder="Link optional — https://...">
  </div>
  <div class="input-row">
    <textarea id="text" rows="1" placeholder="Type message..."></textarea>
    <button type="button" class="send" id="btnSend" title="Send">➤</button>
  </div>
  <div class="status" id="status"></div>
</div>

<script>
(function () {
  // ========== CONFIG ==========
  var DB = "https://prepexam-f98bf-default-rtdb.firebaseio.com/Exams";
  // ============================

  var USER_ID = "";
  var USER_NAME = "";
  var filter = "all";
  var posts = [];

  function $(id) { return document.getElementById(id); }

  function getWebString() {
    try {
      if (window.AppInventor && window.AppInventor.getWebViewString)
        return String(window.AppInventor.getWebViewString() || "").trim();
    } catch (e) {}
    return "";
  }

  function escapeHtml(s) {
    return String(s || "")
      .replace(/&/g, "&amp;").replace(/</g, "&lt;")
      .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }

  function parseUid(raw) {
    raw = String(raw || "").trim();
    if (raw.indexOf("|") !== -1) raw = raw.split("|").pop();
    if (raw.indexOf("@") !== -1) raw = raw.split("@")[0];
    return raw.replace(/[.#$\[\]\/]/g, "_");
  }

  function isValidUrl(s) {
    try {
      var u = new URL(s);
      return u.protocol === "http:" || u.protocol === "https:";
    } catch (e) { return false; }
  }

  function fmtTime(ts) {
    try {
      return new Date(ts).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" });
    } catch (e) { return ""; }
  }

  function scrollBottom() {
    var c = $("chat");
    c.scrollTop = c.scrollHeight;
  }

  async function initUser() {
    USER_ID = parseUid(getWebString());
    if (!USER_ID) {
      $("sub").textContent = "User id waiting (WebViewString)...";
      $("btnSend").disabled = true;
      setTimeout(async function () {
        USER_ID = parseUid(getWebString());
        if (USER_ID) {
          $("btnSend").disabled = false;
          await loadName();
          $("sub").textContent = "Chatting as " + USER_NAME;
        }
      }, 700);
      return;
    }
    await loadName();
    $("sub").textContent = "Chatting as " + USER_NAME;
  }

  async function loadName() {
    USER_NAME = USER_ID;
    try {
      var res = await fetch(DB + "/Users/" + encodeURIComponent(USER_ID) + "/profile.json");
      if (res.ok) {
        var p = await res.json();
        if (p && (p.name || p.displayName)) USER_NAME = p.name || p.displayName;
      }
    } catch (e) {}
  }

  async function loadPosts() {
    try {
      var res = await fetch(DB + "/Community/posts.json");
      if (!res.ok) throw new Error("HTTP " + res.status);
      var data = await res.json();
      posts = [];
      if (data) {
        Object.keys(data).forEach(function (id) {
          var p = data[id] || {};
          posts.push({
            id: id,
            section: p.section || "general",
            text: p.text || "",
            link: p.link || "",
            authorId: p.authorId || "",
            authorName: p.authorName || "Student",
            ts: Number(p.ts) || 0
          });
        });
      }
      posts.sort(function (a, b) { return a.ts - b.ts; }); // chat: oldest top
      render();
    } catch (e) {
      $("chat").innerHTML = '<div class="empty">Load failed: ' + escapeHtml(e.message) + "</div>";
    }
  }

  function render() {
    var list = posts;
    if (filter !== "all") {
      list = posts.filter(function (p) { return p.section === filter; });
    }
    if (!list.length) {
      $("chat").innerHTML = '<div class="empty">Abhi koi message nahi.<br>Neeche type karke bhejo.</div>';
      return;
    }
    var html = "";
    list.forEach(function (p) {
      var mine = USER_ID && p.authorId === USER_ID;
      var badge = p.section === "ssc" ? "ssc" : (p.section === "defence" ? "defence" : "general");
      var label = badge === "ssc" ? "SSC" : (badge === "defence" ? "Defence" : "General");
      html +=
        '<div class="row' + (mine ? " me" : "") + '">' +
          '<div class="bubble">' +
            '<div class="meta">' +
              '<span class="name">' + escapeHtml(p.authorName) + '</span>' +
              '<span class="badge ' + badge + '">' + label + '</span>' +
            '</div>' +
            (p.text ? '<div class="msg">' + escapeHtml(p.text) + '</div>' : '') +
            (p.link
              ? '<a class="link" href="' + escapeHtml(p.link) + '" target="_blank" rel="noopener">' +
                escapeHtml(p.link) + '</a>'
              : '') +
            '<div class="time">' + fmtTime(p.ts) + '</div>' +
          '</div>' +
        '</div>';
    });
    $("chat").innerHTML = html;
    scrollBottom();
  }

  async function send() {
    var text = ($("text").value || "").trim();
    var link = ($("link").value || "").trim();
    var section = $("section").value;
    var st = $("status");
    st.textContent = "";
    st.className = "status";

    if (!USER_ID) {
      st.textContent = "User id nahi mili";
      st.className = "status err";
      return;
    }
    if (!text && !link) {
      st.textContent = "Message ya link likho";
      st.className = "status err";
      return;
    }
    if (text.length > 800) {
      st.textContent = "Max 800 characters";
      st.className = "status err";
      return;
    }
    if (link && !isValidUrl(link)) {
      st.textContent = "Link https:// se start ho";
      st.className = "status err";
      return;
    }

    $("btnSend").disabled = true;
    st.textContent = "Sending...";

    var body = {
      section: section,
      text: text,
      link: link,
      authorId: USER_ID,
      authorName: USER_NAME || USER_ID,
      ts: Date.now()
    };

    try {
      var res = await fetch(DB + "/Community/posts.json", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body)
      });
      if (!res.ok) throw new Error("HTTP " + res.status);
      $("text").value = "";
      $("link").value = "";
      st.textContent = "";
      await loadPosts();
    } catch (e) {
      st.textContent = String(e.message || e);
      st.className = "status err";
    }
    $("btnSend").disabled = false;
  }

  $("btnSend").onclick = send;
  $("text").addEventListener("keydown", function (e) {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault();
      send();
    }
  });

  document.querySelectorAll(".chip").forEach(function (btn) {
    btn.onclick = function () {
      document.querySelectorAll(".chip").forEach(function (b) { b.classList.remove("on"); });
      btn.classList.add("on");
      filter = btn.getAttribute("data-sec") || "all";
      render();
    };
  });

  // auto grow textarea a bit
  $("text").addEventListener("input", function () {
    this.style.height = "auto";
    this.style.height = Math.min(this.scrollHeight, 100) + "px";
  });

  if (!DB || DB.indexOf("YOUR_") !== -1) {
    $("chat").innerHTML = '<div class="empty">Firebase DB URL CONFIG me daalo</div>';
    $("btnSend").disabled = true;
    return;
  }

  initUser().then(loadPosts);
  // light refresh
  setInterval(loadPosts, 15000);
})();
</script>
</body>
</html>
